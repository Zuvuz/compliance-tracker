@* US-042: one risk with its measures, and accept / close / review.
   Ids used by the tests: #risk-title, #risk-level, #risk-status, #risk-accepted, #risk-measures (li.risk-measure),
   #add-measure, #accept-risk, #close-risk, #review-risk, #edit-risk-link.
   US-111: #risk-actions with li.risk-action (data-title) holding .risk-action-status, .risk-action-owner, .risk-action-due,
   li.risk-action-link (data-kind), the forms .link-risk-action and .complete-risk-action; #add-risk-action; #no-risk-actions.
   US-176: #withdraw-risk (reason), #reopen-risk (reason), form.remove-risk-action, form.unlink-risk-action-link.
   US-124: #risk-trace with li.trace-node (data-kind: measure-requirement, measure-story, action, story, requirement, evidence;
   data-name), nested as the thread goes; #no-trace.
   US-202: section#what-reduces; each li.risk-measure holds ul.measure-actions (li.risk-action) and details.add-measure-action
   with form.add-risk-action-form (measureId); #other-actions with #risk-actions and form#add-risk-action; form.move-risk-action
   (to); #relevant-measures in #add-measure; #no-actions-needed; the trace in details#risk-trace-details. *@
@using ComplianceTracker.Domain.Risks
@model RiskPageViewModel
@{
    var risk = Model.Risk;
    var project = Model.Project;
    var editable = !project.IsClosed && risk.Status != RiskStatus.Closed && await Permissions.CanAsync(Permission.ManageRisks);
    var canDecide = !project.IsClosed && risk.Status != RiskStatus.Closed && await Permissions.CanAsync(Permission.DecideCompliance);
    var canReopen = !project.IsClosed && await Permissions.CanAsync(Permission.DecideCompliance); // US-176
    var canLinkWork = !project.IsClosed && await Permissions.CanAsync(Permission.LinkWork); // US-158 R5
    ViewData["Title"] = risk.Title;
}

@* US-168 R1: the shared page header *@
<page-header heading="@risk.Title" heading-id="risk-title" status="@risk.Level.ToString()" status-id="risk-level"
             back-href="@Url.Action("Details", "Projects", new { id = project.Id, tab = ProjectTabs.Risks })" back-text="@($"Risks of {project.Name}")">
    @if (editable)
    {
        <a class="btn btn-outline-primary" id="edit-risk-link" asp-action="Edit" asp-route-id="@risk.Id">Edit</a>
    }
</page-header>
<p class="text-muted">@risk.Description</p>
@if (risk.IsAiDrafted)
{
    @* US-112 R4 *@
    <p class="small text-muted" id="risk-ai-drafted"><span class="badge text-bg-info">AI-drafted</span> From the AI agent's draft, accepted by a person</p>
}
@if (risk.ImportedFrom is { } importedFrom)
{
    @* US-049 R5, R7 *@
    <p class="small text-muted" id="risk-imported">Imported from @importedFrom@(risk.ImportedOwner is { } owner ? $"; the file named the owner {owner}, who is not a member" : "")</p>
}

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<dl class="row">
    @if (Model.Assets.Assets.Count > 0)
    {
        @* US-214 R4: the assets the risk concerns, and the highest classification among them *@
        <dt class="col-sm-3">Assets</dt>
        <dd class="col-sm-9" id="risk-assets">
            @string.Join(", ", Model.Assets.Assets.Select(a => $"{a.Name} ({a.Classification})"))
            <div class="small">Highest classification: <strong id="risk-classification">@Model.Assets.Highest</strong></div>
        </dd>
    }
    <dt class="col-sm-3"><term name="Risk level">Likelihood × impact</term></dt>
    <dd class="col-sm-9">@risk.Likelihood × @risk.Impact = @risk.Score (@risk.Level)</dd>
    @* US-165 R1, R2: the level before the measures never changes by itself; the residual is set by a person *@
    <dt class="col-sm-3"><term name="Residual risk">Residual risk</term></dt>
    <dd class="col-sm-9" id="risk-residual">@risk.ResidualText@(risk.ResidualToReview ? " – to review: measures were removed after it was set" : "")
        @if (editable)
        {
            <details class="mt-1" id="set-residual-menu" open="@(risk.ResidualToReview)" data-dialog-title="Set the residual risk of @risk.Title">
                <summary class="btn btn-sm btn-outline-secondary">Set residual risk</summary>
                <form asp-action="SetResidual" method="post" class="d-flex flex-wrap align-items-end gap-2 mt-1" id="set-residual">
                    <input type="hidden" name="id" value="@risk.Id" />
                    <div>
                        <label class="form-label small mb-0" for="residual-likelihood">Likelihood after the measures</label>
                        <select name="likelihood" id="residual-likelihood" class="form-select form-select-sm w-auto">
                            @for (var n = 1; n <= 5; n++)
                            {
                                <option value="@n" selected="@(n == (risk.ResidualLikelihood ?? risk.Likelihood))">@n</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small mb-0" for="residual-impact">Impact after the measures</label>
                        <select name="impact" id="residual-impact" class="form-select form-select-sm w-auto">
                            @for (var n = 1; n <= 5; n++)
                            {
                                <option value="@n" selected="@(n == (risk.ResidualImpact ?? risk.Impact))">@n</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Set</button>
                    <div class="small text-muted w-100">It cannot be higher than @risk.Likelihood × @risk.Impact = @risk.Score.</div>
                </form>
            </details>
        }
    </dd>
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9" id="risk-owner">@Model.OwnerOf(risk.OwnerId)</dd>
    <dt class="col-sm-3"><term name="Treatment">Treatment</term></dt>
    <dd class="col-sm-9">@risk.Treatment</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span id="risk-status">@risk.DisplayStatus</span>
        @if (risk.Status == RiskStatus.Accepted)
        {
            <span class="small" id="risk-accepted">· Accepted by @Model.NameOf(risk.AcceptedById)@(risk.AcceptedRole is { } acceptedRole ? $" ({RolePermissions.Title(acceptedRole)})" : ""): @risk.AcceptedReason</span>
        }
        @if (risk.Status == RiskStatus.Closed)
        {
            <span class="small">· @risk.ClosedReason</span>
        }
    </dd>
    <dt class="col-sm-3">Last reviewed</dt>
    <dd class="col-sm-9">@(risk.LastReviewedAt?.ToLocalTime().ToString("dd-MM-yyyy") ?? "never")
        @if (risk.IsReviewDue(Model.Now))
        {
            <span class="badge text-bg-danger">Review due</span>
        }
    </dd>
</dl>

@{
    // US-111: one treatment action with its stories and evidence. US-202: shown under its measure or under "Other actions".
    async Task ActionItem(RiskAction action)
    {
            var overdue = action.IsOverdue(Model.Today);
            <li class="risk-action border rounded p-2 mb-2" data-title="@action.Title">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <strong>@action.Title</strong>
                    <span class="badge risk-action-status @(action.IsDone ? "text-bg-success" : "text-bg-secondary")">@RiskPageViewModel.StatusText(action.Status)</span>
                    <span class="small text-muted risk-action-owner">Owner: @Model.OwnerOf(action.OwnerId)</span>
                    @if (action.DueOn is { } due)
                    {
                        <span class="small risk-action-due @(overdue ? "text-danger fw-semibold" : "text-muted")">Due @due.ToString("dd-MM-yyyy")@(overdue ? " (overdue)" : "")</span>
                    }
                    @if (action.DoneAt is { } doneAt)
                    {
                        <span class="small text-muted">Done by @Model.NameOf(action.DoneById) on @doneAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                    }
                </div>
                @if (action.Links.Count > 0)
                {
                    <ul class="small mb-1 mt-1">
                        @foreach (var link in action.Links)
                        {
                            @if (link.WorkItemId is not null)
                            {
                                var story = Model.WorkItemOf(link.WorkItemId);
                                <li class="risk-action-link" data-kind="story">Story: @if (story is not null) { <a href="@story.Url" target="_blank" rel="noopener noreferrer">@story.Title</a> <span class="badge text-bg-light">@story.State</span> } else { <span>(user story removed)</span> }
                                    @if (editable && !action.IsDone)
                                    {
                                        <partial name="_UnlinkActionLink" model="(risk.Id, action.Id, link.Id)" />
                                    }
                                </li>
                            }
                            else
                            {
                                <li class="risk-action-link" data-kind="evidence">Evidence: @Model.EvidenceTitle(link.EvidenceId)
                                    @if (editable && !action.IsDone)
                                    {
                                        <partial name="_UnlinkActionLink" model="(risk.Id, action.Id, link.Id)" />
                                    }
                                </li>
                            }
                        }
                    </ul>
                }
                @if (editable && !action.IsDone)
                {
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <form asp-action="LinkAction" method="post" class="d-flex flex-wrap gap-1 link-risk-action">
                            <input type="hidden" name="id" value="@risk.Id" />
                            <input type="hidden" name="actionId" value="@action.Id" />
                            <select name="target" class="form-select form-select-sm" aria-label="Story or evidence for @action.Title">
                                @if (Model.Compliance is { } stories)
                                {
                                    <optgroup label="User stories">
                                        @foreach (var story in stories.WorkItems.Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed && action.Links.All(l => l.WorkItemId != w.Id)))
                                        {
                                            <option value="story:@story.Id">@story.Title</option>
                                        }
                                    </optgroup>
                                }
                                <optgroup label="Evidence">
                                    @foreach (var evidence in Model.ProjectEvidence.Where(e => action.Links.All(l => l.EvidenceId != e.Id)))
                                    {
                                        <option value="evidence:@evidence.Id">@evidence.Title</option>
                                    }
                                </optgroup>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Link</button>
                        </form>
                        <form asp-action="CompleteAction" method="post" class="complete-risk-action">
                            <input type="hidden" name="id" value="@risk.Id" />
                            <input type="hidden" name="actionId" value="@action.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Mark as done</button>
                        </form>
                        @* US-176 R1: an action added by mistake *@
                        <form asp-action="RemoveAction" method="post" class="remove-risk-action" data-confirm="The action is removed from the risk.">
                            <input type="hidden" name="id" value="@risk.Id" />
                            <input type="hidden" name="actionId" value="@action.Id" />
                            <button type="submit" class="btn btn-sm btn-link text-danger p-0">Remove action</button>
                        </form>
                    </div>
                }
                @if (editable && !action.IsDone && risk.Measures.Count > 0)
                {
                    @* US-202 R3: under another measure, or under "Other actions" *@
                    <form asp-action="MoveAction" method="post" class="d-flex flex-wrap gap-1 mt-1 move-risk-action">
                        <input type="hidden" name="id" value="@risk.Id" />
                        <input type="hidden" name="actionId" value="@action.Id" />
                        <select name="to" class="form-select form-select-sm w-auto" aria-label="Move @action.Title to">
                            @foreach (var target in risk.Measures.Where(m => m.Id != action.MeasureId))
                            {
                                <option value="@target.Id">@Model.MeasureName(target)</option>
                            }
                            @if (action.MeasureId is not null)
                            {
                                <option value="">Other actions</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-link py-0">Move</button>
                    </form>
                }
            </li>
    }

    // US-202 R2, R3: adding an action under a measure, or under "Other actions" (measureId null)
    async Task AddActionForm(Guid? measureId, string formId)
    {
        <form asp-action="AddAction" method="post" class="row g-2 add-risk-action-form" id="@formId">
            <input type="hidden" name="id" value="@risk.Id" />
            @if (measureId is { } underMeasure)
            {
                <input type="hidden" name="measureId" value="@underMeasure" />
            }
            <div class="col-md-5">
                <input name="title" required maxlength="@RiskAction.MaxTitleLength" class="form-control form-control-sm" placeholder="What will be done, e.g. Shorter session lifetime" aria-label="Action" />
            </div>
            <div class="col-md-3">
                <select name="ownerId" class="form-select form-select-sm" aria-label="Owner">
                    @foreach (var member in Model.Organization.Members)
                    {
                        <option value="@member.Id" selected="@(member.Id == risk.OwnerId)">@member.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="dueOn" class="form-control form-control-sm" aria-label="Due date" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Add action</button>
            </div>
        </form>
    }
}

@* US-202 R1: one section for what reduces the risk: the measures (requirements and user stories), each with the actions
   that carry it out, then "Other actions", and the full thread folded away *@
<section class="mb-4" id="what-reduces">
    <h2 class="h5">What reduces this risk</h2>
    <p class="small text-muted">The requirements and user stories that reduce the risk (<term name="Measure">measures</term>), each with the actions that carry it out. An action is done when a linked story is closed or evidence is linked.</p>
    @if (risk.Treatment != RiskTreatment.Reduce)
    {
        @* R7 *@
        <p class="small" id="no-actions-needed">No actions needed: the risk is @RiskPageViewModel.TreatedAs(risk.Treatment)</p>
    }
    @if (editable && Model.Compliance is { } compliance)
    {
        @* #52: adding comes before the list. R5: a requirement of the project, or one of its user stories *@
        <form asp-action="AddMeasure" method="post" class="d-flex flex-wrap gap-2" id="add-measure">
            <input type="hidden" name="id" value="@risk.Id" />
            <select name="measure" class="form-select form-select-sm" aria-label="Measure">
                @{
                    // US-202 R4: the requirements that share words with the risk come first
                    var relevant = Model.RelevantRequirements();
                }
                @if (relevant.Count > 0)
                {
                    <optgroup label="Most relevant" id="relevant-measures">
                        @foreach (var row in relevant)
                        {
                            <option value="requirement:@row.Requirement.Id">@row.Requirement.Code @row.Requirement.Title</option>
                        }
                    </optgroup>
                }
                @foreach (var framework in compliance.Frameworks)
                {
                    <optgroup label="@FrameworkNames.Short(framework.Framework.Name)">
                        @foreach (var row in framework.Requirements.Where(r => r.IsApplicable && relevant.All(x => x.Requirement.Id != r.Requirement.Id)))
                        {
                            <option value="requirement:@row.Requirement.Id">@row.Requirement.Code @row.Requirement.Title</option>
                        }
                    </optgroup>
                }
                <optgroup label="User stories">
                    @foreach (var story in compliance.WorkItems.Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed))
                    {
                        <option value="story:@story.Id">@story.Title</option>
                    }
                </optgroup>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Link a requirement or story</button>
        </form>

        @* US-106 R12: the AI suggests measures; a person approves each one *@
        <form asp-action="SuggestMeasures" method="post" class="mt-2 mb-3" id="suggest-measures" data-busy="Working… this can take a minute">
            <input type="hidden" name="id" value="@risk.Id" />
            <button type="submit" class="btn btn-sm btn-outline-info">Suggest measures</button>
        </form>
    }
    @if (risk.Measures.Count == 0)
    {
        <p class="text-muted">@(risk.Treatment == RiskTreatment.Reduce ? "No measures yet" : "None")</p>
    }
    <ul id="risk-measures" class="list-unstyled">
        @foreach (var measure in risk.Measures)
        {
            var view = Model.ViewOf(measure);
            string RequirementPage(string sub, string code, string? fragment = null)
                => Url.Action("Details", "Projects", new { id = project.Id, tab = ProjectTabs.Compliance, sub, req = code, risk = risk.Id }) + (fragment is null ? "" : "#" + fragment);
            <li class="risk-measure d-flex flex-wrap gap-2 align-items-center" data-measure="@Model.MeasureName(measure)">
                @* #52: a measure leads on to its requirement's page, where stories and evidence are linked, and back here *@
                @if (view.Code is { } code)
                {
                    <a class="measure-link" href="@RequirementPage(view.Sub!, code)">@Model.MeasureName(measure)</a>
                }
                else
                {
                    <span class="measure-link-none">@Model.MeasureName(measure)</span>
                }
                @if (view.Behind.Length > 0)
                {
                    <span class="small text-muted measure-behind">@view.Behind</span>
                }
                @foreach (var (sub, storyCode) in view.StoryRequirements)
                {
                    <a class="small measure-story-requirement" href="@RequirementPage(sub, storyCode)">@storyCode</a>
                }
                @if (canLinkWork && view.NeedsEvidence)
                {
                    @* US-158 R4: where the evidence is added: the requirement's page, or for a story the Evidence tab *@
                    <a class="btn btn-sm btn-link py-0 measure-add-evidence"
                       href="@(view.Code is { } evidenceCode ? RequirementPage(view.Sub!, evidenceCode, "add-evidence-section") : Url.Action("Details", "Projects", new { id = project.Id, tab = ProjectTabs.Evidence }))">Add evidence</a>
                }
                @if (editable)
                {
                    @* US-174: no question; the message after it offers Undo *@
                    <form asp-action="RemoveMeasure" method="post" class="remove-measure">
                        <input type="hidden" name="id" value="@risk.Id" />
                        <input type="hidden" name="measureId" value="@measure.Id" />
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" aria-label="Remove measure">×</button>
                    </form>
                }
                @* US-202 R2: the actions that carry out this measure *@
                <ul class="list-unstyled measure-actions w-100 ms-3 mb-0" data-measure-id="@measure.Id">
                    @foreach (var action in risk.ActionsUnder(measure.Id))
                    {
                        await ActionItem(action);
                    }
                </ul>
                @if (editable)
                {
                    <details class="add-measure-action w-100 ms-3" data-measure="@Model.MeasureName(measure)">
                        <summary class="btn btn-sm btn-link py-0">+ Add action</summary>
                        @{ await AddActionForm(measure.Id, $"add-action-{measure.Id}"); }
                    </details>
                }
            </li>
        }
    </ul>
    @if (TempData["MeasureMessage"] is string measureMessage)
    {
        <p class="small text-muted mt-1" id="measure-message" role="status">@measureMessage</p>
    }
    @if (Model.MeasureSuggestions.Count > 0)
    {
        <div class="waiting-box mt-2" id="measure-suggestions">
            <div class="small fw-semibold">Waiting for your decision (@Model.MeasureSuggestions.Count)</div>
            @foreach (var suggestion in Model.MeasureSuggestions)
            {
                var name = Model.MeasureName(suggestion);
                <div class="row-item measure-suggestion" data-measure="@name">
                    <span>@name</span>
                    <div class="small text-muted item-source"><span class="badge text-bg-info">AI-generated</span> Suggested measure · score @suggestion.Score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</div>
                    @if (editable)
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <form asp-action="ApproveMeasure" method="post" enctype="multipart/form-data" class="approve-measure d-flex flex-wrap align-items-start gap-1" data-busy="Uploading…">
                                <input type="hidden" name="id" value="@risk.Id" />
                                <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                @if (canLinkWork)
                                {
                                    @* US-158 R1: optional evidence, approved and proven in one step *@
                                    <details class="approve-with-evidence" data-dialog-title="Approve the measure with evidence">
                                        <summary class="btn btn-sm btn-link py-0">+ Evidence</summary>
                                        <div class="d-flex flex-column gap-1 mt-1">
                                            @{ var suggestedEvidence = Model.MeasureEvidence.For(suggestion.Id); }
                                            @if (suggestedEvidence.Count > 0)
                                            {
                                                @* US-161 R1: the project's existing evidence, best first; picking one links it when approving (R3) *@
                                                <fieldset class="suggested-measure-evidence">
                                                    <legend class="small fw-semibold mb-1">Suggested evidence</legend>
                                                    @foreach (var item in suggestedEvidence)
                                                    {
                                                        <label class="form-check-label small d-block suggested-measure-evidence-item" data-title="@item.Evidence.Title">
                                                            <input type="radio" name="existingEvidenceId" value="@item.Evidence.Id" class="form-check-input me-1" />
                                                            @item.Evidence.Title
                                                            <span class="badge text-bg-info">AI-generated</span>
                                                            <span class="text-muted">· score @item.Score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                                        </label>
                                                    }
                                                    <div class="small text-muted">Or a new one:</div>
                                                </fieldset>
                                            }
                                            else if (Model.MeasureEvidence.Unavailable is { } unavailable)
                                            {
                                                @* R5 *@
                                                <p class="small text-muted mb-0 measure-evidence-unavailable">@unavailable</p>
                                            }
                                            <input name="evidenceTitle" class="form-control form-control-sm" maxlength="200" placeholder="Title, e.g. MFA policy" aria-label="Evidence title" />
                                            <input name="evidenceUrl" type="url" class="form-control form-control-sm" placeholder="Link (https://…)" aria-label="Evidence link" />
                                            <input name="evidenceFile" type="file" class="form-control form-control-sm" aria-label="Or a file (max 10 MB)" />
                                            <div class="d-flex gap-1 align-items-center">
                                                <label class="small text-muted text-nowrap" for="valid-until-@suggestion.Id">Valid until</label>
                                                <input name="evidenceValidUntil" id="valid-until-@suggestion.Id" type="date" class="form-control form-control-sm" />
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-success align-self-start">Approve with evidence</button>
                                        </div>
                                    </details>
                                }
                            </form>
                            <form asp-action="RejectMeasure" method="post" class="d-flex flex-wrap gap-1 reject-measure">
                                <input type="hidden" name="id" value="@risk.Id" />
                                <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                <select name="reason" class="form-select form-select-sm w-auto" aria-label="Reason">
                                    <option value="">Reason…</option>
                                    @foreach (var reason in Enum.GetValues<ComplianceTracker.Domain.Mappings.RejectionReason>())
                                    {
                                        <option value="@reason">@reason</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* US-111; US-202 R3: actions not tied to a measure *@
    <h3 class="h6 mt-3" id="other-actions">Other actions</h3>
    @if (risk.Actions.Count == 0)
    {
        <p class="text-muted" id="no-risk-actions">No actions yet</p>
    }
    <ul id="risk-actions" class="list-unstyled">
        @foreach (var action in risk.ActionsUnder(null))
        {
            await ActionItem(action);
        }
    </ul>
    @if (editable)
    {
        await AddActionForm(null, "add-risk-action");
    }

    @* US-124 R1: risk → measures and actions → user stories → requirements → evidence. US-202 R1: folded into this section. *@
    <details class="mt-3" id="risk-trace-details">
    <summary class="small">Show the full thread: measures and actions → user stories → requirements → evidence</summary>
    @{
        var trace = Model.Trace;
        async Task Requirement(ComplianceTracker.Application.Risks.TraceRequirement requirement, string kind)
        {
            <li class="trace-node" data-kind="@kind" data-name="@requirement.Requirement.Code">
                <span class="badge text-bg-light">@requirement.Framework</span>
                <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id" asp-route-tab="@ProjectTabs.Compliance"
                   asp-route-sub="@FrameworkNames.Slug(requirement.Framework)" asp-route-q="@requirement.Requirement.Code">@requirement.Requirement.Code</a>
                <span class="small">@requirement.Requirement.Title</span>
                @if (requirement.Evidence.Count > 0)
                {
                    <ul class="list-unstyled ms-3 mb-0">
                        @foreach (var item in requirement.Evidence)
                        {
                            <li class="trace-node small" data-kind="evidence" data-name="@item.Evidence.Title">
                                Evidence: @item.Evidence.Title@(item.IsExpired ? " (expired)" : "")
                            </li>
                        }
                    </ul>
                }
            </li>
        }
        async Task Story(ComplianceTracker.Application.Risks.TraceStory story, string kind)
        {
            <li class="trace-node" data-kind="@kind" data-name="@story.Story.Title">
                Story: <a href="@story.Story.Url" target="_blank" rel="noopener noreferrer">@story.Story.Title</a>
                <span class="badge text-bg-light">@story.Story.State</span>
                @if (story.Evidence.Count > 0)
                {
                    @* US-146 R2: evidence that shows the story is done *@
                    <span class="small story-evidence">· Evidence: @string.Join(", ", story.Evidence.Select(e => e.Title))</span>
                }
                @if (story.Requirements.Count > 0)
                {
                    <ul class="list-unstyled ms-3 mb-0">
                        @foreach (var requirement in story.Requirements)
                        {
                            await Requirement(requirement, "requirement");
                        }
                    </ul>
                }
                else
                {
                    <span class="small text-muted">· covers no requirement yet</span>
                }
            </li>
        }
    }
    @if (trace is null || trace.IsEmpty)
    {
        <p class="text-muted" id="no-trace">No measures or actions yet, so nothing to trace</p>
    }
    else
    {
        <ul class="list-unstyled" id="risk-trace">
            @foreach (var requirement in trace.MeasureRequirements)
            {
                await Requirement(requirement, "measure-requirement");
            }
            @foreach (var story in trace.MeasureStories)
            {
                await Story(story, "measure-story");
            }
            @foreach (var action in trace.Actions)
            {
                <li class="trace-node" data-kind="action" data-name="@action.Action.Title">
                    Action: <strong>@action.Action.Title</strong>
                    <span class="badge text-bg-secondary">@RiskPageViewModel.StatusText(action.Action.Status)</span>
                    <ul class="list-unstyled ms-3 mb-1">
                        @foreach (var story in action.Stories)
                        {
                            await Story(story, "story");
                        }
                        @foreach (var evidenceId in action.EvidenceIds)
                        {
                            <li class="trace-node small" data-kind="evidence" data-name="@Model.EvidenceTitle(evidenceId)">Evidence: @Model.EvidenceTitle(evidenceId)</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    }
    </details>
</section>

@* US-203 R4, R5: every change of the risk, from the activity log; nothing here can be edited *@
<section class="mb-4" id="risk-history">
    <h2 class="h5">History</h2>
    @if (Model.History.Count == 0)
    {
        <p class="text-muted small" id="no-risk-history">No changes logged yet.</p>
    }
    else
    {
        <ul class="list-unstyled small mb-0">
            @foreach (var entry in Model.History)
            {
                <li class="risk-history-entry border-bottom py-1" data-kind="@entry.Kind">
                    <span class="text-muted">@entry.At.ToLocalTime().ToString("dd-MM-yyyy HH:mm") · @(entry.UserId is null ? "The system" : Model.NameOf(entry.UserId))</span>
                    · <strong>@entry.Kind</strong>@(entry.What.Length > 0 ? ": " : "")<span class="risk-history-what">@entry.What</span>
                </li>
            }
        </ul>
    }
</section>

@if (canReopen && risk.Status != RiskStatus.Open && !risk.IsWithdrawn)
{
    @* US-176 R1: accepted or closed by mistake *@
    <form asp-action="Reopen" method="post" class="d-flex flex-wrap gap-1 mb-3" id="reopen-risk">
        <input type="hidden" name="id" value="@risk.Id" />
        <input name="reason" class="form-control form-control-sm w-auto" placeholder="Why it is open again" aria-label="Reason for reopening" />
        <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Reopen risk</button>
    </form>
}
@if (editable)
{
    <section class="d-flex flex-wrap gap-4">
        <form asp-action="Review" method="post" id="review-risk">
            <input type="hidden" name="id" value="@risk.Id" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark as reviewed</button>
        </form>
        @if (risk.Status != RiskStatus.Accepted && canDecide)
        {
            <form asp-action="Accept" method="post" data-confirm="The risk is accepted with your reason. A High or Critical risk needs another member's approval." data-confirm-final="true" class="d-flex gap-1" id="accept-risk">
                <input type="hidden" name="id" value="@risk.Id" />
                <input name="reason" class="form-control form-control-sm" placeholder="Why the risk is accepted" aria-label="Reason for accepting" />
                <button type="submit" class="btn btn-outline-warning btn-sm text-nowrap">Accept risk</button>
            </form>
        }
        @if (risk.Status == RiskStatus.Open)
        {
            @* US-176 R1, R2: created by mistake *@
            <form asp-action="Withdraw" method="post" data-confirm="The risk is withdrawn: it leaves the register and the reports, and stays in the history." data-confirm-final="true" class="d-flex flex-wrap gap-1" id="withdraw-risk">
                <input type="hidden" name="id" value="@risk.Id" />
                <input name="reason" class="form-control form-control-sm" placeholder="Why, e.g. created by mistake" aria-label="Reason for withdrawing" />
                <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">Withdraw risk</button>
            </form>
        }
        @if (canDecide)
        {
        <form asp-action="Close" method="post" data-confirm="The risk is closed and leaves the open register." data-confirm-final="true" class="d-flex gap-1" id="close-risk">
            <input type="hidden" name="id" value="@risk.Id" />
            <input name="reason" class="form-control form-control-sm" placeholder="Why the risk no longer applies" aria-label="Reason for closing" />
            <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">Close risk</button>
        </form>
        }
    </section>
}
