@* US-042: one risk with its measures, and accept / close / review.
   Ids used by the tests: #risk-title, #risk-level, #risk-status, #risk-accepted, #risk-measures (li.risk-measure),
   #add-measure, #accept-risk, #close-risk, #review-risk, #edit-risk-link.
   US-111: #risk-actions with li.risk-action (data-title) holding .risk-action-status, .risk-action-owner, .risk-action-due,
   li.risk-action-link (data-kind), the forms .link-risk-action and .complete-risk-action; #add-risk-action; #no-risk-actions.
   US-124: #risk-trace with li.trace-node (data-kind: measure-requirement, measure-story, action, story, requirement, evidence;
   data-name), nested as the thread goes; #no-trace. *@
@using ComplianceTracker.Domain.Risks
@model RiskPageViewModel
@{
    var risk = Model.Risk;
    var project = Model.Project;
    var editable = !project.IsClosed && risk.Status != RiskStatus.Closed && await Permissions.CanAsync(Permission.ManageRisks);
    var canDecide = !project.IsClosed && risk.Status != RiskStatus.Closed && await Permissions.CanAsync(Permission.DecideCompliance);
    ViewData["Title"] = risk.Title;
}

<p class="mb-1"><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Risks">← Risks of @project.Name</a></p>
<div class="d-flex justify-content-between align-items-start">
    <h1 class="mb-1"><span id="risk-title">@risk.Title</span> <span class="badge text-bg-secondary fs-6 align-middle" id="risk-level">@risk.Level</span></h1>
    @if (editable)
    {
        <a class="btn btn-outline-primary" id="edit-risk-link" asp-action="Edit" asp-route-id="@risk.Id">Edit</a>
    }
</div>
<p class="text-muted">@risk.Description</p>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<dl class="row">
    <dt class="col-sm-3">Likelihood × impact</dt>
    <dd class="col-sm-9">@risk.Likelihood × @risk.Impact = @risk.Score (@risk.Level)</dd>
    @if (risk.ResidualLevel is { } residual)
    {
        <dt class="col-sm-3">Residual risk</dt>
        <dd class="col-sm-9">@risk.ResidualLikelihood × @risk.ResidualImpact (@residual)</dd>
    }
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9" id="risk-owner">@Model.OwnerOf(risk.OwnerId)</dd>
    <dt class="col-sm-3">Treatment</dt>
    <dd class="col-sm-9">@risk.Treatment</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span id="risk-status">@risk.DisplayStatus</span>
        @if (risk.Status == RiskStatus.Accepted)
        {
            <span class="small" id="risk-accepted">· Accepted by @Model.NameOf(risk.AcceptedById)@(risk.AcceptedRole is { } acceptedRole ? $" ({RolePermissions.Title(acceptedRole)})" : ""): @risk.AcceptedReason</span>
        }
        @if (risk.Status == RiskStatus.Closed)
        {
            <span class="small">· @risk.ClosedReason</span>
        }
    </dd>
    <dt class="col-sm-3">Last reviewed</dt>
    <dd class="col-sm-9">@(risk.LastReviewedAt?.ToLocalTime().ToString("dd-MM-yyyy") ?? "never")
        @if (risk.IsReviewDue(Model.Now))
        {
            <span class="badge text-bg-danger">Review due</span>
        }
    </dd>
</dl>

<section class="mb-4">
    <h2 class="h5">Measures</h2>
    @if (risk.Measures.Count == 0)
    {
        <p class="text-muted">@(risk.Treatment == RiskTreatment.Reduce ? "No measures yet" : "None")</p>
    }
    <ul id="risk-measures" class="list-unstyled">
        @foreach (var measure in risk.Measures)
        {
            <li class="risk-measure d-flex gap-2 align-items-center">
                <span>@Model.MeasureName(measure)</span>
                @if (editable)
                {
                    <form asp-action="RemoveMeasure" method="post">
                        <input type="hidden" name="id" value="@risk.Id" />
                        <input type="hidden" name="measureId" value="@measure.Id" />
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" aria-label="Remove measure">×</button>
                    </form>
                }
            </li>
        }
    </ul>
    @if (editable && Model.Compliance is { } compliance)
    {
        @* R5: a requirement of the project, or one of its user stories *@
        <form asp-action="AddMeasure" method="post" class="d-flex gap-2" id="add-measure">
            <input type="hidden" name="id" value="@risk.Id" />
            <select name="measure" class="form-select form-select-sm" aria-label="Measure">
                @foreach (var framework in compliance.Frameworks)
                {
                    <optgroup label="@FrameworkNames.Short(framework.Framework.Name)">
                        @foreach (var row in framework.Requirements.Where(r => r.IsApplicable))
                        {
                            <option value="requirement:@row.Requirement.Id">@row.Requirement.Code @row.Requirement.Title</option>
                        }
                    </optgroup>
                }
                <optgroup label="User stories">
                    @foreach (var story in compliance.WorkItems.Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed))
                    {
                        <option value="story:@story.Id">@story.Title</option>
                    }
                </optgroup>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Link measure</button>
        </form>
    }
</section>

<section class="mb-4">
    @* US-111: the trace from the risk through what is done to the proof *@
    <h2 class="h5">Treatment actions</h2>
    <p class="small text-muted">What is done about the risk, and the user stories and evidence that carry it out. An action is done when a linked story is closed or evidence is linked.</p>
    @if (risk.Actions.Count == 0)
    {
        <p class="text-muted" id="no-risk-actions">No actions yet</p>
    }
    <ul id="risk-actions" class="list-unstyled">
        @foreach (var action in risk.Actions.OrderBy(a => a.IsDone).ThenBy(a => a.DueOn ?? DateOnly.MaxValue))
        {
            var overdue = action.IsOverdue(Model.Today);
            <li class="risk-action border rounded p-2 mb-2" data-title="@action.Title">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <strong>@action.Title</strong>
                    <span class="badge risk-action-status @(action.IsDone ? "text-bg-success" : "text-bg-secondary")">@RiskPageViewModel.StatusText(action.Status)</span>
                    <span class="small text-muted risk-action-owner">Owner: @Model.OwnerOf(action.OwnerId)</span>
                    @if (action.DueOn is { } due)
                    {
                        <span class="small risk-action-due @(overdue ? "text-danger fw-semibold" : "text-muted")">Due @due.ToString("dd-MM-yyyy")@(overdue ? " (overdue)" : "")</span>
                    }
                    @if (action.DoneAt is { } doneAt)
                    {
                        <span class="small text-muted">Done by @Model.NameOf(action.DoneById) on @doneAt.ToLocalTime().ToString("dd-MM-yyyy")</span>
                    }
                </div>
                @if (action.Links.Count > 0)
                {
                    <ul class="small mb-1 mt-1">
                        @foreach (var link in action.Links)
                        {
                            @if (link.WorkItemId is not null)
                            {
                                var story = Model.WorkItemOf(link.WorkItemId);
                                <li class="risk-action-link" data-kind="story">Story: @if (story is not null) { <a href="@story.Url" target="_blank" rel="noopener noreferrer">@story.Title</a> <span class="badge text-bg-light">@story.State</span> } else { <span>(user story removed)</span> }</li>
                            }
                            else
                            {
                                <li class="risk-action-link" data-kind="evidence">Evidence: @Model.EvidenceTitle(link.EvidenceId)</li>
                            }
                        }
                    </ul>
                }
                @if (editable && !action.IsDone)
                {
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <form asp-action="LinkAction" method="post" class="d-flex gap-1 link-risk-action">
                            <input type="hidden" name="id" value="@risk.Id" />
                            <input type="hidden" name="actionId" value="@action.Id" />
                            <select name="target" class="form-select form-select-sm" aria-label="Story or evidence for @action.Title">
                                @if (Model.Compliance is { } stories)
                                {
                                    <optgroup label="User stories">
                                        @foreach (var story in stories.WorkItems.Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed && action.Links.All(l => l.WorkItemId != w.Id)))
                                        {
                                            <option value="story:@story.Id">@story.Title</option>
                                        }
                                    </optgroup>
                                }
                                <optgroup label="Evidence">
                                    @foreach (var evidence in Model.ProjectEvidence.Where(e => action.Links.All(l => l.EvidenceId != e.Id)))
                                    {
                                        <option value="evidence:@evidence.Id">@evidence.Title</option>
                                    }
                                </optgroup>
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Link</button>
                        </form>
                        <form asp-action="CompleteAction" method="post" class="complete-risk-action">
                            <input type="hidden" name="id" value="@risk.Id" />
                            <input type="hidden" name="actionId" value="@action.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Mark as done</button>
                        </form>
                    </div>
                }
            </li>
        }
    </ul>
    @if (editable)
    {
        <form asp-action="AddAction" method="post" class="row g-2" id="add-risk-action">
            <input type="hidden" name="id" value="@risk.Id" />
            <div class="col-md-5">
                <input name="title" required maxlength="@RiskAction.MaxTitleLength" class="form-control form-control-sm" placeholder="What will be done, e.g. Shorter session lifetime" aria-label="Action" />
            </div>
            <div class="col-md-3">
                <select name="ownerId" class="form-select form-select-sm" aria-label="Owner">
                    @foreach (var member in Model.Organization.Members)
                    {
                        <option value="@member.Id" selected="@(member.Id == risk.OwnerId)">@member.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="dueOn" class="form-control form-control-sm" aria-label="Due date" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Add action</button>
            </div>
        </form>
    }
</section>

<section class="mb-4">
    @* US-124 R1: risk → measures and actions → user stories → requirements → evidence *@
    <h2 class="h5">Trace</h2>
    @{
        var trace = Model.Trace;
        async Task Requirement(ComplianceTracker.Application.Risks.TraceRequirement requirement, string kind)
        {
            <li class="trace-node" data-kind="@kind" data-name="@requirement.Requirement.Code">
                <span class="badge text-bg-light">@requirement.Framework</span>
                <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id" asp-route-tab="@ProjectTabs.Compliance"
                   asp-route-sub="@FrameworkNames.Slug(requirement.Framework)" asp-route-q="@requirement.Requirement.Code">@requirement.Requirement.Code</a>
                <span class="small">@requirement.Requirement.Title</span>
                @if (requirement.Evidence.Count > 0)
                {
                    <ul class="list-unstyled ms-3 mb-0">
                        @foreach (var item in requirement.Evidence)
                        {
                            <li class="trace-node small" data-kind="evidence" data-name="@item.Evidence.Title">
                                Evidence: @item.Evidence.Title@(item.IsExpired ? " (expired)" : "")
                            </li>
                        }
                    </ul>
                }
            </li>
        }
        async Task Story(ComplianceTracker.Application.Risks.TraceStory story, string kind)
        {
            <li class="trace-node" data-kind="@kind" data-name="@story.Story.Title">
                Story: <a href="@story.Story.Url" target="_blank" rel="noopener noreferrer">@story.Story.Title</a>
                <span class="badge text-bg-light">@story.Story.State</span>
                @if (story.Requirements.Count > 0)
                {
                    <ul class="list-unstyled ms-3 mb-0">
                        @foreach (var requirement in story.Requirements)
                        {
                            await Requirement(requirement, "requirement");
                        }
                    </ul>
                }
                else
                {
                    <span class="small text-muted">· covers no requirement yet</span>
                }
            </li>
        }
    }
    @if (trace is null || trace.IsEmpty)
    {
        <p class="text-muted" id="no-trace">No measures or actions yet, so nothing to trace</p>
    }
    else
    {
        <ul class="list-unstyled" id="risk-trace">
            @foreach (var requirement in trace.MeasureRequirements)
            {
                await Requirement(requirement, "measure-requirement");
            }
            @foreach (var story in trace.MeasureStories)
            {
                await Story(story, "measure-story");
            }
            @foreach (var action in trace.Actions)
            {
                <li class="trace-node" data-kind="action" data-name="@action.Action.Title">
                    Action: <strong>@action.Action.Title</strong>
                    <span class="badge text-bg-secondary">@RiskPageViewModel.StatusText(action.Action.Status)</span>
                    <ul class="list-unstyled ms-3 mb-1">
                        @foreach (var story in action.Stories)
                        {
                            await Story(story, "story");
                        }
                        @foreach (var evidenceId in action.EvidenceIds)
                        {
                            <li class="trace-node small" data-kind="evidence" data-name="@Model.EvidenceTitle(evidenceId)">Evidence: @Model.EvidenceTitle(evidenceId)</li>
                        }
                    </ul>
                </li>
            }
        </ul>
    }
</section>

@if (editable)
{
    <section class="d-flex flex-wrap gap-4">
        <form asp-action="Review" method="post" id="review-risk">
            <input type="hidden" name="id" value="@risk.Id" />
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark as reviewed</button>
        </form>
        @if (risk.Status != RiskStatus.Accepted && canDecide)
        {
            <form asp-action="Accept" method="post" class="d-flex gap-1" id="accept-risk">
                <input type="hidden" name="id" value="@risk.Id" />
                <input name="reason" class="form-control form-control-sm" placeholder="Why the risk is accepted" aria-label="Reason for accepting" />
                <button type="submit" class="btn btn-outline-warning btn-sm text-nowrap">Accept risk</button>
            </form>
        }
        @if (canDecide)
        {
        <form asp-action="Close" method="post" class="d-flex gap-1" id="close-risk">
            <input type="hidden" name="id" value="@risk.Id" />
            <input name="reason" class="form-control form-control-sm" placeholder="Why the risk no longer applies" aria-label="Reason for closing" />
            <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">Close risk</button>
        </form>
        }
    </section>
}
