@* The public front page (US-004 R1). Signed-in users never see it: HomeController sends them to their organisation. *@
@inject Microsoft.Extensions.Options.IOptions<ComplianceTracker.Web.Models.BrandingOptions> Branding
@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5" id="front-page">
    <h1 class="display-4">@Branding.Value.Name</h1>
    <p class="lead">Keep track of the standards and regulations your organisation and products must meet.</p>
    <p>
        @* Goes to AccountController.Login, which sends the user to Keycloak *@
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
    </p>
    <p class="text-muted">New here? Choose "Register" on the sign-in page, and create your organisation afterwards.</p>
    @* US-180: for the receiver of an audit package, without an account *@
    <p class="small"><a asp-controller="Verify" asp-action="Index" id="verify-link">Verify an audit package</a></p>
</div>
