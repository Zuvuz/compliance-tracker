@{
    ViewData["Title"] = "Compliance Tracker";
}

<div class="text-center py-5" id="front-page">
    <h1 class="display-4">Compliance Tracker</h1>
    <p class="lead">Keep track of the standards and regulations your organisation and products must meet.</p>
