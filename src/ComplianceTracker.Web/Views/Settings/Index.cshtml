@* Settings (US-045, in the top bar, organisation admin only). The AI feedback sharing (US-036, US-130).
   Ids used by the tests: #ai-feedback, #ai-sharing-state, #set-ai-sharing, #ai-shared-count. *@
@using ComplianceTracker.Domain.Organizations
@model Organization
@{
    ViewData["Title"] = "Settings";
}

<partial name="_OrganizationHeader" model="Model" />

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@* US-080: the industry and what it suggests. Ids used by the tests: form#choose-industry (industry, productsUseAi),
   #industry-suggestions li.industry-suggestion[data-name] with .suggestion-reason, .suggestion-state and
   form.switch-on-suggestion, #industry-coming, #industry-scan-kinds li, #industry-reports li. *@
@{
    var industryView = ViewData["Industry"] as ComplianceTracker.Application.Organizations.IndustryView;
}
<section id="industry-profile" class="mb-4">
    <h2 class="h4">Industry</h2>
    <p class="small text-muted mb-2">Choose the industry you make products for. The tracker suggests the regulations, scans and reports that usually fit; it never switches anything on by itself.</p>
    <form asp-action="ChooseIndustry" method="post" class="d-flex flex-wrap gap-3 align-items-center mb-3" id="choose-industry">
        <select name="industry" class="form-select form-select-sm w-auto" aria-label="Industry">
            <option value="">Choose…</option>
            @foreach (var industry in Enum.GetValues<Industry>())
            {
                <option value="@industry" selected="@(industryView?.Industry == industry)">@industry</option>
            }
        </select>
        <div class="form-check m-0">
            <input class="form-check-input" type="checkbox" name="productsUseAi" value="true" id="products-use-ai" checked="@(industryView?.ProductsUseAi == true)" />
            <label class="form-check-label small" for="products-use-ai">Our products use AI</label>
        </div>
        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
    </form>

    @if (industryView?.Profile is { } profile)
    {
        @if (profile.ComingSoon is { } coming)
        {
            <div class="alert alert-info py-2 small" id="industry-coming">Suggestions for @profile.Industry are coming: @coming. Until then you see the suggestions that fit software products.</div>
        }

        @if (profile.Frameworks.Count == 0)
        {
            <p class="small text-muted" id="industry-no-suggestions">No suggestions for this industry.</p>
        }
        else
        {
            <ul class="list-group mb-3" id="industry-suggestions">
                @foreach (var suggestion in profile.Frameworks)
                {
                    var on = suggestion.FrameworkId is { } id && industryView.SwitchedOn.Contains(id);
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 industry-suggestion" data-name="@suggestion.Name">
                        <div>
                            <strong>@suggestion.Name</strong>
                            <div class="small text-muted suggestion-reason">@suggestion.Reason</div>
                        </div>
                        @switch (suggestion.Action)
                        {
                            case ComplianceTracker.Application.Organizations.SuggestionAction.SwitchOn when on:
                                <span class="badge text-bg-success suggestion-state">On</span>
                                break;
                            case ComplianceTracker.Application.Organizations.SuggestionAction.SwitchOn:
                                <span class="d-flex gap-2 align-items-center">
                                    <span class="badge text-bg-light border suggestion-state">Off</span>
                                    <form asp-controller="Frameworks" asp-action="Enable" method="post" class="switch-on-suggestion">
                                        <input type="hidden" name="frameworkId" value="@suggestion.FrameworkId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Switch on</button>
                                    </form>
                                </span>
                                break;
                            case ComplianceTracker.Application.Organizations.SuggestionAction.ScopeCheck:
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Organisation" asp-action="Index" asp-route-tab="nis2-scope">Do the scope check</a>
                                break;
                            default:
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Frameworks" asp-action="Index">Add your own copy</a>
                                break;
                        }
                    </li>
                }
            </ul>
            <div class="row small">
                <div class="col-md-6">
                    <h3 class="h6">Scans you are expected to have</h3>
                    <ul id="industry-scan-kinds">
                        @foreach (var kind in profile.ScanKinds)
                        {
                            <li>@kind</li>
                        }
                    </ul>
                </div>
                <div class="col-md-6">
                    <h3 class="h6">Reports you are expected to have</h3>
                    <ul id="industry-reports">
                        @foreach (var report in profile.Reports)
                        {
                            <li>@report</li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
</section>

<section id="ai-feedback">
    <h2 class="h4">AI feedback</h2>
    <p class="small text-muted mb-2">
        Every AI suggestion and your decision on it is kept in the tracker as an audit trail.
        Your decisions on AI suggestions (the texts the AI compared and whether you approved them, without names or e-mails) help us train better models for the tracker. They are shared by default. You can switch this off under Settings, or leave a single confidential project out on its Edit page.
        Only decisions made while sharing is on are used.
    </p>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span>Share our decisions to improve the AI: <strong id="ai-sharing-state">@(Model.ShareAiFeedback ? "On" : "Off")</strong></span>
        <form asp-action="SetAiSharing" method="post" data-confirm="This changes whether the organisation's AI decisions may be used to improve the AI." id="set-ai-sharing">
            <input type="hidden" name="share" value="@(Model.ShareAiFeedback ? "false" : "true")" />
            <button type="submit" class="btn btn-sm btn-outline-primary">@(Model.ShareAiFeedback ? "Switch off" : "Switch on")</button>
        </form>
        @* US-130 R6: organisations do not export for their own models; they see how much is shared *@
        <span class="small text-muted" id="ai-shared-count">@ViewData["SharedCount"] decisions shared</span>
    </div>
</section>

@* US-142 R6: the EU country the organisation is established in, which decides the national laws (e.g. the Danish NIS2 law) *@
<section id="organisation-country" class="mt-4">
    <h2 class="h4">Country</h2>
    <form asp-action="SetCountry" method="post" class="d-flex flex-wrap gap-2 align-items-center" id="set-country">
        <select name="country" class="form-select form-select-sm w-auto" aria-label="Country">
            @foreach (var code in Organization.EuCountries)
            {
                <option value="@code" selected="@(Model.Country == code)">@code</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
        <span class="small text-muted">Decides which national laws are offered, e.g. the Danish NIS2 law for DK.</span>
    </form>
</section>

@* US-132: the certificate signed reports are sealed with. The file and password are kept encrypted and never shown. *@
<section id="organisation-seal" class="mt-4">
    <h2 class="h4">Seal for signed reports</h2>
    <p class="small text-muted mb-2">When a locked report has been signed by a compliance officer and a manager, it is sealed with this certificate as a digital signature in the PDF. Upload the organisation's certificate as .pfx with its private key.</p>
    @if (ViewData["Seal"] is ComplianceTracker.Domain.Reports.OrganisationSeal seal)
    {
        <p id="seal-status">Seal: <strong>@seal.Subject</strong>, valid until <span id="seal-valid-until">@seal.NotAfter.ToString("dd-MM-yyyy")</span></p>
        <form asp-action="RemoveSeal" method="post" id="remove-seal" class="mb-2"
              data-confirm="Signed reports can no longer be sealed until a new certificate is uploaded. Reports sealed already stay sealed.">
            <button type="submit" class="btn btn-sm btn-outline-danger">Remove the seal</button>
        </form>
    }
    else
    {
        <p class="text-muted" id="seal-status">No seal yet.</p>
    }
    <form asp-action="UploadSeal" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2" id="upload-seal">
        <input type="file" name="file" accept=".pfx,.p12" class="form-control form-control-sm w-auto" aria-label="Certificate (.pfx)" />
        <input type="password" name="password" autocomplete="off" class="form-control form-control-sm w-auto" placeholder="Password" aria-label="Certificate password" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Upload seal</button>
    </form>
</section>
