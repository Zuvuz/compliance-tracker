@* Settings (US-045, in the top bar, for the organisation's admins; US-163 R3: others see it without changing it). The AI feedback sharing (US-036, US-130).
   Ids used by the tests: #ai-feedback, #ai-sharing-state, #set-ai-sharing, #ai-shared-count. *@
@using ComplianceTracker.Domain.Organizations
@model Organization
@{
    ViewData["Title"] = "Settings";
}

@{
    // US-163 R3: for the organisation's admins; other members see the settings without being able to change them
    var canEdit = ViewData["CanEdit"] as bool? ?? true;
}
<partial name="_OrganizationHeader" model="Model" />

<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p class="alert alert-light border small" id="settings-for">
    For the organisation's admins.@(canEdit ? "" : " You can see the settings but not change them.")
    The industry, NIS2 sector, country and whether the products use AI are on the <a asp-controller="Organisation" asp-action="Profile" id="settings-to-profile">organisation's profile</a>.
</p>
<fieldset @(canEdit ? "" : "disabled") id="settings-fields" class="border-0 p-0 m-0">

<section id="ai-feedback">
    <h2 class="h4">AI feedback</h2>
    <p class="small text-muted mb-2">
        Every AI suggestion and your decision on it is kept in the tracker as an audit trail.
        Your decisions on AI suggestions (the texts the AI compared and whether you approved them, without names or e-mails) help us train better models for the tracker. They are shared by default. You can switch this off under Settings, or leave a single confidential project out on its Edit page.
        Only decisions made while sharing is on are used.
    </p>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span>Share our decisions to improve the AI: <strong id="ai-sharing-state">@(Model.ShareAiFeedback ? "On" : "Off")</strong></span>
        <form asp-action="SetAiSharing" method="post" data-confirm="This changes whether the organisation's AI decisions may be used to improve the AI." id="set-ai-sharing">
            <input type="hidden" name="share" value="@(Model.ShareAiFeedback ? "false" : "true")" />
            <button type="submit" class="btn btn-sm btn-outline-primary">@(Model.ShareAiFeedback ? "Switch off" : "Switch on")</button>
        </form>
        @* US-130 R6: organisations do not export for their own models; they see how much is shared *@
        <span class="small text-muted" id="ai-shared-count">@ViewData["SharedCount"] decisions shared</span>
    </div>
</section>

<section id="review-dates" class="mt-4">
    @* US-195 R3: the default review dates the forms fill in. Ids used by the tests: form#set-review-defaults *@
    <h2 class="h4" id="review-defaults">Review dates</h2>
    <p class="text-muted small">The forms fill in a date this many months from today. Changing it does not change dates already set.</p>
    <form asp-action="SetReviewDefaults" method="post" class="row g-2 align-items-end mb-4" id="set-review-defaults">
        @foreach (var (kind, name) in new[] { (ReviewDateKind.EvidenceValidity, "evidenceValidity"), (ReviewDateKind.DocumentReview, "documentReview"),
                                               (ReviewDateKind.SupplierEvidence, "supplierEvidence"), (ReviewDateKind.AuditCertificate, "auditCertificate") })
        {
            <div class="col-md-3">
                <label for="default-@name" class="form-label small">@ReviewDefaults.Title(kind) (months)</label>
                <input id="default-@name" name="@name" type="number" min="@ReviewDefaults.MinMonths" max="@ReviewDefaults.MaxMonths"
                       value="@Model.ReviewDefaults.MonthsFor(kind)" class="form-control form-control-sm" required />
            </div>
        }
        <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Save review dates</button></div>
    </form>

</section>

@* US-132: the certificate signed reports are sealed with. The file and password are kept encrypted and never shown. *@
<section id="organisation-seal" class="mt-4">
    <h2 class="h4">Seal for signed reports</h2>
    <p class="small text-muted mb-2">When a locked report has been signed by a compliance officer and a manager, it is sealed with this certificate as a digital signature in the PDF. Upload the organisation's certificate as .pfx with its private key.</p>
    @if (ViewData["Seal"] is ComplianceTracker.Domain.Reports.OrganisationSeal seal)
    {
        <p id="seal-status">Seal: <strong>@seal.Subject</strong>, valid until <span id="seal-valid-until">@seal.NotAfter.ToString("dd-MM-yyyy")</span></p>
        <form asp-action="RemoveSeal" method="post" id="remove-seal" class="mb-2"
              data-confirm="Signed reports can no longer be sealed until a new certificate is uploaded. Reports sealed already stay sealed.">
            <button type="submit" class="btn btn-sm btn-outline-danger">Remove the seal</button>
        </form>
    }
    else
    {
        <p class="text-muted" id="seal-status">No seal yet.</p>
    }
    <form asp-action="UploadSeal" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2" id="upload-seal" data-busy="Uploading…">
        <input type="file" name="file" accept=".pfx,.p12" class="form-control form-control-sm w-auto" aria-label="Certificate (.pfx)" />
        <input type="password" name="password" autocomplete="off" class="form-control form-control-sm w-auto" placeholder="Password" aria-label="Certificate password" />
        <button type="submit" class="btn btn-sm btn-outline-primary">Upload seal</button>
    </form>
</section>

</fieldset>

@* US-184: the organisation's way out, for the organisation admin. Ids used by the tests: #export-everything,
   #close-organisation with form#start-closing or #closing-notice and form#undo-closing. *@
@if (await Permissions.CanAsync(ComplianceTracker.Domain.Users.Permission.ManageMembers))
{
    <h2 class="h4 mt-4">Your data</h2>
    <p class="text-muted small">All of the organisation's data as one ZIP file: every table as JSON and every stored file, each with its SHA-256.</p>
    <a asp-action="Export" class="btn btn-sm btn-outline-primary" id="export-everything">Export everything</a>

    <section class="card border-danger mt-4" id="close-organisation">
        <div class="card-body">
            <h2 class="h5 card-title text-danger">Close the organisation</h2>
            @if (Model.IsClosing)
            {
                <p class="mb-2" id="closing-notice">The organisation is being closed. All its data is deleted on <strong>@Model.ClosesOn?.ToString("dd-MM-yyyy")</strong>
                    unless you undo it before then. Export everything first.</p>
                <form asp-action="UndoClosing" method="post" id="undo-closing">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Undo closing</button>
                </form>
            }
            else
            {
                <p class="small">Closing deletes all the organisation's data after @ComplianceTracker.Domain.Organizations.Organization.ClosingWaitDays days.
                    Until then it can be undone. The members are told by mail. The activity log is kept, without names.</p>
                <form asp-action="StartClosing" method="post" class="d-flex flex-wrap gap-2 align-items-end" id="start-closing"
                      data-confirm="All data is deleted after 30 days unless you undo it.">
                    <div><label for="confirm-name" class="form-label small mb-0">Type "@Model.Name" to confirm</label>
                        <input id="confirm-name" name="confirmName" class="form-control form-control-sm" autocomplete="off" required /></div>
                    <button type="submit" class="btn btn-sm btn-danger">Close the organisation</button>
                </form>
            }
        </div>
    </section>
}
