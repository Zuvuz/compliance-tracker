@* Settings (US-045, in the top bar, organisation admin only). For now the AI feedback consent and export (US-036 R5–R9).
   Ids used by the tests: #ai-feedback, #ai-sharing-state, #set-ai-sharing, #export-ai-feedback. *@
@using ComplianceTracker.Domain.Organizations
@model Organization
@{
    ViewData["Title"] = "Settings";
}

<partial name="_OrganizationHeader" model="Model" />

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<section id="ai-feedback">
    <h2 class="h4">AI feedback</h2>
    <p class="small text-muted mb-2">
        Every AI suggestion and your decision on it is kept in the tracker as an audit trail.
        Only when sharing is on can the decisions be exported to improve the AI. The export has no names or e-mails.
    </p>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span>Share our decisions to improve the AI: <strong id="ai-sharing-state">@(Model.ShareAiFeedback ? "On" : "Off")</strong></span>
        <form asp-action="SetAiSharing" method="post" id="set-ai-sharing">
            <input type="hidden" name="share" value="@(Model.ShareAiFeedback ? "false" : "true")" />
            <button type="submit" class="btn btn-sm btn-outline-primary">@(Model.ShareAiFeedback ? "Switch off" : "Switch on")</button>
        </form>
        <form asp-action="ExportAiFeedback" method="post" id="export-ai-feedback">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Export AI feedback</button>
        </form>
    </div>
</section>
