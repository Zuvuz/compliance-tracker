@* US-177: "⋯" next to an upload: withdraw it with a reason (R4). Classes used by the tests: details.withdraw-menu with
   form.withdraw-upload (reason). #52: it opens in the shared dialog (US-166), so it is never cut off by the card it sits in;
   without JavaScript it opens in place. *@
@model WithdrawMenu
<details class="withdraw-menu d-inline-block" data-dialog-title="Withdraw @Model.What">
    <summary class="btn btn-sm btn-outline-secondary" aria-label="More for @Model.What">⋯</summary>
    <form asp-controller="Projects" asp-action="@Model.Action" method="post" class="withdraw-upload mt-1">
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="@Model.IdName" value="@Model.IdValue" />
        <label class="form-label small mb-1" for="withdraw-@Model.IdValue">Withdraw @Model.What: why?</label>
        <input class="form-control form-control-sm mb-1" id="withdraw-@Model.IdValue" name="reason" maxlength="@ComplianceTracker.Domain.Common.Withdrawal.MaxReasonLength" required placeholder="e.g. Wrong project" />
        @if (Model.Effect is { } effect)
        {
            <p class="small text-muted mb-1">@effect</p>
        }
        <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
    </form>
</details>
