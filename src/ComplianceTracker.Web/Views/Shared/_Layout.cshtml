@* The shared frame around every page: menu at the top, the page itself in the middle (@RenderBody), footer at the bottom.
   US-064: the theme is in wwwroot/css/site.css (top bar .ct-topbar); the product name comes from Branding:ProductName. *@
@inject Microsoft.Extensions.Options.IOptions<ComplianceTracker.Web.Models.BrandingOptions> Branding
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Branding.Value.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ComplianceTracker.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark ct-topbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" id="product-name">@Branding.Value.Name</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @* Left side of the menu (US-045): the main pages. Users and Settings only for the roles that may use them,
                       System only for the tracker's owner (US-010). The id #top-bar is used by the tests. *@
                    @{
                        var signedIn = User.Identity?.IsAuthenticated == true;
                        var current = ViewContext.RouteData.Values["controller"] as string;
                        string Active(params string[] controllers) => controllers.Contains(current) ? "active fw-semibold" : "";
                    }
                    <ul class="navbar-nav flex-grow-1" id="top-bar">
                        @if (signedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Projects", "Risks")" id="nav-projects" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Frameworks")" id="nav-frameworks" asp-area="" asp-controller="Frameworks" asp-action="Index">Frameworks</a>
                            </li>
                            <li class="nav-item">
                                @* US-136 *@
                                <a class="nav-link @Active("Documents")" id="nav-documents" asp-area="" asp-controller="Documents" asp-action="Index">Documents</a>
                            </li>
                            @if (await Permissions.CanAsync(Permission.ManageMembers))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Users")" id="nav-users" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                                </li>
                            }
                            @if (await Permissions.CanSeeOrganisationLogAsync())
                            {
                                @* US-102: the whole organisation's activity log *@
                                <li class="nav-item">
                                    <a class="nav-link @Active("Activity")" id="nav-activity" asp-area="" asp-controller="Activity" asp-action="Index">Activity</a>
                                </li>
                            }
                            @if (await Permissions.CanAsync(Permission.ManageAiSharing))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Settings")" id="nav-settings" asp-area="" asp-controller="Settings" asp-action="Index">Settings</a>
                                </li>
                            }
                            @if (User.HasClaim(ComplianceTracker.Web.Security.SystemAdmin.ClaimType, ComplianceTracker.Web.Security.SystemAdmin.Role))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("System")" id="system-link" asp-area="" asp-controller="System" asp-action="Index">System</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                    </ul>
                    @* Right side of the menu: the signed-in user's name and "Sign out", or "Sign in" (US-004) *@
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link" id="signed-in-user">@User.Identity.Name</span>
                            </li>
                            @* Sign out is a POST form with an antiforgery token, so other websites cannot sign the user out *@
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["FeedbackSent"] is string thanks)
            {
                @* US-063 R4 *@
                <div class="alert alert-success mt-3" id="feedback-thanks" role="status">@thanks</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - <span id="footer-product-name">@Branding.Value.Name</span> - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* US-063 R1 *@
                <text> - </text><a id="send-feedback" asp-area="" asp-controller="Feedback" asp-action="Index" asp-route-page="@(Context.Request.Path + Context.Request.QueryString)">Send feedback</a>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
