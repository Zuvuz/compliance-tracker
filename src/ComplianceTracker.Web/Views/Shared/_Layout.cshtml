@* The shared frame around every page: menu at the top, the page itself in the middle (@RenderBody), footer at the bottom.
   US-064: the theme is in wwwroot/css/site.css (top bar .ct-topbar); the product name comes from Branding:ProductName. *@
@inject Microsoft.Extensions.Options.IOptions<ComplianceTracker.Web.Models.BrandingOptions> Branding
@inject ComplianceTracker.Application.Organizations.OrganizationQueries Organisations
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Branding.Value.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ComplianceTracker.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-dark ct-topbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" id="product-name">@Branding.Value.Name</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @* US-167: the menu folds into the button below 992 px, and its items wrap instead of making the page wider *@
                <div class="navbar-collapse collapse d-lg-inline-flex flex-wrap justify-content-between">
                    @* Left side of the menu (US-045): the main pages. Users and Settings only for the roles that may use them,
                       System only for the tracker's owner (US-010). The id #top-bar is used by the tests. *@
                    @{
                        var signedIn = User.Identity?.IsAuthenticated == true;
                        var current = ViewContext.RouteData.Values["controller"] as string;
                        // US-142: the organisation area is shown on the project page. US-225: its risks belong to ISMS and the rest to
                        // Compliance; Section names the top bar item a page belongs to
                        var organisationArea = ViewData["OrganisationArea"] is true;
                        var section = TopBar.SectionOf(current, ViewContext.RouteData.Values["action"] as string, organisationArea,
                            ViewData["AreaTab"] as string);
                        string Active(string item) => section == item ? "active fw-semibold" : "";
                    }
                    <ul class="navbar-nav flex-wrap flex-grow-1" id="top-bar">
                        @if (signedIn && await Permissions.IsLimitedAsync())
                        {
                            @* US-182 R5: an external auditor reads one project only *@
                            <li class="nav-item"><span class="nav-link" id="nav-auditor-access">Read-only audit access</span></li>
                        }
                        else if (signedIn)
                        {
                            @* US-225: five items, each with one row of subpages. Home is what waits for me (US-169 R3, US-099); its badge
                               counts what is overdue or due within 7 days, fetched after the page has loaded (site.js) *@
                            <li class="nav-item">
                                <a class="nav-link @Active(TopBar.Home)" id="nav-review" asp-area="" asp-controller="Review" asp-action="Index">Home<span class="badge rounded-pill text-bg-danger ms-1 d-none" id="nav-tasks-count" data-count-url="@Url.Action("Count", "Review")"></span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active(TopBar.Projects)" id="nav-projects" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                            </li>
                            @* US-225: the regulations the whole organisation follows: frameworks, NIS2, requirements, evidence, checklists, reports *@
                            <li class="nav-item">
                                <a class="nav-link @Active(TopBar.Compliance)" id="nav-compliance" asp-area="" asp-controller="Frameworks" asp-action="Index">Compliance</a>
                            </li>
                            @* US-208: the organisation's ISMS (ISO/IEC 27001 4–10) has its own area with its pages as a row of links *@
                            <li class="nav-item">
                                <a class="nav-link @Active(TopBar.Isms)" id="nav-isms" asp-area="" asp-controller="Isms" asp-action="Index">ISMS</a>
                            </li>
                            @* US-225: the administration: profile, users, settings, the activity log *@
                            <li class="nav-item">
                                <a class="nav-link @Active(TopBar.Organisation)" id="nav-organisation" asp-area="" asp-controller="Organisation" asp-action="Profile">Organisation</a>
                            </li>
                            @if (User.HasClaim(ComplianceTracker.Web.Security.SystemAdmin.ClaimType, ComplianceTracker.Web.Security.SystemAdmin.Role))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("System")" id="system-link" asp-area="" asp-controller="System" asp-action="Index">System</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                    </ul>
                    @* Right side of the menu: the signed-in user's name and "Sign out", or "Sign in" (US-004) *@
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* US-100: search across the organisation's requirements, work items, evidence, risks and projects *@
                            <li class="nav-item d-flex align-items-center me-lg-2">
                                <form method="get" action="@Url.Action("Index", "Search")" role="search" id="top-search" class="d-flex">
                                    <label for="top-search-q" class="visually-hidden">Search</label>
                                    <input type="search" class="form-control form-control-sm" id="top-search-q" name="q" placeholder="Search" maxlength="200" />
                                </form>
                            </li>
                            @* US-187: a person in several organisations switches here; the current one is marked *@
                            var memberships = await Organisations.MembershipsAsync();
                            if (memberships.Count > 1)
                            {
                                var chosen = (await Organisations.MineAsync())?.Id;
                                <li class="nav-item dropdown" id="organisation-switcher">
                                    <a class="nav-link dropdown-toggle" href="#" id="nav-switch-organisation" role="button" data-bs-toggle="dropdown" aria-expanded="false">@(memberships.FirstOrDefault(m => m.OrganizationId == chosen)?.Name)</a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nav-switch-organisation">
                                        @foreach (var membership in memberships)
                                        {
                                            <li>
                                                <form asp-controller="Organizations" asp-action="Switch" method="post" class="switch-organisation" data-organisation="@membership.Name">
                                                    <input type="hidden" name="organizationId" value="@membership.OrganizationId" />
                                                    <button type="submit" class="dropdown-item @(membership.OrganizationId == chosen ? "active" : "")"
                                                            aria-current="@(membership.OrganizationId == chosen ? "true" : null)">@membership.Name <span class="small">(@ComplianceTracker.Domain.Users.RolePermissions.Title(membership.Role))</span></button>
                                                </form>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" id="nav-my-customers" asp-controller="Organizations" asp-action="Customers">My customers</a></li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="nav-link" id="signed-in-user">@User.Identity.Name</span>
                            </li>
                            @* US-183: my reminders by e-mail *@
                            <li class="nav-item">
                                <a class="nav-link" id="nav-reminders" asp-area="" asp-controller="Reminders" asp-action="Index">Reminders</a>
                            </li>
                            @* Sign out is a POST form with an antiforgery token, so other websites cannot sign the user out *@
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @* US-225: the row of subpages of the top bar item *@
            @if (signedIn && !await Permissions.IsLimitedAsync() && section == TopBar.Organisation)
            {
                <partial name="_OrganisationNav" />
            }
            else if (signedIn && !await Permissions.IsLimitedAsync() && section == TopBar.Compliance)
            {
                <partial name="_ComplianceNav" />
            }
            else if (signedIn && !await Permissions.IsLimitedAsync() && section == TopBar.Isms)
            {
                <partial name="/Views/Isms/_IsmsNav.cshtml" />
            }
            @if (TempData["FeedbackSent"] is string thanks)
            {
                @* US-063 R4 *@
                <div class="alert alert-success mt-3" id="feedback-thanks" role="status">@thanks</div>
            }
            @if (signedIn && await Permissions.ClosesOnAsync() is { } closesOn)
            {
                @* US-184 R3: every member sees it until it is undone *@
                <div class="alert alert-danger mt-3" id="organisation-closing" role="alert">This organisation is being closed: all its data is deleted on @closesOn.ToString("dd-MM-yyyy").</div>
            }
            @if (TempData["NoReviewDate"] is string noDate)
            {
                @* US-195 R2 *@
                <div class="alert alert-warning mt-3" id="no-review-date" role="alert">@noDate</div>
            }
            @if (TempData["ApprovalRequested"] is string waits)
            {
                @* US-135 R2 *@
                <div class="alert alert-info mt-3" id="approval-requested" role="status">@waits</div>
            }
            @* US-171 R1: one place for the message of the last action; success fades (site.js), warnings and errors stay *@
            <partial name="_Messages" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - <span id="footer-product-name">@Branding.Value.Name</span> - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> - <a asp-area="" asp-controller="Help" asp-action="Index" id="footer-help">Help</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* US-063 R1 *@
                <text> - </text><a id="send-feedback" asp-area="" asp-controller="Feedback" asp-action="Index" asp-route-page="@(Context.Request.Path + Context.Request.QueryString)">Send feedback</a>
            }
        </div>
    </footer>
    @* US-166: the shared dialog for forms that interrupt a page (site.js). A part with data-dialog is moved into it when
       opened and back when closed; without JavaScript the part stays where it is and works as a normal form (R5). *@
    <div class="modal fade" id="shared-dialog" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="shared-dialog-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="shared-dialog-title"></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                </div>
                <div class="modal-body" id="shared-dialog-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    @* US-135 R1: the confirmation dialog for forms with data-confirm (site.js) *@
    <div class="modal fade" id="confirm-dialog" tabindex="-1" aria-labelledby="confirm-dialog-title" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="confirm-dialog-title">Are you sure?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                </div>
                <div class="modal-body">
                    <p id="confirm-dialog-text" class="mb-2"></p>
                    <p id="confirm-dialog-final" class="text-danger small mb-0" hidden>This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirm-dialog-ok">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewData[ComplianceTracker.Web.Models.PageVisits.Key] is Guid pageVisit)
    {
        @* US-219 R2: the signs of life of this visit for the access log *@
        <form id="page-visit" hidden method="post" action="@Url.Action("SignOfLife", "AccessLog")" data-every="@((int)ComplianceTracker.Domain.ActivityLog.AccessLogRules.SignOfLifeEvery.TotalMilliseconds)">
            <input type="hidden" name="visitId" value="@pageVisit" />
            @Html.AntiForgeryToken()
        </form>
        <script src="~/js/access-log.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
