@* Shared top of the organisation's pages (Projects, Users, Settings): the name and the CVR in small text.
   The pages themselves are in the top bar (US-045), so there are no tabs here. *@
@using ComplianceTracker.Domain.Organizations
@model Organization

<h1 id="organisation-name" class="mb-0">@Model.Name</h1>
@* Sector and size are still stored, but not shown: they are used later to decide which frameworks apply *@
<p class="text-muted small mb-3">
    CVR <span id="organisation-cvr">@Model.Cvr</span>
    @if (await Permissions.CanCheckActivityLogAsync())
    {
        @* US-091 R3 *@
        <text> · </text><a id="check-activity-log" asp-controller="LogCheck" asp-action="Index">Check the activity log</a>
    }
</p>
