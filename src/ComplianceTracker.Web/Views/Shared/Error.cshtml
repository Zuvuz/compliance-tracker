@* US-098 R3: the error page outside Development. It never shows technical details; the reference finds the error in
   the log (#error-reference). *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1 class="h3">Something went wrong</h1>
<p>The tracker could not finish what you asked for. Nothing was saved halfway; please try again.</p>
@if (Model.ShowRequestId)
{
    <p>If it happens again, give the operator this reference: <code id="error-reference">@Model.RequestId</code></p>
}
