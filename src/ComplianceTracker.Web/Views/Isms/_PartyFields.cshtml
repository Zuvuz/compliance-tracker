@* US-208 R4: the fields of an interested party, empty for a new one. The requirement rows are numbered, and a ticked row's
   number is sent as "handled". *@
@model ComplianceTracker.Domain.Isms.InterestedParty?
@using ComplianceTracker.Domain.Isms
@using ComplianceTracker.Web.Controllers
@{
    var prefix = Model?.Id.ToString("N") ?? "new";
    var rows = Model?.Requirements.OrderBy(r => r.Order).ToList() ?? [];
    var count = Math.Max(IsmsController.RequirementRows, rows.Count + 1);
}
<div class="col-md-6"><label for="party-name-@prefix" class="form-label small">Name</label>
    <input id="party-name-@prefix" name="name" maxlength="@InterestedParty.MaxNameLength" class="form-control form-control-sm" required value="@Model?.Name"
           placeholder="e.g. Customers" /></div>
<div class="col-md-6"><label for="party-kind-@prefix" class="form-label small">Kind</label>
    <select id="party-kind-@prefix" name="kind" class="form-select form-select-sm" required>
        @foreach (var kind in Enum.GetValues<InterestedPartyKind>())
        {
            <option value="@kind" selected="@(Model?.Kind == kind)">@kind</option>
        }
    </select></div>
<fieldset class="col-12">
    <legend class="form-label small">Requirements, and whether the ISMS handles them</legend>
    @for (var i = 0; i < count; i++)
    {
        var row = i < rows.Count ? rows[i] : null;
        <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
            <input name="requirement" maxlength="@InterestedParty.MaxRequirementLength" class="form-control form-control-sm flex-grow-1 ct-min-w-12"
                   aria-label="Requirement @(i + 1)" value="@row?.Text" placeholder="@(i == 0 ? "e.g. ISO 27001 certificate" : "")" />
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" name="handled" value="@i" id="party-handled-@prefix-@i" checked="@(row?.Handled == true)" />
                <label class="form-check-label small" for="party-handled-@prefix-@i">Handled</label>
            </div>
        </div>
    }
</fieldset>
