@* US-208: the ISMS area's pages as one row of links, like the organisation's pages. The next ISMS stories add theirs here. *@
@{
    var action = ViewContext.RouteData.Values["action"] as string;
    string Mark(params string[] actions) => actions.Contains(action) ? "active" : "";
}
<nav aria-label="ISMS" class="mb-3">
    <ul class="nav nav-pills small flex-wrap" id="isms-nav">
        <li class="nav-item"><a class="nav-link @Mark("Scope")" id="nav-isms-scope" asp-controller="Isms" asp-action="Scope">Scope and context</a></li>
        <li class="nav-item"><a class="nav-link @Mark("Objectives")" id="nav-isms-objectives" asp-controller="Isms" asp-action="Objectives">Objectives</a></li>
        <li class="nav-item"><a class="nav-link @Mark("Assets")" id="nav-isms-assets" asp-controller="Isms" asp-action="Assets">Assets</a></li>
        <li class="nav-item"><a class="nav-link @Mark("Nonconformities")" id="nav-isms-nonconformities" asp-controller="Isms" asp-action="Nonconformities">Nonconformities</a></li>
        <li class="nav-item"><a class="nav-link @Mark("InternalAudits")" id="nav-isms-internal-audits" asp-controller="Isms" asp-action="InternalAudits">Internal audits</a></li>
        <li class="nav-item"><a class="nav-link @Mark("Competence")" id="nav-isms-competence" asp-controller="Isms" asp-action="Competence">Competence and awareness</a></li>
    </ul>
</nav>
