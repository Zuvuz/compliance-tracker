@* US-116: the operator measures the AI against the decisions of the organisations that share them (US-036).
   Ids and classes used by the tests: #evaluate-story-matching, #ai-runs rows .ai-run (data-step) with .run-model,
   .run-decisions, .run-top1, .run-top3, .run-top10, .run-rejected-above, .run-grade; #ai-comparison li; #grade-rationales
   with .rationale-sample (data-code) and select[name^=grade-]. *@
@model AiQualityViewModel
@using ComplianceTracker.Domain.Ai
@{
    ViewData["Title"] = "AI quality";
    var matching = Model.Runs.Where(r => r.Step == AiEvaluationStep.StoryMatching).Take(2).ToList();
}

<p class="mb-1"><a asp-action="Index">← System</a></p>
<h1>AI quality</h1>
<p class="text-muted">Measured on the suggestions people approved and rejected, in the organisations that share their decisions. Nothing leaves your infrastructure, and a run changes no suggestion or link.</p>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<section class="mb-4">
    <h2 class="h5">Story matching</h2>
    <p class="small text-muted">How often an approved requirement is among the first 1, 3 and 10, and how many rejected ones still score above the limit. It uses the model of the task "Embedding".</p>
    <form asp-action="EvaluateStoryMatching" method="post" id="evaluate-story-matching">
        <button type="submit" class="btn btn-sm btn-outline-primary">Measure story matching</button>
    </form>
    @if (matching.Count == 2)
    {
        @* R4: the newest run against the one before it *@
        var (after, before) = (matching[0], matching[1]);
        <ul class="small mt-2" id="ai-comparison">
            <li>@before.Model → @after.Model</li>
            <li>@AiQualityViewModel.Compare("Top 1", before.Top1, after.Top1)</li>
            <li>@AiQualityViewModel.Compare("Top 3", before.Top3, after.Top3)</li>
            <li>@AiQualityViewModel.Compare("Top 10", before.Top10, after.Top10)</li>
            <li>@AiQualityViewModel.Compare("Rejected above the limit", before.RejectedAboveLimit, after.RejectedAboveLimit, lowerIsBetter: true)</li>
        </ul>
    }
</section>

<section class="mb-4">
    <h2 class="h5">Rationales</h2>
    @if (Model.Sample.Count == 0)
    {
        <p class="text-muted" id="no-rationales">No decided suggestions with a rationale yet.</p>
    }
    else
    {
        <p class="small text-muted">Grade how well each rationale explains the match, from 1 (wrong or useless) to 5 (clear and right). Leave a row empty to skip it.</p>
        <form asp-action="GradeRationales" method="post" id="grade-rationales">
            <table class="table table-sm align-middle">
                <thead><tr><th>Requirement</th><th>User story</th><th>Rationale</th><th>Grade</th></tr></thead>
                <tbody>
                    @foreach (var sample in Model.Sample)
                    {
                        <tr class="rationale-sample" data-code="@sample.RequirementCode">
                            <td class="text-nowrap">@sample.RequirementCode</td>
                            <td>@sample.Story</td>
                            <td class="small">@sample.Rationale <span class="text-muted">(@sample.Model)</span></td>
                            <td>
                                <select name="grade-@sample.SuggestionId" class="form-select form-select-sm" aria-label="Grade for @sample.RequirementCode">
                                    <option value="">–</option>
                                    @for (var grade = 1; grade <= 5; grade++)
                                    {
                                        <option value="@grade">@grade</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="btn btn-sm btn-outline-primary">Save grades</button>
        </form>
    }
</section>

<section>
    <h2 class="h5">Runs</h2>
    @if (Model.Runs.Count == 0)
    {
        <p class="text-muted" id="no-ai-runs">No runs yet.</p>
    }
    else
    {
        <table class="table table-sm" id="ai-runs">
            <thead><tr><th>When</th><th>Step</th><th>Model</th><th>Decisions</th><th>Top 1</th><th>Top 3</th><th>Top 10</th><th>Rejected above limit</th><th>Grade</th><th>By</th></tr></thead>
            <tbody>
                @foreach (var run in Model.Runs)
                {
                    <tr class="ai-run" data-step="@run.Step">
                        <td class="text-nowrap">@run.RunAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@run.Step</td>
                        <td class="run-model"><code>@run.Model</code> <span class="small text-muted">@run.PromptVersion</span></td>
                        <td class="run-decisions">@run.Decisions</td>
                        <td class="run-top1">@(run.Top1 is { } t1 ? $"{t1:0.#} %" : "")</td>
                        <td class="run-top3">@(run.Top3 is { } t3 ? $"{t3:0.#} %" : "")</td>
                        <td class="run-top10">@(run.Top10 is { } t10 ? $"{t10:0.#} %" : "")</td>
                        <td class="run-rejected-above">@(run.RejectedAboveLimit is { } ra ? $"{ra:0.#} %" : "")</td>
                        <td class="run-grade">@(run.AverageGrade is { } g ? $"{g:0.0#} of 5 ({run.Graded})" : "")</td>
                        <td class="small">@run.RunBy</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
