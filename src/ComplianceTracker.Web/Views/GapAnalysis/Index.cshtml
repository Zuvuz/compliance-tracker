@* US-188: the NIS2 gap analysis. 1: upload the customer's documents (a ZIP or several files). 2: the AI's suggestions per
   NIS2 requirement, with the sentence of the document that fits, to approve or reject. Nothing counts until approved.
   Ids and classes used by the tests: form#gap-upload, #gap-upload-result (#gap-upload-summary, rows with data-file and
   data-outcome), #gap-suggestions rows with data-requirement and data-document, .gap-quote, and the approve/reject forms. *@
@model ComplianceTracker.Web.Controllers.GapAnalysisViewModel
@{
    ViewData["Title"] = "NIS2 gap analysis";
}

<h1 class="h3">NIS2 gap analysis</h1>
<p class="text-muted">
    Upload the organisation's policies, procedures, reports and results. The AI suggests which NIS2 requirements each
    document covers and quotes the sentence that fits; nothing counts until a person approves it. Check first that NIS2
    applies, on the <a asp-controller="Organisation" asp-action="Index" asp-route-tab="nis2-scope">NIS2 scope</a> tab.
</p>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<section class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">1. Upload documents</h2>
        @if (Model.CanManage)
        {
            <form asp-action="Upload" method="post" enctype="multipart/form-data" id="gap-upload" class="d-flex flex-wrap gap-2 align-items-end" data-busy="Uploading and reading…">
                <div>
                    <label for="gap-files" class="form-label small mb-1">Files or a ZIP file (PDF, Word, Excel, text, SARIF, JSON, diagrams; at most 200 files)</label>
                    <input id="gap-files" name="files" type="file" multiple class="form-control form-control-sm" required />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Upload</button>
            </form>
        }
        else
        {
            <p class="small text-muted mb-0">Only those who manage frameworks can upload.</p>
        }

        @if (Model.LastUpload is { } upload)
        {
            <div id="gap-upload-result" class="mt-3">
                <p class="small fw-semibold mb-1" id="gap-upload-summary" role="status">@upload.Summary</p>
                <table class="table table-sm small mb-0">
                    <thead><tr><th>File</th><th>Result</th></tr></thead>
                    <tbody>
                        @foreach (var line in upload.Lines)
                        {
                            <tr data-file="@line.FileName" data-outcome="@line.Outcome" class="@(line.Outcome == "NotRead" ? "table-warning" : "")">
                                <td>@line.FileName</td>
                                <td>@line.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (upload.More > 0)
                {
                    <p class="small text-muted">and @upload.More more</p>
                }
            </div>
        }
    </div>
</section>

<section class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">2. The AI's suggestions</h2>
        @if (Model.Suggestions.Count == 0)
        {
            <p class="small text-muted mb-0" id="gap-no-suggestions">No suggestions wait for a decision. The coverage per requirement is on the organisation's
                <a asp-controller="Organisation" asp-action="Index" asp-route-tab="compliance">Compliance</a> tab.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle" id="gap-suggestions">
                    <thead><tr><th>Requirement</th><th>Document</th><th>Why</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var view in Model.Suggestions)
                        {
                            <tr data-requirement="@view.Suggestion.RequirementCode" data-document="@view.Document.Title">
                                <td><span class="fw-semibold">@view.Framework @view.Suggestion.RequirementCode</span><div class="small text-muted">@view.Title</div></td>
                                <td><a asp-controller="Documents" asp-action="File" asp-route-id="@view.Document.Id">@view.Document.Title</a>
                                    <div class="small text-muted">match @((int)Math.Round(view.Suggestion.Score * 100)) %</div></td>
                                <td class="small">
                                    @if (view.Suggestion.Quote is { } quote)
                                    {
                                        <q class="gap-quote">@quote</q>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No sentence fits; matched on the document as a whole</span>
                                    }
                                </td>
                                <td>
                                    @if (Model.CanManage)
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            <form asp-controller="Documents" asp-action="ApproveSuggestion" method="post" class="approve-gap-suggestion">
                                                <input type="hidden" name="suggestionId" value="@view.Suggestion.Id" />
                                                <input type="hidden" name="back" value="gap" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                            </form>
                                            <form asp-controller="Documents" asp-action="RejectSuggestion" method="post" class="d-flex flex-wrap gap-1 reject-gap-suggestion">
                                                <input type="hidden" name="suggestionId" value="@view.Suggestion.Id" />
                                                <input type="hidden" name="back" value="gap" />
                                                <select name="reason" class="form-select form-select-sm w-auto" aria-label="Reason for rejecting @view.Suggestion.RequirementCode">
                                                    <option value="">Reason…</option>
                                                    @foreach (var reason in Enum.GetValues<ComplianceTracker.Domain.Mappings.RejectionReason>())
                                                    {
                                                        <option value="@reason">@reason</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@* US-189: the questions for what the documents do not show. R2: a question covered by approved evidence is folded away;
   R4: "needs evidence" when the answer claims 3 or more without proof; R5: earlier answers are listed.
   Ids and classes used by the tests: #questions, .gap-question[data-code] (data-covered, data-open, data-needs-evidence),
   .gap-answer, .gap-earlier and form.answer-question. *@
@{
    var open = Model.Questions.Where(q => !q.CoveredByEvidence).ToList();
    var covered = Model.Questions.Where(q => q.CoveredByEvidence).ToList();
}
<section class="card mb-3" id="questions">
    <div class="card-body">
        <h2 class="h5 card-title">3. Questions for what the documents do not show</h2>
        <p class="small text-muted">@open.Count(q => q.IsOpen) of @open.Count questions are not answered yet. 0 none · 1 ad hoc · 2 defined · 3 implemented · 4 measured and improved.</p>
        @foreach (var question in open)
        {
            <div class="gap-question border-top pt-2 pb-2" data-code="@question.Code" data-covered="false" data-open="@(question.IsOpen ? "true" : "false")"
                 data-needs-evidence="@(question.NeedsEvidence ? "true" : "false")">
                <div class="fw-semibold">@question.Code</div>
                <div>@question.Question</div>
                @if (question.Answer is { } answer)
                {
                    <div class="small gap-answer">
                        Answer: <span class="fw-semibold">@ComplianceTracker.Domain.Organizations.Nis2Questions.Title(answer.Maturity)</span>
                        @if (answer.Comment is { } note) { <span>· @note</span> }
                        @if (question.NeedsEvidence) { <span class="badge text-bg-warning ms-1">Needs evidence</span> }
                    </div>
                }
                @if (Model.CanAnswer)
                {
                    <form asp-action="Answer" method="post" class="d-flex flex-wrap gap-1 mt-1 answer-question">
                        <input type="hidden" name="code" value="@question.Code" />
                        <select name="maturity" class="form-select form-select-sm w-auto" aria-label="Maturity for @question.Code" required>
                            <option value="">Maturity…</option>
                            @foreach (var maturity in Enum.GetValues<ComplianceTracker.Domain.Organizations.Maturity>())
                            {
                                <option value="@maturity" selected="@(question.Answer?.Maturity == maturity)">@ComplianceTracker.Domain.Organizations.Nis2Questions.Title(maturity)</option>
                            }
                        </select>
                        <input name="comment" maxlength="2000" class="form-control form-control-sm w-auto flex-grow-1" placeholder="What is in place (optional)" aria-label="Comment for @question.Code" value="@question.Answer?.Comment" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                }
                @if (question.Earlier.Count > 0)
                {
                    <details class="small mt-1 gap-earlier">
                        <summary>Earlier answers (@question.Earlier.Count)</summary>
                        <ul class="mb-0">
                            @foreach (var earlier in question.Earlier)
                            {
                                <li>@ComplianceTracker.Domain.Organizations.Nis2Questions.Title(earlier.Maturity), @earlier.AnsweredAt.ToString("dd-MM-yyyy HH:mm") @(earlier.Comment is { } c ? "· " + c : "")</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
        @if (covered.Count > 0)
        {
            <details class="mt-2" id="questions-covered">
                <summary class="small">Covered by approved evidence (@covered.Count)</summary>
                @foreach (var question in covered)
                {
                    <div class="gap-question small border-top pt-1" data-code="@question.Code" data-covered="true" data-open="false" data-needs-evidence="false">
                        <span class="fw-semibold">@question.Code</span> @question.Question
                        @if (question.Answer is { } answer)
                        {
                            <span class="gap-answer">· @ComplianceTracker.Domain.Organizations.Nis2Questions.Title(answer.Maturity)</span>
                        }
                    </div>
                }
            </details>
        }
    </div>
</section>

@* US-190: the status per measure, the action plan, and the locked reports. R5: a gap becomes a risk in the organisation
   area with one click (the risk form, filled in). Ids and classes used by the tests: #report, #gap-status rows with
   data-code (.gap-status, .gap-change), #gap-actions rows with data-code (.gap-priority, a.gap-make-risk), form#make-gap-report,
   #gap-reports rows with data-sha256. *@
<section class="card mb-3" id="report">
    <div class="card-body">
        <h2 class="h5 card-title">4. Gap report</h2>
        <div class="table-responsive">
            <table class="table table-sm align-middle small" id="gap-status">
                <thead><tr><th>Measure</th><th>Status</th><th>Maturity</th><th>Evidence</th><th>Since the last report</th></tr></thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr data-code="@line.Code">
                            <td><span class="fw-semibold">@line.Code</span></td>
                            <td><span class="gap-status badge @(line.Status switch { ComplianceTracker.Application.Organizations.GapStatus.Met => "text-bg-success", ComplianceTracker.Application.Organizations.GapStatus.PartlyMet => "text-bg-warning", _ => "text-bg-danger" })">@ComplianceTracker.Application.Organizations.Nis2GapReport.Text(line.Status)</span></td>
                            <td>@(line.Maturity is { } m ? ComplianceTracker.Domain.Organizations.Nis2Questions.Title(m) : "Not answered")</td>
                            <td>@string.Join("; ", line.Evidence)</td>
                            <td class="gap-change">@line.Change</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{ var gaps = Model.Lines.Where(l => l.IsGap).OrderBy(l => l.Priority).ThenBy(l => l.Code, StringComparer.Ordinal).ToList(); }
        <h3 class="h6 mt-3">Action plan (@gaps.Count)</h3>
        @if (gaps.Count == 0)
        {
            <p class="small text-muted">No gaps.</p>
        }
        else
        {
            <table class="table table-sm align-middle small" id="gap-actions">
                <thead><tr><th>Priority</th><th>Measure</th><th>Action</th><th></th></tr></thead>
                <tbody>
                    @foreach (var line in gaps)
                    {
                        <tr data-code="@line.Code">
                            <td class="gap-priority">@line.Priority</td>
                            <td>@line.Code</td>
                            <td>@line.Action</td>
                            <td>
                                @if (Model.CanAddRisks)
                                {
                                    <a class="gap-make-risk btn btn-sm btn-outline-secondary" asp-controller="Risks" asp-action="Add" asp-route-projectId="@Model.AreaId"
                                       asp-route-title="@($"NIS2 {line.Code}: {line.Action}")" asp-route-description="@($"Gap from the NIS2 gap analysis: {line.Question}")">Make it a risk</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <form asp-action="Report" method="post" id="make-gap-report" class="mt-2">
            <button type="submit" class="btn btn-sm btn-primary">Make the gap report (PDF, locked)</button>
            <span class="small text-muted ms-1">Management approves it by signing the field on the first page (NIS2 Art. 20(1)).</span>
        </form>

        @if (Model.Reports.Count > 0)
        {
            <table class="table table-sm small mt-3" id="gap-reports">
                <thead><tr><th>Report</th><th>Made</th><th>SHA-256</th></tr></thead>
                <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        <tr data-sha256="@report.Sha256">
                            <td><a asp-controller="Projects" asp-action="LockedReport" asp-route-id="@Model.AreaId" asp-route-snapshotId="@report.Id">@report.Title</a></td>
                            <td>@report.LockedAt.ToString("dd-MM-yyyy HH:mm")</td>
                            <td><code class="text-break">@report.Sha256</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
