@* The signed-in user's own organisation: the Overview tab (US-003 R2, US-004 R5).
   The ids (#organisation-name, #organisation-projects ...) are used by the tests. *@
@using ComplianceTracker.Domain.Organizations
@model Organization
@{
    ViewData["Title"] = Model.Name;
    ViewData["ActiveTab"] = "Overview";
}

<partial name="_OrganizationHeader" model="Model" />

@* The organisation's running projects will be listed here when the project story (US-008) is built *@
<section id="organisation-projects">
    <h2 class="h4">Projects</h2>
    <p class="text-muted">No projects yet. The organisation's projects will be shown here.</p>
</section>
