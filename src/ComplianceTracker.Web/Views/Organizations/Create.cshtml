@* US-003/US-004: the form for creating the organisation. The creator is the signed-in user, so there is no name field. *@
@using ComplianceTracker.Domain.Organizations
@model CreateOrganizationViewModel
@{
    ViewData["Title"] = "Create organisation";

    // US-003 R4: only the values the system knows. The value is the enum name, e.g. "Manufacturing".
    var sectors = Enum.GetNames<Sector>().Select(s => new SelectListItem(s, s));
    var sizes = Enum.GetNames<OrganizationSize>().Select(s => new SelectListItem(s, s));
}

<h1>Create organisation</h1>

<div class="row">
    <div class="col-md-6">
        @* The form tag helper adds the antiforgery token automatically (US-003 R5) *@
        <form asp-action="Create" method="post">
            @* Shows the domain's error messages, e.g. "CVR must be 8 digits" *@
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            @* asp-for fills in the label, the field name and the value the user typed (kept after an error) *@
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Cvr" class="form-label"></label>
                <input asp-for="Cvr" class="form-control" inputmode="numeric" />
            </div>

            <div class="mb-3">
                <label asp-for="Sector" class="form-label"></label>
                <select asp-for="Sector" asp-items="sectors" class="form-select">
                    <option value="">-- Choose sector --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Size" class="form-label"></label>
                <select asp-for="Size" asp-items="sizes" class="form-select">
                    <option value="">-- Choose size --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
</div>
