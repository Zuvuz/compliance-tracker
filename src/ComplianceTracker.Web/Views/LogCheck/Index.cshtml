@* US-091 R3: the result of checking the organisation's chain of log entries.
   Ids used by the tests: #log-check-result (with data-intact), #log-check-broken. *@
@model ComplianceTracker.Domain.ActivityLog.ChainCheck
@{
    var organization = (ComplianceTracker.Domain.Organizations.Organization)ViewData["Organization"]!;
}

<partial name="_OrganizationHeader" model="organization" />

<p class="mb-1"><a asp-controller="Activity" asp-action="Index" id="back-to-activity">← Activity</a></p>
<h1 class="h4">Verify log integrity</h1>
<p class="small text-muted" id="fingerprint-explained">
    A fingerprint is a short code calculated from an entry's content and the fingerprint of the entry before it, so the
    entries form a chain: a changed, removed or added entry breaks the chain from that point. Entries from before
    fingerprints were added (US-091) have none, but the database still refuses to change or delete them.
</p>

@if (Model.IsIntact)
{
    <div class="alert alert-success" id="log-check-result" data-intact="true">
        @(Model.WithoutFingerprint > 0
            ? $"The log is intact ({Model.Checked} entries); {Model.WithoutFingerprint} older entries from before the fingerprints have no fingerprint"
            : $"The log is intact ({Model.Checked} entries)")
    </div>
}
else
{
    var broken = Model.FirstBroken!;
    <div class="alert alert-danger" id="log-check-result" data-intact="false">
        <span id="log-check-broken">The log is broken at the entry of @broken.OccurredAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
        (@broken.Action). @Model.Checked entries before it are intact.
    </div>
}
