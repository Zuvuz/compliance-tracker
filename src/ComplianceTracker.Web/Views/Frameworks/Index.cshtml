@* US-005: the organisation's frameworks. The form adds a new framework; each row shows the current version.
   The ids and classes (#frameworks, data-framework-id, framework-name, open-pdf ...) are used by the tests. *@
@model FrameworksPageViewModel
@{
    ViewData["Title"] = "Frameworks";
}

<h1>Frameworks</h1>
<p>The standards and policies @Model.Organization.Name follows. Upload each as a PDF of at most 20 MB.</p>
<p><a id="built-in-link" asp-action="BuiltIn">Built-in frameworks (CRA, AI Act)</a> can be switched on without uploading anything.</p>

@* Shows the domain's error messages, e.g. "Only PDF files are allowed" *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@* enctype="multipart/form-data" is required to send a file. The form tag helper adds the antiforgery token. *@
<form asp-action="Add" method="post" enctype="multipart/form-data" class="row g-2 mb-4">
    <div class="col-md-5">
        <label for="name" class="form-label">Framework</label>
        <input id="name" name="name" class="form-control" placeholder="e.g. ISO/IEC 27001 or Security policy" />
    </div>
    <div class="col-md-5">
        <label for="file" class="form-label">PDF file</label>
        @* accept only filters the file picker; the server still checks the file *@
        <input id="file" name="file" type="file" accept=".pdf,application/pdf" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Add</button>
    </div>
</form>

<table class="table" id="frameworks">
    <thead>
        <tr>
            <th>Framework</th>
            <th>Source</th>
            <th>Version</th>
            <th>File</th>
            <th>Uploaded</th>
            <th>Uploaded by</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var framework in Model.Frameworks)
        {
            @* The newest version is the one that applies (R3) *@
            var current = framework.CurrentVersion;
            <tr data-framework-id="@framework.Id">
                <td class="framework-name">@framework.Name</td>
                <td class="framework-source">@(framework.IsBuiltIn ? "Built-in" : "Uploaded")</td>
                <td class="framework-version">@current.Number</td>
                @if (framework.IsBuiltIn)
                {
                    @* Built-in (US-006): no file and no uploader, a link to the official text instead *@
                    <td class="framework-file">–</td>
                    <td>@current.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>–</td>
                    <td>
                        <a href="@current.SourceReference" target="_blank" rel="noopener noreferrer">Official text (EUR-Lex)</a>
                        · <a asp-action="BuiltIn">Switch off</a>
                    </td>
                }
                else
                {
                    <td class="framework-file">@current.FileName</td>
                    @* Stored in UTC, shown in local time *@
                    <td>@current.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@Model.UploadedBy(current)</td>
                    <td>
                        <a class="open-pdf" asp-action="Document" asp-route-id="@current.Id">Open PDF</a>
                        · <a asp-action="Versions" asp-route-id="@framework.Id">All versions</a>
                        @* One small upload form per row, so you never have to type the framework name again *@
                        <form asp-action="UploadVersion" method="post" enctype="multipart/form-data" class="mt-1">
                            <input type="hidden" name="frameworkId" value="@framework.Id" />
                            <div class="d-flex gap-1">
                                <input name="file" type="file" accept=".pdf,application/pdf" class="form-control form-control-sm" />
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Upload new version</button>
                            </div>
                            @* US-011 R4: tick the projects that move to the new version; the others keep theirs *@
                            @foreach (var project in Model.ProjectsUsing(framework))
                            {
                                var id = $"move-{framework.Id}-{project.Id}";
                                <div class="form-check form-check-inline small">
                                    <input class="form-check-input move-project" type="checkbox" name="projectIds" id="@id"
                                           value="@project.Id" data-project-name="@project.Name" />
                                    <label class="form-check-label" for="@id">Move @project.Name</label>
                                </div>
                            }
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
