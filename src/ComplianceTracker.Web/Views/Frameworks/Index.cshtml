@* US-005: the organisation's frameworks. The form adds a new framework; each row shows the newest version.
   US-007: a new version is a draft until it is activated; the row then links to the draft.
   The ids and classes (#frameworks, data-framework-id, framework-name, framework-status, open-pdf ...) are used by the tests. *@
@model FrameworksPageViewModel
@{
    ViewData["Title"] = "Frameworks";
    var canManage = await Permissions.CanAsync(Permission.ManageFrameworks); // #52: rename and remove
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1>Frameworks</h1>
    @* US-037 *@
    <a asp-action="CrossMapping" class="btn btn-sm btn-outline-secondary" id="cross-mapping-link">Cross-mapping between frameworks</a>
</div>
<p>The standards and policies @Model.Organization.Name follows. Upload each as a PDF, Word, Excel, CSV or HTML file of at most 20 MB.</p>
<p><a id="built-in-link" asp-action="BuiltIn">Built-in frameworks (CRA, NIS2, AI Act)</a> can be switched on without uploading anything.</p>

@* Shows the domain's error messages, e.g. "Only PDF, Word (.docx), Excel (.xlsx), CSV or HTML files are allowed" *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@* enctype="multipart/form-data" is required to send a file. The form tag helper adds the antiforgery token. *@
@if (await Permissions.CanAsync(Permission.ManageFrameworks))
{
    <form asp-action="Add" method="post" enctype="multipart/form-data" class="row g-2 mb-4" data-busy="Uploading…">
        <div class="col-md-5">
            <label for="name" class="form-label">Framework</label>
            <input id="name" name="name" class="form-control" placeholder="e.g. ISO/IEC 27001 or Security policy" />
        </div>
        <div class="col-md-3">
            <label for="file" class="form-label">File (PDF, Word, Excel, CSV or HTML)</label>
            @* accept only filters the file picker; the server still checks the file *@
            <input id="file" name="file" type="file" accept=".pdf,.docx,.xlsx,.csv,.html,.htm,application/pdf" class="form-control" />
        </div>
        <div class="col-md-2">
            @* US-035: optional; without a date the version applies as soon as it is activated *@
            <label for="appliesFrom" class="form-label">Applies from</label>
            <input id="appliesFrom" name="appliesFrom" type="date" class="form-control" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Add</button>
        </div>
    </form>

    @* US-137 R1: an EU act from its official structured text on EUR-Lex, by its CELEX number *@
    <details class="mb-4" id="import-eur-lex">
        <summary>Import an EU act from EUR-Lex</summary>
        <form asp-action="ImportFromEurLex" method="post" class="row g-2 mt-1">
            <div class="col-md-5">
                <label for="eurlex-name" class="form-label">Framework</label>
                <input id="eurlex-name" name="name" class="form-control" placeholder="e.g. GDPR" />
            </div>
            <div class="col-md-3">
                <label for="celex" class="form-label">CELEX number</label>
                <input id="celex" name="celex" class="form-control" placeholder="e.g. 32024R2847 for the CRA" />
            </div>
            <div class="col-md-2">
                <label for="eurlex-applies-from" class="form-label">Applies from</label>
                <input id="eurlex-applies-from" name="appliesFrom" type="date" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">Import</button>
            </div>
        </form>
    </details>
}

@* #52: a wide table scrolls inside itself, not the page (US-167) *@
<div class="table-responsive">
<table class="table" id="frameworks">
    <thead>
        <tr>
            <th>Framework</th>
            <th>Source</th>
            <th>Version</th>
            <th>File</th>
            <th>Uploaded</th>
            <th>Uploaded by</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var framework in Model.Frameworks)
        {
            @* The newest upload, which may still be a draft (US-007) *@
            var current = framework.LatestVersion;
            <tr data-framework-id="@framework.Id">
                <td>
                    <span class="framework-name">@framework.Name</span>
                    @if (!framework.IsBuiltIn)
                    {
                        @* #52: the name gives the test tags (the part before " – ") *@
                        <div class="small text-muted framework-tags">Test tags: <code>@@@ComplianceTracker.Application.Frameworks.FrameworkSlugs.Slug(framework.Name)-…</code></div>
                    }
                </td>
                <td class="framework-source">
                    @(framework.IsBuiltIn ? "Built-in" : "Uploaded")
                    @* US-142 R2 *@
                    @if (framework.Level == ComplianceTracker.Domain.Frameworks.FrameworkLevel.Organisation)
                    {
                        <span class="badge text-bg-info framework-level" title="Followed by the whole organisation, under Organisation">Organisation</span>
                    }
                </td>
                <td>
                    <span class="framework-version">@current.Number</span>
                    @if (current.IsUpcomingOn(Model.Today) && framework.CurrentVersion(Model.Today) != current)
                    {
                        @* US-035 R3 *@
                        <span class="framework-status badge text-bg-info">Upcoming (applies from @current.AppliesFrom!.Value.ToString("dd-MM-yyyy"))</span>
                    }
                    else if (current.IsActive)
                    {
                        <span class="framework-status badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="framework-status badge text-bg-warning">Draft</span>
                    }
                </td>
                @if (framework.IsBuiltIn)
                {
                    @* Built-in (US-006): no file and no uploader, a link to the official text instead *@
                    <td class="framework-file">–</td>
                    <td>@current.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy")</td>
                    <td>–</td>
                    <td>
                        <a href="@current.SourceReference" target="_blank" rel="noopener noreferrer">Official text (EUR-Lex)</a>
                        · <a asp-action="BuiltIn">Switch off</a>
                    </td>
                }
                else
                {
                    <td class="framework-file">@current.FileName</td>
                    @* Stored in UTC, shown in local time *@
                    <td>@current.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@Model.UploadedBy(current)</td>
                    <td>
                        <a class="open-pdf" asp-action="Document" asp-route-id="@current.Id">Download the file</a>
                        · <a class="version-link" asp-action="Version" asp-route-id="@current.Id">@(current.IsActive ? "Requirements" : "Review draft")</a>
                        · <a asp-action="Versions" asp-route-id="@framework.Id">All versions</a>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            @* One small upload form per row, so you never have to type the framework name again. #52: in the shared
                               dialog, so the row is not wider than the window. *@
                            <details class="upload-version-menu" data-dialog-title="Upload a new version of @framework.Name">
                                <summary class="btn btn-sm btn-outline-primary">Upload new version…</summary>
                                <form asp-action="UploadVersion" method="post" enctype="multipart/form-data" class="mt-1" data-busy="Uploading…">
                                    <input type="hidden" name="frameworkId" value="@framework.Id" />
                                    <div class="d-flex flex-wrap gap-1">
                                        <input name="file" type="file" accept=".pdf,.docx,.xlsx,.csv,.html,.htm,application/pdf" class="form-control form-control-sm" aria-label="New version of @framework.Name" />
                                        <input name="appliesFrom" type="date" class="form-control form-control-sm ct-max-w-10"
                                               title="Applies from (optional)" aria-label="Applies from" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Upload new version</button>
                                    </div>
                                </form>
                            </details>
                            @if (canManage)
                            {
                                @* #52: a name typed wrong is fixed; a framework no project uses is removed (hidden, kept for the history) *@
                                <details class="rename-framework-menu" data-dialog-title="Rename @framework.Name">
                                    <summary class="btn btn-sm btn-outline-secondary">Rename…</summary>
                                    <form asp-action="Rename" method="post" class="rename-framework mt-1">
                                        <input type="hidden" name="frameworkId" value="@framework.Id" />
                                        <label class="form-label small" for="rename-@framework.Id">New name</label>
                                        <input id="rename-@framework.Id" name="name" value="@framework.Name" maxlength="@ComplianceTracker.Domain.Frameworks.Framework.MaxNameLength" class="form-control form-control-sm mb-1" required />
                                        <p class="small text-muted mb-1">The part before " – " gives the test tags, e.g. "ISO27001 – Demo" gives <code>@@iso27001-A.8.28</code>.</p>
                                        <button type="submit" class="btn btn-sm btn-primary">Rename</button>
                                    </form>
                                </details>
                                <form asp-action="Remove" method="post" class="remove-framework" data-confirm-final="true"
                                      data-confirm="@framework.Name is removed from the list. It is kept for the history and can only be removed when no project uses it.">
                                    <input type="hidden" name="frameworkId" value="@framework.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>
