@* US-005: every version of one framework, newest first. Earlier versions can still be opened (R3). *@
@model FrameworkVersionsViewModel
@{
    ViewData["Title"] = Model.Framework.Name;
}

<h1>@Model.Framework.Name</h1>
<p><a asp-action="Index">Back to frameworks</a></p>

<table class="table" id="versions">
    <thead>
        <tr>
            <th>Version</th>
            <th>Status</th>
            <th>File</th>
            <th>Uploaded</th>
            <th>Uploaded by</th>
            <th>SHA-256</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var version in Model.Framework.Versions.OrderByDescending(v => v.Number))
        {
            <tr>
                <td class="framework-version">@version.Number</td>
                <td class="framework-status">@version.Status@(Model.Framework.CurrentVersion?.Id == version.Id ? " (current)" : "")</td>
                <td>@version.FileName</td>
                <td>@version.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                <td>@Model.UploadedBy(version)</td>
                @* Fingerprint of the PDF: an auditor can recalculate it to prove the file has not changed *@
                <td><code class="small">@version.Sha256</code></td>
                <td>
                    <a class="open-pdf" asp-action="Document" asp-route-id="@version.Id">Open PDF</a>
                    · <a class="version-link" asp-action="Version" asp-route-id="@version.Id">Requirements</a>
                </td>
            </tr>
        }
    </tbody>
</table>
