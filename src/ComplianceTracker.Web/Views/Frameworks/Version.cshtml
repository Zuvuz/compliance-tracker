@* US-007: one framework version and its requirements.
   A draft can be corrected (change, delete, add by hand) and then activated, which locks it.
   The ids and classes (#version-status, #requirements, data-requirement-code, requirement-code,
   requirement-title, #add-requirement, #activate-version, #no-requirements) are used by the tests. *@
@model FrameworkVersionPageViewModel
@{
    var framework = Model.Framework;
    var version = Model.Version;
    ViewData["Title"] = $"{framework.Name} version {version.Number}";
}

@if (framework.IsBuiltIn)
{
    @* US-043: built-in regulations can be read here, but not changed *@
    <p class="mb-1"><a asp-action="BuiltIn">← Built-in frameworks</a></p>
}
else
{
    <p class="mb-1"><a asp-action="Versions" asp-route-id="@framework.Id">← All versions of @framework.Name</a></p>
}
<h1 class="mb-0">@framework.Name <small class="text-muted">version @version.Number</small></h1>
<p class="small mb-3">
    Status: <span id="version-status">@version.Status</span>
    @if (version.AppliesFrom is { } appliesFrom)
    {
        @* US-035 *@
        <text>· Applies from <span id="version-applies-from">@appliesFrom.ToString("dd-MM-yyyy")</span></text>
        @if (version.IsUpcomingOn(Model.Today) && !Model.IsCurrent)
        {
            <span class="badge text-bg-info ms-1" id="version-upcoming">upcoming</span>
        }
    }
    @if (Model.IsCurrent)
    {
        <span class="badge text-bg-success ms-1" id="version-current">current</span>
    }
    · Uploaded @version.UploadedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm") by @Model.NameOf(version.UploadedById)
    @if (version.ActivatedAt is { } activatedAt)
    {
        <text>· Activated @activatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm") by @Model.NameOf(version.ActivatedById)</text>
    }
    @if (framework.IsBuiltIn)
    {
        <text>· <a href="@version.SourceReference" target="_blank" rel="noopener noreferrer">Official text (EUR-Lex)</a></text>
    }
    else
    {
        <text>· <a class="open-pdf" asp-action="Document" asp-route-id="@version.Id">@(version.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "Open PDF" : "Download the file")</a></text>
    }
</p>

@* Shows the domain's error messages, e.g. "Requirement A.5.15 is already in the list" *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (!version.IsActive)
{
    <div class="alert alert-warning">
        This version is a draft. Check the requirements found in the file, correct them, and activate the version.
        Projects can only use active versions, and an active version can no longer be changed.
    </div>
}

@if (!version.IsActive && Model.Columns is { Count: > 0 } headers)
{
    @* US-143 R7: which columns of the Excel or CSV file hold the code, the title and the text *@
    var chosen = Model.Chosen;
    <form asp-action="ChooseColumns" method="post" class="border rounded p-3 mb-3" id="choose-columns">
        <input type="hidden" name="versionId" value="@version.Id" />
        <p class="mb-2">Choose which columns hold each requirement's code, title and text. The choice is remembered for the next version.</p>
        <div class="row g-2">
            @foreach (var (name, label, current, optional) in new (string, string, string?, bool)[]
            {
                ("code", "Code", chosen?.Code, false), ("title", "Title", chosen?.Title, false), ("text", "Text", chosen?.Text, false),
                ("parent", "Parent code (optional)", chosen?.Parent, true), ("kind", "Kind (optional)", chosen?.Kind, true)
            })
            {
                <div class="col-md-2">
                    <label class="form-label small" for="column-@name">@label</label>
                    <select class="form-select form-select-sm" id="column-@name" name="@name">
                        @if (optional)
                        {
                            <option value="">(none)</option>
                        }
                        @foreach (var header in headers)
                        {
                            <option value="@header" selected="@(string.Equals(header, current, StringComparison.OrdinalIgnoreCase))">@header</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary">Read the requirements</button>
            </div>
        </div>
    </form>
}

@if (version.Requirements.Count == 0)
{
    @* R5: e.g. a scanned PDF without text *@
    <p class="text-muted" id="no-requirements">No requirements found.@(version.IsActive ? "" : " Add them by hand below.")</p>
}
else
{
    <table class="table table-sm align-middle" id="requirements">
        <thead>
            <tr>
                <th class="ct-w-10">Code</th>
                <th>Title</th>
                <th>Description</th>
                <th>Kind</th>
                @if (!version.IsActive)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var requirement in version.Requirements)
            {
                <tr data-requirement-code="@requirement.Code" data-requirement-id="@requirement.Id">
                    @if (version.IsActive)
                    {
                        @* R3: locked, so only shown *@
                        <td class="requirement-code tree-depth-@(Math.Min(Model.Depth(requirement), 6))">@requirement.Code</td>
                        <td class="requirement-title">@requirement.Title</td>
                        <td class="requirement-description small">@requirement.Description</td>
                        <td class="requirement-kind small">@requirement.Kind</td>
                    }
                    else
                    {
                        @* R2: one small form per row. The inputs use the form attribute, so the table stays valid HTML. *@
                        var formId = $"change-{requirement.Id}";
                        <td class="tree-depth-@(Math.Min(Model.Depth(requirement), 6))">
                            <input form="@formId" name="code" value="@requirement.Code" class="form-control form-control-sm requirement-code" aria-label="Code" />
                            @if (Model.ParentCode(requirement) is { } parentCode)
                            {
                                <div class="small text-muted requirement-parent">Under @parentCode</div>
                            }
                        </td>
                        <td><input form="@formId" name="title" value="@requirement.Title" class="form-control form-control-sm requirement-title" aria-label="Title" /></td>
                        <td><textarea form="@formId" name="description" rows="1" class="form-control form-control-sm" aria-label="Description">@requirement.Description</textarea></td>
                        <td>
                            @* US-143 R5: the kind can be changed while the version is a draft *@
                            <form asp-action="ChangeKind" method="post" class="d-flex gap-1 change-kind">
                                <input type="hidden" name="versionId" value="@version.Id" />
                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                <select name="kind" class="form-select form-select-sm requirement-kind" aria-label="Kind">
                                    @foreach (var kind in Enum.GetValues<ComplianceTracker.Domain.Frameworks.RequirementKind>())
                                    {
                                        <option value="@kind" selected="@(kind == requirement.Kind)">@kind</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                            </form>
                        </td>
                        <td class="text-nowrap">
                            <form id="@formId" asp-action="ChangeRequirement" method="post" class="d-inline">
                                <input type="hidden" name="versionId" value="@version.Id" />
                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                @* US-092: the version the row was shown with *@
                                <input type="hidden" name="rowVersion" value="@requirement.Version" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                            </form>
                            <form asp-action="RemoveRequirement" method="post" data-confirm="The requirement is removed from this draft version." class="d-inline">
                                <input type="hidden" name="versionId" value="@version.Id" />
                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@if (!version.IsActive && version.Extraction is { } extraction)
{
    @* US-070: what the extraction did not use, less what has been added by hand since (R6) *@
    var check = extraction.Without(version.Requirements.Select(r => (r.Code, r.Title, (string?)r.Description)));
    <section class="mb-4 border rounded p-3" id="extraction-check">
        <h2 class="h5">Extraction check</h2>
        <p class="mb-2" id="extraction-numbers">@check.RequirementsFound requirements found · @check.PagesWithoutRequirements of @check.PagesWithText pages gave none · @check.CoveredPercent % of the text is part of a requirement or recognised as not one</p>
        @if (check.NeedsWarning)
        {
            @* R4 *@
            <div class="alert alert-warning py-2" id="extraction-warning" role="status">Check the extraction: @check.PercentWithoutRequirements % of the pages gave no requirements</div>
        }
        @if (check.PossiblyMissing.Count > 0 || check.FoundTwice.Count > 0 || check.NotFoundFromContents.Count > 0)
        {
            @* R8, R9 *@
            <ul class="mb-2" id="extraction-numbering">
                @foreach (var missing in check.PossiblyMissing)
                {
                    <li class="possibly-missing">@missing</li>
                }
                @foreach (var twice in check.FoundTwice)
                {
                    <li class="found-twice">@twice is found twice; the one with the most text is kept</li>
                }
                @foreach (var code in check.NotFoundFromContents)
                {
                    <li class="not-found-from-contents">@code is in the table of contents but was not found</li>
                }
            </ul>
        }
        @if (check.ShallSentences.Count > 0)
        {
            @* R10 *@
            <h3 class="h6 mt-3">Possible missed requirements</h3>
            <ul class="small mb-2" id="extraction-shall">
                @foreach (var sentence in check.ShallSentences)
                {
                    <li class="shall-sentence" data-page="@sentence.Page"><span class="text-muted">Page @sentence.Page:</span> @sentence.Text</li>
                }
            </ul>
        }
        @if (check.LeftOver.Count > 0)
        {
            @* R2, R3 *@
            <h3 class="h6 mt-3">Text that did not become a requirement</h3>
            <ul class="small mb-0" id="extraction-left-over">
                @foreach (var block in check.LeftOver)
                {
                    <li class="left-over" data-page="@block.Page"><span class="text-muted">Page @block.Page:</span> @block.Text</li>
                }
            </ul>
        }
        else
        {
            <p class="text-success small mb-0" id="extraction-complete">All text is part of a requirement or recognised as not one.</p>
        }
    </section>
}

@if (!version.IsActive)
{
    @* R2, R5: add a requirement by hand *@
    <form asp-action="AddRequirement" method="post" class="row g-2 mb-4" id="add-requirement">
        <input type="hidden" name="versionId" value="@version.Id" />
        <div class="col-md-2"><input name="code" class="form-control" placeholder="Code, e.g. A.5.15" aria-label="Code" /></div>
        <div class="col-md-4"><input name="title" class="form-control" placeholder="Title" aria-label="Title" /></div>
        <div class="col-md-4"><input name="description" class="form-control" placeholder="Description (optional)" aria-label="Description" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Add requirement</button></div>
    </form>

    @* US-035 R1, R2: the day the version starts to apply; empty = as soon as it is activated *@
    <form asp-action="SetAppliesFrom" method="post" class="d-flex align-items-center gap-2 mb-3" id="set-applies-from">
        <input type="hidden" name="versionId" value="@version.Id" />
        <label for="appliesFrom" class="small text-nowrap">Applies from</label>
        <input id="appliesFrom" name="appliesFrom" type="date" class="form-control form-control-sm ct-max-w-11"
               value="@version.AppliesFrom?.ToString("yyyy-MM-dd")" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Save date</button>
    </form>

    @* R3, R4: locks the version; it then becomes the current version (US-035: from its start date) *@
    <form asp-action="Activate" method="post" id="activate-version">
        <input type="hidden" name="versionId" value="@version.Id" />
        <button type="submit" class="btn btn-success">Activate version @version.Number</button>
        <span class="text-muted small ms-2">The requirements can no longer be changed afterwards.</span>
    </form>
}
