@* US-024: the form for editing a project's details. Same rules as creating (US-008 R2).
   The lifecycle phase is changed on the project page, not here. *@
@model EditProjectViewModel
@{
    ViewData["Title"] = "Edit project";
}

<h1>Edit project</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post" id="edit-project">
            @* Shows the domain's error messages, e.g. "Project name already in use" *@
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="IntendedPurpose" class="form-label"></label>
                <textarea asp-for="IntendedPurpose" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Scope" class="form-label"></label>
                <textarea asp-for="Scope" class="form-control" rows="2"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
