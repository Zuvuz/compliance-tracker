@* US-019, US-021, US-041, US-044: the project's requirements per regulation, what covers them, the AI's suggestions and the coverage.
   One sub-tab per framework the project follows, each with its own address (/Projects/Details/{id}/compliance/{slug}).
   Ids and classes used by the tests: #compliance-tabs (links data-sub), #coverage, #requirement-search,
   #requirements-table rows requirement-row (data-code) with requirement-status and linked-story, link-requirement forms,
   unlink-requirement forms, #no-requirements, #no-frameworks-compliance.
   US-043: group header rows .requirement-group, .official-text links, .not-applicable-reason, and the forms
   .mark-not-applicable and .mark-applicable.
   US-044: #compliance-summary with #summary-covered, #summary-total, #summary-not-covered, #summary-suggestions,
   #summary-not-applicable and #coverage-bar; #compliance-filters links (data-filter); form #suggest-not-covered;
   per row .ai-suggestion (data-story) with .suggestion-story, .suggestion-score, .suggestion-rationale and the forms
   .approve-suggestion and .reject-suggestion (reason, comment).
   US-057: #summary-evidence; per row .evidence (data-title) with .evidence-title, .evidence-sha256, .evidence-expired and
   form .remove-evidence; form .add-evidence (title, url, file, validUntil); .evidence-status "No evidence".
   US-052, US-120: form #traceability-download (audience, format, sub) with #download-traceability.
   US-124: per row .requirement-risks with a.requirement-risk.
   US-060, US-061: form #suggest-not-applicable; per row .high-risk, .applicability-suggestion with .applicability-reason,
   .applicability-context and the forms .accept-applicability (reason) and .reject-applicability; .suggestion-context
   under a rationale; .old-classification with the form .keep-not-applicable.
   US-110: per row .needs-review with .previous-text and the form .confirm-review; links and evidence that wait for
   review have .review-pending.
   US-144: the rows are Views/Projects/_RequirementRow.cshtml; the "All" sub-tab (data-sub="all") groups every framework
   (.framework-group rows); #fold-all and #open-all; #unused-frameworks with forms .add-unused-framework. *@
@model ProjectDetailsViewModel
@using ComplianceTracker.Application.Compliance
@{
    var project = Model.Project;
    var compliance = Model.Compliance;
    // US-144 R13: "all" shows every framework the project uses
    var all = Model.Sub == ComplianceFilters.AllSub && Model.Compliance is { Frameworks.Count: > 1 };
    var active = all ? null : Model.ActiveCompliance;
    var activeSlug = all ? ComplianceFilters.AllSub : active is null ? null : FrameworkNames.Slug(active.Framework.Name);
    var canLink = await Permissions.CanAsync(Permission.LinkWork);
    var canDecide = await Permissions.CanAsync(Permission.DecideCompliance);
    var filter = Model.ComplianceFilter;
    var showFilter = filter == ComplianceFilters.All ? null : filter;
    string NameOf(Guid userId) => Model.Organization?.Users.FirstOrDefault(u => u.Id == userId)?.Name ?? "Unknown";
}

<section id="project-compliance">
    @if (compliance is null || compliance.Frameworks.Count == 0)
    {
        @* US-041 R8 *@
        <p class="text-muted" id="no-frameworks-compliance">
            No frameworks yet. <a asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Frameworks">Add one on the Frameworks tab</a>.
        </p>
        return;
    }

    @* US-041 R2: one sub-tab per framework, alphabetical; US-144 R13: "All" when there is more than one *@
    <ul class="nav nav-pills mb-3" id="compliance-tabs">
        @foreach (var tab in compliance.Frameworks)
        {
            var slug = FrameworkNames.Slug(tab.Framework.Name);
            <li class="nav-item">
                <a class="nav-link @(slug == activeSlug ? "active" : "")" data-sub="@slug"
                   asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Compliance" asp-route-sub="@slug">@FrameworkNames.Short(tab.Framework.Name)</a>
            </li>
        }
        @if (compliance.Frameworks.Count > 1)
        {
            <li class="nav-item">
                <a class="nav-link @(all ? "active" : "")" data-sub="@ComplianceFilters.AllSub"
                   asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Compliance" asp-route-sub="@ComplianceFilters.AllSub">All</a>
            </li>
        }
    </ul>

    @{
        var shownFrameworks = all ? compliance.Frameworks.ToList() : [active!];
        var openStories = compliance.WorkItems
            .Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed)
            .OrderBy(w => w.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var projectRisks = Model.AllRisks.Where(r => r.Status != ComplianceTracker.Domain.Risks.RiskStatus.Closed).ToList();
        IEnumerable<RequirementCoverage> Shown(FrameworkCompliance f)
        {
            var rows = f.Requirements.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                var term = Model.Search.Trim();
                rows = rows.Where(r => r.Requirement.Code.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || r.Requirement.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || r.Requirement.Description.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return rows.Where(r => ComplianceFilters.Matches(filter, r));
        }

        // R13: the counts add up across the frameworks shown
        var covered = shownFrameworks.Sum(f => f.Covered);
        var total = shownFrameworks.Sum(f => f.Total);
        var percent = total == 0 ? 0 : (int)Math.Round(100.0 * covered / total, MidpointRounding.AwayFromZero);
        var anyRequirements = shownFrameworks.Any(f => f.Requirements.Count > 0);
        var hasTranslations = Model.Language == ComplianceTracker.Domain.Frameworks.Requirement.DefaultLanguage
            || shownFrameworks.SelectMany(f => f.Requirements).Any(r => r.Requirement.TextIn(Model.Language) is not null);
        var shownCount = shownFrameworks.Sum(f => Shown(f).Count());
    }

    @* US-041 R4, R7 / US-021 R4 *@
    <p class="mb-2">
        @if (all)
        {
            <span class="fw-semibold">All regulations</span><text>: </text>
            <span id="coverage">@covered of @total requirements covered (@percent %)</span>
        }
        else
        {
            var framework = active!;
            var current = framework.Framework.CurrentVersion(Model.Today);
            <span class="fw-semibold">@framework.Framework.Name</span><text>, version @framework.Version.Number: </text>
            <span id="coverage">@framework.CoverageText</span>
            @if (current is not null && current.Id != framework.Version.Id && current.Number > framework.Version.Number)
            {
                <span class="badge text-bg-warning ms-2" id="compliance-newer">Newer version available</span>
            }
        }
    </p>

    @if (!anyRequirements)
    {
        @* US-041 R9 *@
        <p class="text-muted" id="no-requirements">This framework has no requirements in the tracker yet</p>
        return;
    }

    @* US-044 R1: the numbers and the covered share of the applicable requirements (same numbers as US-043 R6) *@
    <div class="card mb-3" id="compliance-summary">
        <div class="card-body py-3">
            <div class="row text-center g-2 mb-2">
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-success"><span id="summary-covered">@covered</span> / <span id="summary-total">@total</span></div>
                    <div class="small text-muted">Covered</div>
                </div>
                <div class="col-6 col-md">
                    @* US-057 R4 *@
                    <div class="fs-4 fw-semibold text-primary" id="summary-evidence">@shownFrameworks.Sum(f => f.WithEvidence)</div>
                    <div class="small text-muted">With evidence</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-danger" id="summary-not-covered">@shownFrameworks.Sum(f => f.NotCovered)</div>
                    <div class="small text-muted">Not covered</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-info" id="summary-suggestions">@shownFrameworks.Sum(f => f.SuggestionCount)</div>
                    <div class="small text-muted">AI suggestions</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-secondary" id="summary-not-applicable">@shownFrameworks.Sum(f => f.NotApplicable)</div>
                    <div class="small text-muted">Not applicable</div>
                </div>
            </div>
            <div class="progress ct-progress-sm" role="progressbar" id="coverage-bar" aria-label="Covered share"
                 aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar bg-success" data-percent="@percent"></div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @* US-044 R2: links (GET), so a filtered view can be shared; the search is kept *@
        <div class="btn-group btn-group-sm" role="group" aria-label="Filter requirements" id="compliance-filters">
            @foreach (var (slug, title) in ComplianceFilters.Each)
            {
                <a class="btn @(slug == filter ? "btn-secondary" : "btn-outline-secondary")" data-filter="@slug"
                   aria-current="@(slug == filter ? "true" : null)"
                   href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Compliance, sub = activeSlug, show = slug == ComplianceFilters.All ? null : slug, q = string.IsNullOrWhiteSpace(Model.Search) ? null : Model.Search })">@title</a>
            }
        </div>

        @* US-019 R3: a GET form, so a search can be linked to *@
        <form method="get" class="d-flex gap-1" id="requirement-search"
              action="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Compliance, sub = activeSlug })">
            @if (showFilter is not null)
            {
                <input type="hidden" name="show" value="@showFilter" />
            }
            <input name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search code or text" aria-label="Search requirements" />
            <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        </form>

        @* US-052: the traceability matrix, for this regulation or all of them; for every role.
           US-120: as Excel or CSV, made for the team, an auditor or the management. A GET form, so it is a plain download. *@
        <form method="get" class="d-flex flex-wrap gap-1 ms-md-auto" id="traceability-download"
              action="@Url.Action("Traceability", new { id = project.Id })" aria-label="Download traceability matrix">
            <select name="audience" class="form-select form-select-sm w-auto" aria-label="For whom">
                <option value="team">For the team</option>
                <option value="auditor">For an auditor</option>
                <option value="management">For the management</option>
            </select>
            <select name="format" class="form-select form-select-sm w-auto" aria-label="Format">
                <option value="xlsx">Excel</option>
                <option value="csv">CSV</option>
            </select>
            <select name="sub" class="form-select form-select-sm w-auto" aria-label="Regulations">
                @if (!all)
                {
                    <option value="@activeSlug">@FrameworkNames.Short(active!.Framework.Name)</option>
                }
                <option value="">All regulations</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary" id="download-traceability">Download</button>
        </form>

        @if (!all && !project.IsClosed && canLink && openStories.Count > 0 && active!.NotCovered > 0)
        {
            @* US-044 R3: only this framework's not-covered, applicable requirements *@
            <form asp-action="SuggestForNotCovered" method="post" id="suggest-not-covered">
                <input type="hidden" name="projectId" value="@project.Id" />
                <input type="hidden" name="frameworkId" value="@active.Framework.Id" />
                <input type="hidden" name="sub" value="@activeSlug" />
                <button type="submit" class="btn btn-sm btn-outline-primary" title="The local AI suggests user stories for each requirement that is not covered. You approve or reject each suggestion.">Suggest for not covered</button>
            </form>
        }
        @if (!all && !project.IsClosed && canDecide && active!.NotCovered > 0)
        {
            @* US-060 R6: the AI only suggests; a person accepts or rejects each one *@
            <form asp-action="SuggestNotApplicable" method="post" id="suggest-not-applicable">
                <input type="hidden" name="projectId" value="@project.Id" />
                <input type="hidden" name="frameworkId" value="@active.Framework.Id" />
                <input type="hidden" name="sub" value="@activeSlug" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="The local AI checks the requirements that are not covered against the product's purpose, scope and classification, and suggests the ones that clearly do not apply.">Suggest not applicable</button>
            </form>
        }
        @if (TempData["ApplicabilityMessage"] is string applicabilityMessage)
        {
            <span class="small text-muted w-100" id="applicability-message" role="status">@applicabilityMessage</span>
        }
        @if (TempData["NewIssueAddress"] is string newIssue)
        {
            @* US-106 R4: GitHub's "new issue" page, filled in from the accepted draft *@
            <a class="small w-100" id="new-issue-address" href="@newIssue" target="_blank" rel="noopener noreferrer">Create the issue in GitHub</a>
        }
    </div>

    @if (!hasTranslations)
    {
        @* US-142 R8: one note instead of one on every row *@
        <p class="small text-muted" id="not-translated">Not translated yet: the requirements are shown in English.</p>
    }
    @if (shownCount == 0)
    {
        <p class="text-muted" id="no-matching-requirements">No requirements match</p>
    }
    else
    {
        @* US-144 R10: fold or open every row; a row that waits for a decision stays open (site.js) *@
        <div class="d-flex justify-content-end gap-2 mb-1 small">
            <button type="button" class="btn btn-sm btn-link p-0" id="fold-all" hidden>Fold all</button>
            <button type="button" class="btn btn-sm btn-link p-0" id="open-all" hidden>Open all</button>
        </div>
        <table class="table align-middle" id="requirements-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Requirement</th>
                    <th>Covered by</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var framework in shownFrameworks)
                {
                    var rowsOfFramework = Shown(framework).ToList();
                    if (rowsOfFramework.Count == 0)
                    {
                        continue;
                    }

                    if (all)
                    {
                        @* R13: one group per framework *@
                        <tr class="framework-group table-secondary"><th colspan="4">@FrameworkNames.Short(framework.Framework.Name) <span class="fw-normal small">@framework.CoverageText</span></th></tr>
                    }

                    // US-143 R4: the depth of each requirement in the standard's tree, and which have requirements under them
                    var parents = framework.Requirements.ToDictionary(r => r.Requirement.Id, r => r.Requirement.ParentId);
                    var withChildren = parents.Values.Where(p => p is not null).Select(p => p!.Value).ToHashSet();
                    int Depth(Guid id)
                    {
                        var depth = 0;
                        for (var up = parents.GetValueOrDefault(id); up is { } parent && depth < 10; up = parents.GetValueOrDefault(parent))
                        {
                            depth++;
                        }

                        return depth;
                    }

                    var implementsName = framework.Framework.ImplementsFrameworkId is { } implementsId
                        ? compliance.Frameworks.FirstOrDefault(f => f.Framework.Id == implementsId)?.Framework.ShortName ?? "the directive"
                        : null;
                    string? group = null;
                    foreach (var row in rowsOfFramework)
                    {
                        @* US-043 R7: e.g. "Part I – Essential cybersecurity requirements" *@
                        if (row.Requirement.Group is not null && row.Requirement.Group != group)
                        {
                            group = row.Requirement.Group;
                            <tr class="requirement-group table-light"><th colspan="4">@group</th></tr>
                        }

                        var open = Model.OpenRequirement is { } target && !all
                            && string.Equals(target, row.Requirement.Code, StringComparison.OrdinalIgnoreCase);
                        <partial name="_RequirementRow" model="new RequirementRowModel(project, framework, row, activeSlug, showFilter, canLink, canDecide,
                            openStories, Model.EvidenceTab?.Evidence ?? [], projectRisks, NameOf, Model.Language, hasTranslations,
                            Depth(row.Requirement.Id), withChildren.Contains(row.Requirement.Id), open, implementsName)" />
                    }
                }
            </tbody>
        </table>
    }

    @if (Model.CanBeAdded.Any())
    {
        @* R15: frameworks switched on for the organisation that the project does not use yet *@
        <section class="mt-3 small" id="unused-frameworks">
            <span class="text-muted">Not used by this project:</span>
            @foreach (var unused in Model.CanBeAdded.OrderBy(f => f.Name))
            {
                <span class="d-inline-flex align-items-center gap-1 ms-2 unused-framework" data-framework="@unused.Name">
                    @FrameworkNames.Short(unused.Name)
                    @if (!project.IsClosed && await Permissions.CanAsync(Permission.EditProjects))
                    {
                        <form asp-action="AddFramework" method="post" class="d-inline add-unused-framework">
                            <input type="hidden" name="projectId" value="@project.Id" />
                            <input type="hidden" name="frameworkId" value="@unused.Id" />
                            <input type="hidden" name="back" value="@ProjectTabs.Compliance" />
                            <button type="submit" class="btn btn-sm btn-link p-0">Add to project</button>
                        </form>
                    }
                </span>
            }
        </section>
    }
</section>
