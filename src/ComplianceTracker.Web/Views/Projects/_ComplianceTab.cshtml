@* US-019, US-021, US-041, US-044: the project's requirements per regulation, what covers them, the AI's suggestions and the coverage.
   One sub-tab per framework the project follows, each with its own address (/Projects/Details/{id}/compliance/{slug}).
   Ids and classes used by the tests: #compliance-tabs (links data-sub), #coverage, #requirement-search,
   #requirements-table rows requirement-row (data-code) with requirement-status and linked-story, link-requirement forms,
   unlink-requirement forms, #no-requirements, #no-frameworks-compliance.
   US-043: group header rows .requirement-group, .official-text links, .not-applicable-reason, and the forms
   .mark-not-applicable and .mark-applicable.
   US-044: #compliance-summary with #summary-covered, #summary-total, #summary-not-covered, #summary-suggestions,
   #summary-not-applicable and #coverage-bar; #compliance-filters links (data-filter); form #suggest-not-covered;
   per row .ai-suggestion (data-story) with .suggestion-story, .suggestion-score, .suggestion-rationale and the forms
   .approve-suggestion and .reject-suggestion (reason, comment).
   US-057: #summary-evidence; per row .evidence (data-title) with .evidence-title, .evidence-sha256, .evidence-expired and
   form .remove-evidence; form .add-evidence (title, url, file, validUntil); .evidence-status "No evidence".
   US-052: #download-traceability (this regulation) and #download-traceability-all. *@
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var compliance = Model.Compliance;
    var active = Model.ActiveCompliance;
    var activeSlug = active is null ? null : FrameworkNames.Slug(active.Framework.Name);
    var canLink = await Permissions.CanAsync(Permission.LinkWork);
    var canDecide = await Permissions.CanAsync(Permission.DecideCompliance);
    var filter = Model.ComplianceFilter;
    var showFilter = filter == ComplianceFilters.All ? null : filter;
    const int ShortDescription = 180;
}

<section id="project-compliance">
    @if (compliance is null || compliance.Frameworks.Count == 0)
    {
        @* US-041 R8 *@
        <p class="text-muted" id="no-frameworks-compliance">
            No frameworks yet. <a asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Frameworks">Add one on the Frameworks tab</a>.
        </p>
        return;
    }

    @* US-041 R2: one sub-tab per framework, alphabetical *@
    <ul class="nav nav-pills mb-3" id="compliance-tabs">
        @foreach (var tab in compliance.Frameworks)
        {
            var slug = FrameworkNames.Slug(tab.Framework.Name);
            <li class="nav-item">
                <a class="nav-link @(slug == activeSlug ? "active" : "")" data-sub="@slug"
                   asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@ProjectTabs.Compliance" asp-route-sub="@slug">@FrameworkNames.Short(tab.Framework.Name)</a>
            </li>
        }
    </ul>

    @{
        var framework = active!;
        var current = framework.Framework.CurrentVersion(Model.Today);
        var rows = framework.Requirements.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            var term = Model.Search.Trim();
            rows = rows.Where(r => r.Requirement.Code.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.Requirement.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                || r.Requirement.Description.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        var shown = rows.Where(r => ComplianceFilters.Matches(filter, r)).ToList();
        var openStories = compliance.WorkItems
            .Where(w => w.State != ComplianceTracker.Domain.WorkItems.WorkItemState.Removed)
            .OrderBy(w => w.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    @* US-041 R4, R7 / US-021 R4 *@
    <p class="mb-2">
        <span class="fw-semibold">@framework.Framework.Name</span>, version @framework.Version.Number:
        <span id="coverage">@framework.CoverageText</span>
        @if (current is not null && current.Id != framework.Version.Id && current.Number > framework.Version.Number)
        {
            <span class="badge text-bg-warning ms-2" id="compliance-newer">Newer version available</span>
        }
    </p>

    @if (framework.Requirements.Count == 0)
    {
        @* US-041 R9 *@
        <p class="text-muted" id="no-requirements">This framework has no requirements in the tracker yet</p>
        return;
    }

    @* US-044 R1: the four numbers and the covered share of the applicable requirements (same numbers as US-043 R6) *@
    <div class="card mb-3" id="compliance-summary">
        <div class="card-body py-3">
            <div class="row text-center g-2 mb-2">
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-success"><span id="summary-covered">@framework.Covered</span> / <span id="summary-total">@framework.Total</span></div>
                    <div class="small text-muted">Covered</div>
                </div>
                <div class="col-6 col-md">
                    @* US-057 R4 *@
                    <div class="fs-4 fw-semibold text-primary" id="summary-evidence">@framework.WithEvidence</div>
                    <div class="small text-muted">With evidence</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-danger" id="summary-not-covered">@framework.NotCovered</div>
                    <div class="small text-muted">Not covered</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-info" id="summary-suggestions">@framework.SuggestionCount</div>
                    <div class="small text-muted">AI suggestions</div>
                </div>
                <div class="col-6 col-md">
                    <div class="fs-4 fw-semibold text-secondary" id="summary-not-applicable">@framework.NotApplicable</div>
                    <div class="small text-muted">Not applicable</div>
                </div>
            </div>
            <div class="progress" role="progressbar" id="coverage-bar" aria-label="Covered share"
                 aria-valuenow="@framework.Percent" aria-valuemin="0" aria-valuemax="100" style="height: .75rem">
                <div class="progress-bar bg-success" style="width: @framework.Percent%"></div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @* US-044 R2: links (GET), so a filtered view can be shared; the search is kept *@
        <div class="btn-group btn-group-sm" role="group" aria-label="Filter requirements" id="compliance-filters">
            @foreach (var (slug, title) in ComplianceFilters.Each)
            {
                <a class="btn @(slug == filter ? "btn-secondary" : "btn-outline-secondary")" data-filter="@slug"
                   aria-current="@(slug == filter ? "true" : null)"
                   href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Compliance, sub = activeSlug, show = slug == ComplianceFilters.All ? null : slug, q = string.IsNullOrWhiteSpace(Model.Search) ? null : Model.Search })">@title</a>
            }
        </div>

        @* US-019 R3: a GET form, so a search can be linked to *@
        <form method="get" class="d-flex gap-1" id="requirement-search"
              action="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Compliance, sub = activeSlug })">
            @if (showFilter is not null)
            {
                <input type="hidden" name="show" value="@showFilter" />
            }
            <input name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search code or text" aria-label="Search requirements" />
            <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        </form>

        @* US-052: the traceability matrix as CSV, for this regulation or all of them; for every role *@
        <div class="btn-group btn-group-sm ms-md-auto" role="group" aria-label="Download traceability matrix" id="traceability-download">
            <a class="btn btn-outline-secondary" id="download-traceability"
               asp-action="Traceability" asp-route-id="@project.Id" asp-route-sub="@activeSlug">Download CSV</a>
            <a class="btn btn-outline-secondary" id="download-traceability-all"
               asp-action="Traceability" asp-route-id="@project.Id" title="Every regulation the project follows">All regulations</a>
        </div>

        @if (!project.IsClosed && canLink && openStories.Count > 0 && framework.NotCovered > 0)
        {
            @* US-044 R3: only this framework's not-covered, applicable requirements *@
            <form asp-action="SuggestForNotCovered" method="post" id="suggest-not-covered">
                <input type="hidden" name="projectId" value="@project.Id" />
                <input type="hidden" name="frameworkId" value="@framework.Framework.Id" />
                <input type="hidden" name="sub" value="@activeSlug" />
                <button type="submit" class="btn btn-sm btn-outline-primary" title="The local AI suggests user stories for each requirement that is not covered. You approve or reject each suggestion.">Suggest for not covered</button>
            </form>
        }
    </div>

    @if (shown.Count == 0)
    {
        <p class="text-muted" id="no-matching-requirements">No requirements match</p>
    }
    else
    {
        <table class="table align-middle" id="requirements-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Requirement</th>
                    <th>Covered by</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{ string? group = null; }
                @foreach (var row in shown)
                {
                    var requirement = row.Requirement;
                    var linkable = openStories.Where(w => row.Links.All(l => l.WorkItem.Id != w.Id)).ToList();
                    var canLinkHere = !project.IsClosed && canLink && linkable.Count > 0 && row.IsApplicable;
                    var canAddEvidence = !project.IsClosed && canLink && row.IsApplicable;
                    var canMarkHere = !project.IsClosed && canDecide && row.IsApplicable;
                    @* US-043 R7: e.g. "Part I – Essential cybersecurity requirements" *@
                    if (requirement.Group is not null && requirement.Group != group)
                    {
                        group = requirement.Group;
                        <tr class="requirement-group table-light"><th colspan="4">@group</th></tr>
                    }
                    <tr class="requirement-row @(row.IsApplicable ? "" : "text-muted")" data-code="@requirement.Code" data-group="@requirement.Group">
                        <td class="requirement-code text-nowrap align-top">@requirement.Code</td>
                        <td class="requirement-title align-top">
                            @requirement.Title
                            @if (!string.IsNullOrEmpty(requirement.Description))
                            {
                                @* US-044: long descriptions can be expanded *@
                                if (requirement.Description.Length <= ShortDescription)
                                {
                                    <div class="small text-muted">@requirement.Description</div>
                                }
                                else
                                {
                                    <details class="small text-muted requirement-description">
                                        <summary>@requirement.Description[..ShortDescription].TrimEnd()…</summary>
                                        @requirement.Description
                                    </details>
                                }
                            }
                            @if (requirement.Reference is not null)
                            {
                                @* US-043 R7: the official text *@
                                <a class="official-text small" href="@requirement.Reference" target="_blank" rel="noopener noreferrer">Official text</a>
                            }
                        </td>
                        <td class="align-top">
                            @foreach (var link in row.Links)
                            {
                                @* US-021 R7: each story links to its issue *@
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <a class="linked-story" href="@link.WorkItem.Url" target="_blank" rel="noopener noreferrer">@link.WorkItem.Title</a>
                                    <span class="badge text-bg-light">@link.WorkItem.State</span>
                                    @if (!project.IsClosed && canLink)
                                    {
                                        <form asp-action="UnlinkRequirement" method="post" class="d-inline unlink-requirement">
                                            <input type="hidden" name="projectId" value="@project.Id" />
                                            <input type="hidden" name="linkId" value="@link.LinkId" />
                                            <input type="hidden" name="sub" value="@activeSlug" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Remove link" aria-label="Remove link to @link.WorkItem.Title">×</button>
                                        </form>
                                    }
                                </div>
                            }

                            @foreach (var item in row.Evidence)
                            {
                                @* US-057: the proof, a link or a file; R3: expired is shown but does not count *@
                                var evidence = item.Evidence;
                                <div class="evidence d-flex flex-wrap align-items-center gap-1 mb-1 small" data-title="@evidence.Title">
                                    <span class="badge text-bg-primary">Evidence</span>
                                    @if (evidence.IsFile)
                                    {
                                        <a class="evidence-title" asp-action="EvidenceFile" asp-route-id="@project.Id" asp-route-evidenceId="@evidence.Id">@evidence.Title</a>
                                        <span class="text-muted evidence-sha256" title="SHA-256 @evidence.Sha256">SHA-256 @(evidence.Sha256![..8])…</span>
                                    }
                                    else
                                    {
                                        <a class="evidence-title" href="@evidence.Url" target="_blank" rel="noopener noreferrer">@evidence.Title</a>
                                    }
                                    @if (item.IsExpired)
                                    {
                                        <span class="badge text-bg-warning evidence-expired">Expired</span>
                                    }
                                    else if (evidence.ValidUntil is { } until)
                                    {
                                        <span class="text-muted">valid until @until.ToString("dd-MM-yyyy")</span>
                                    }
                                    @if (!project.IsClosed && canLink)
                                    {
                                        <form asp-action="RemoveEvidence" method="post" class="d-inline remove-evidence">
                                            <input type="hidden" name="projectId" value="@project.Id" />
                                            <input type="hidden" name="evidenceId" value="@evidence.Id" />
                                            <input type="hidden" name="sub" value="@activeSlug" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Remove evidence" aria-label="Remove evidence @evidence.Title">×</button>
                                        </form>
                                    }
                                </div>
                            }

                            @if (row.IsApplicable)
                            {
                                @foreach (var entry in row.Suggestions)
                                {
                                    @* US-044 R4: the pending AI suggestions, best first. R6: only roles that may decide get the buttons. *@
                                    var suggestion = entry.Suggestion;
                                    <div class="ai-suggestion border-start border-3 border-info ps-2 mb-2" data-story="@entry.WorkItem.Title" data-code="@requirement.Code">
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <span class="badge text-bg-info">AI-generated</span>
                                            <a class="suggestion-story" href="@entry.WorkItem.Url" target="_blank" rel="noopener noreferrer">@entry.WorkItem.Title</a>
                                            <span class="small text-muted">score <span class="suggestion-score">@suggestion.Score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span></span>
                                        </div>
                                        <div class="small suggestion-rationale">@(suggestion.Rationale ?? "Writing rationale…")</div>
                                        @if (!project.IsClosed && canDecide)
                                        {
                                            <div class="d-flex flex-wrap align-items-start gap-2 mt-1">
                                                <form asp-action="ApproveSuggestion" method="post" class="approve-suggestion">
                                                    <input type="hidden" name="projectId" value="@project.Id" />
                                                    <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                                    <input type="hidden" name="sub" value="@activeSlug" />
                                                    <input type="hidden" name="show" value="@showFilter" />
                                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                                </form>
                                                <details>
                                                    <summary class="btn btn-sm btn-outline-danger">Reject…</summary>
                                                    <form asp-action="RejectSuggestion" method="post" class="d-flex flex-wrap gap-1 mt-1 reject-suggestion">
                                                        <input type="hidden" name="projectId" value="@project.Id" />
                                                        <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                                        <input type="hidden" name="sub" value="@activeSlug" />
                                                        <input type="hidden" name="show" value="@showFilter" />
                                                        <select name="reason" class="form-select form-select-sm w-auto" aria-label="Reason">
                                                            <option value="">Reason…</option>
                                                            @foreach (var reason in Enum.GetValues<ComplianceTracker.Domain.Mappings.RejectionReason>())
                                                            {
                                                                <option value="@reason">@reason</option>
                                                            }
                                                        </select>
                                                        <input name="comment" class="form-control form-control-sm w-auto" placeholder="Comment (optional)" aria-label="Comment" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                                    </form>
                                                </details>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @if (canLinkHere || canMarkHere || canAddEvidence)
                            {
                                @* US-044 R7: the fields open only when clicked *@
                                <div class="small d-flex flex-wrap gap-2 row-actions">
                                    @if (canAddEvidence)
                                    {
                                        @* US-057 R1, R2: a link, or a file of at most 10 MB *@
                                        <details>
                                            <summary class="link-primary">+ Evidence</summary>
                                            <form asp-action="AddEvidence" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-1 mt-1 add-evidence">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                                <input type="hidden" name="sub" value="@activeSlug" />
                                                <input name="title" class="form-control form-control-sm" maxlength="200" placeholder="Title, e.g. PR 42 merged" aria-label="Evidence title for @requirement.Code" />
                                                <input name="url" type="url" class="form-control form-control-sm" placeholder="Link (https://…)" aria-label="Evidence link for @requirement.Code" />
                                                <input name="file" type="file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.txt,.csv,.md" aria-label="Or a file (max 10 MB)" />
                                                <div class="d-flex gap-1 align-items-center">
                                                    <label class="text-muted text-nowrap" for="valid-until-@requirement.Id">Valid until</label>
                                                    <input name="validUntil" id="valid-until-@requirement.Id" type="date" class="form-control form-control-sm" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Add</button>
                                                </div>
                                            </form>
                                        </details>
                                    }
                                    @if (canLinkHere)
                                    {
                                        <details>
                                            <summary class="link-primary">+ Link story</summary>
                                            <form asp-action="LinkRequirement" method="post" class="d-flex gap-1 mt-1 link-requirement">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                                <input type="hidden" name="sub" value="@activeSlug" />
                                                <select name="workItemId" class="form-select form-select-sm" aria-label="User story for @requirement.Code">
                                                    @foreach (var story in linkable)
                                                    {
                                                        <option value="@story.Id">@story.Title</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Link</button>
                                            </form>
                                        </details>
                                    }
                                    @if (canMarkHere)
                                    {
                                        <details>
                                            <summary class="link-secondary">Not applicable…</summary>
                                            <form asp-action="MarkNotApplicable" method="post" class="d-flex gap-1 mt-1 mark-not-applicable">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <input type="hidden" name="requirementId" value="@requirement.Id" />
                                                <input type="hidden" name="sub" value="@activeSlug" />
                                                <input name="reason" class="form-control form-control-sm" placeholder="Reason, e.g. from the risk assessment" aria-label="Why @requirement.Code does not apply" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Mark</button>
                                            </form>
                                        </details>
                                    }
                                </div>
                            }
                        </td>
                        <td class="align-top">
                            @if (!row.IsApplicable)
                            {
                                @* US-043 R5, R6 *@
                                <span class="requirement-status badge text-bg-secondary">Not applicable</span>
                                <div class="small not-applicable-reason">@row.NotApplicableReason</div>
                                @if (!project.IsClosed && canDecide)
                                {
                                    <form asp-action="MarkApplicable" method="post" class="mark-applicable">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="requirementId" value="@requirement.Id" />
                                        <input type="hidden" name="sub" value="@activeSlug" />
                                        <button type="submit" class="btn btn-sm btn-link p-0">Make applicable</button>
                                    </form>
                                }
                            }
                            else if (row.IsCovered)
                            {
                                <span class="requirement-status badge text-bg-success">Covered</span>
                                @if (!row.HasEvidence)
                                {
                                    @* US-057 R4 *@
                                    <div><span class="evidence-status badge text-bg-warning mt-1">No evidence</span></div>
                                }
                            }
                            else
                            {
                                <span class="requirement-status badge text-bg-danger">Not covered</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
