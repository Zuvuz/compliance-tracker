@* US-022 R5: the project's log entries, newest first, with what changed (Details, US-024 R3).
   US-101: search, filters, sorting and pages. The filter bar and the table are shared with the organisation's
   Activity page (US-102): Views/Shared/_ActivityLog.cshtml, which lists the ids and classes the tests use. *@
@model ProjectDetailsViewModel
@{
    var log = new ActivityLogViewModel(
        "project-activity",
        Url.Action("Details", "Projects", new { id = Model.Project.Id, tab = ProjectTabs.Activity })!,
        Model.ActivityQuery,
        Model.ActivityPage,
        Model.ActivityIgnored,
        Model.Organization);
}

<partial name="_ActivityLog" model="log" />
