@* US-022 R5: the project's log entries, newest first, with what changed (Details, US-024 R3).
   US-101: search, filters, sorting and pages; the filters stand in the address (a GET form), so a view can be shared.
   Ids and classes used by the tests: #project-activity, rows activity-row, cells activity-time, activity-user,
   activity-action, activity-details, #no-activity, #activity-filters (inputs q, from, to, group, user, sort),
   #activity-count, #activity-no-match, #activity-ignored li, a#activity-previous, a#activity-next, a#activity-clear. *@
@using ComplianceTracker.Application.ActivityLog
@using ComplianceTracker.Domain.ActivityLog
@model ProjectDetailsViewModel
@{
    var query = Model.ActivityQuery;
    var result = Model.ActivityPage;
    var address = Url.Action("Details", "Projects", new { id = Model.Project.Id, tab = ProjectTabs.Activity });
    string PageLink(int number)
    {
        var values = ActivityFilters.RouteValues(query, number).Where(v => v.Value is not null)
            .Select(v => $"{Uri.EscapeDataString(v.Key)}={Uri.EscapeDataString(v.Value!)}");
        var queryString = string.Join("&", values);
        return queryString.Length == 0 ? address! : $"{address}?{queryString}";
    }
}

<section id="project-activity">
    @* R1-R3, R5, R6 *@
    <form method="get" action="@address" class="row g-2 align-items-end mb-3" id="activity-filters">
        <div class="col-md-3">
            <label class="form-label small mb-0" for="activity-q">Search</label>
            <input id="activity-q" name="q" value="@query.Search" class="form-control form-control-sm" placeholder="Details or user" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0" for="activity-from">From</label>
            <input id="activity-from" name="from" type="date" value="@query.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0" for="activity-to">To</label>
            <input id="activity-to" name="to" type="date" value="@query.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0" for="activity-group">Action</label>
            <select id="activity-group" name="group" class="form-select form-select-sm">
                <option value="">All actions</option>
                @foreach (var group in Enum.GetValues<ActivityGroup>())
                {
                    <option value="@ActivityFilters.Slug(group)" selected="@(query.Group == group)">@ActivityGroups.Title(group)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-0" for="activity-user">User</label>
            <select id="activity-user" name="user" class="form-select form-select-sm">
                <option value="">Everyone</option>
                <option value="@ActivityFilters.System" selected="@query.SystemOnly">System</option>
                @foreach (var member in Model.Organization?.Users.OrderBy(u => u.Name) ?? Enumerable.Empty<ComplianceTracker.Domain.Users.User>())
                {
                    <option value="@member.Id" selected="@(query.UserId == member.Id)">@member.Name@(member.IsActive ? "" : " (removed)")</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label class="form-label small mb-0" for="activity-sort">Sort</label>
            <select id="activity-sort" name="sort" class="form-select form-select-sm">
                @foreach (var (sort, slug, title) in ActivityFilters.Sorts)
                {
                    <option value="@slug" selected="@(query.Sort == sort)">@title</option>
                }
            </select>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary">Show</button>
            @if (query.HasFilters || query.Sort != ActivitySort.Newest)
            {
                <a id="activity-clear" class="btn btn-sm btn-outline-secondary" href="@address">Clear filters</a>
            }
        </div>
    </form>

    @if (Model.ActivityIgnored.Count > 0)
    {
        @* R9 *@
        <ul class="alert alert-warning small" id="activity-ignored">
            @foreach (var message in Model.ActivityIgnored)
            {
                <li>@message</li>
            }
        </ul>
    }

    @if (result is null || result.Total == 0)
    {
        if (query.HasFilters)
        {
            @* R7 *@
            <p class="text-muted" id="activity-no-match">No entries match the filters</p>
        }
        else
        {
            @* US-022 R7 *@
            <p class="text-muted" id="no-activity">No activity yet</p>
        }
    }
    else
    {
        @* R4 *@
        <p class="small text-muted" id="activity-count">@result.First–@result.Last of @result.Total entries</p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in result.Entries)
                {
                    <tr class="activity-row">
                        @* R8: the time matters here, so HH:mm is shown too. Stored in UTC, shown in local time. *@
                        <td class="activity-time text-nowrap">@entry.OccurredAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td class="activity-user">@Model.NameOf(entry.UserId)</td>
                        <td class="activity-action">@entry.Action</td>
                        <td class="activity-details small">@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
        <nav class="d-flex gap-2" aria-label="Activity pages">
            @if (result.HasPrevious)
            {
                <a id="activity-previous" class="btn btn-sm btn-outline-primary" href="@PageLink(result.Page - 1)">Previous</a>
            }
            @if (result.HasNext)
            {
                <a id="activity-next" class="btn btn-sm btn-outline-primary" href="@PageLink(result.Page + 1)">Next</a>
            }
        </nav>
    }
</section>
