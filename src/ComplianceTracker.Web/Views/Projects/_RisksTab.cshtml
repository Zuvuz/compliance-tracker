@* US-042: the project's risk register, a 5×5 matrix of the open risks, and filters.
   Ids and classes used by the tests: #add-risk-link, #risk-filter, #risk-matrix with cells data-likelihood / data-impact,
   #risks-table rows risk-row (data-title) with risk-level, risk-status, risk-flags, and #no-risks.
   US-165: .risk-residual next to the level ("→ Medium" or "→ –"), and the flags .residual-to-set and .residual-to-review. *@
@using ComplianceTracker.Domain.Risks
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    // US-168 R2: the shared colours of the risk levels
    string Badge(RiskLevel level) => StatusBadges.ClassOf(level.ToString());
    var open = Model.AllRisks.Where(r => r.Status != RiskStatus.Closed).ToList();
    // US-203 R2, R3: the matrix before or after the measures; every link of the tab keeps the choice
    var after = Model.RiskMatrixAfter;
    var matrix = after ? RiskMatrix.After : RiskMatrix.Before;
}

<section id="project-risks">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="mb-0 small text-muted">The product's cybersecurity risks (CRA Art. 13, ISO 27001 6.1.2). Likelihood and impact from 1 to 5.</p>
        @if (!project.IsClosed && await Permissions.CanAsync(Permission.ManageRisks))
        {
            <div class="d-flex gap-1">
                @* US-112: the AI agent drafts; a person decides every risk *@
                <form asp-controller="Risks" asp-action="Draft" method="post" class="d-inline" id="draft-risks" data-busy="Working… this can take a minute">
                    <input type="hidden" name="projectId" value="@project.Id" />
                    <button type="submit" class="btn btn-outline-info btn-sm">Draft risks with AI</button>
                </form>
                <a class="btn btn-outline-secondary btn-sm" id="import-risks-link" asp-controller="Risks" asp-action="Import" asp-route-projectId="@project.Id">Import</a>
                <a class="btn btn-primary btn-sm" id="add-risk-link" asp-controller="Risks" asp-action="Add" asp-route-projectId="@project.Id">Add risk</a>
            </div>
        }
    </div>

    @if (TempData["RisksDrafted"] is string drafted)
    {
        <div class="alert alert-info py-2" id="risks-drafted" role="status">@drafted</div>
    }

    @if (Model.RiskDrafts.Count > 0)
    {
        @* US-112 R2, R4, R5: each draft with why; accept after editing, or discard with a reason. #risk-drafts .risk-draft[data-title].
           US-157: grouped under h3.risk-draft-theme[data-theme] *@
        var canDecideDrafts = !project.IsClosed && await Permissions.CanAsync(Permission.ManageRisks);
        <div class="card mb-3 border-info" id="risk-drafts">
            <div class="card-body small">
                <h2 class="h6 card-title"><span class="badge text-bg-info">AI-generated</span> Drafts waiting for your decision (@Model.RiskDrafts.Count)</h2>
                @{
                    // US-157: the drafts grouped by the theme of the round that gave them, in the agent's order
                    var themeOrder = new[] { ComplianceTracker.Application.Risks.RiskThemes.Access, ComplianceTracker.Application.Risks.RiskThemes.Data,
                        ComplianceTracker.Application.Risks.RiskThemes.Updates, ComplianceTracker.Application.Risks.RiskThemes.Availability,
                        ComplianceTracker.Application.Risks.RiskThemes.Requirements, ComplianceTracker.Application.Risks.RiskThemes.EventsAndFindings }
                        .Select(t => t.Name).ToList();
                    int Order(string? theme) => theme is null ? int.MaxValue : themeOrder.IndexOf(theme) is var i && i >= 0 ? i : int.MaxValue - 1;
                    string? shownTheme = "";
                }
                @foreach (var draft in Model.RiskDrafts.OrderBy(d => Order(d.Theme)))
                {
                    if (draft.Theme != shownTheme)
                    {
                        shownTheme = draft.Theme;
                        <h3 class="h6 mt-3 mb-1 risk-draft-theme" data-theme="@(draft.Theme ?? "Other")">@(draft.Theme ?? "Other")</h3>
                    }
                    <details class="risk-draft border-start border-3 border-info ps-2 my-2" data-title="@draft.Title">
                        <summary><span class="badge @Badge(draft.Level)">@draft.Level</span> @draft.Title <span class="text-muted">· @draft.Likelihood × @draft.Impact</span></summary>
                        <div class="mt-1"><strong>Threat:</strong> @draft.Threat</div>
                        <div><strong>Asset:</strong> @draft.Asset</div>
                        <div class="risk-draft-based-on"><strong>Based on:</strong> @draft.BasedOn</div>
                        <div class="text-muted risk-draft-why">@draft.Reasoning</div>
                        @if (canDecideDrafts)
                        {
                            <form asp-controller="Risks" asp-action="AcceptDraft" method="post" class="row g-1 mt-1 accept-risk-draft">
                                <input type="hidden" name="projectId" value="@project.Id" />
                                <input type="hidden" name="draftId" value="@draft.Id" />
                                <div class="col-md-6"><input name="title" value="@draft.Title" maxlength="200" class="form-control form-control-sm" aria-label="Title" required /></div>
                                <div class="col-md-6"><input name="description" value="@draft.Threat" maxlength="4000" class="form-control form-control-sm" aria-label="Description" /></div>
                                <div class="col-auto"><input type="number" name="likelihood" min="1" max="5" value="@draft.Likelihood" class="form-control form-control-sm" aria-label="Likelihood" /></div>
                                <div class="col-auto"><input type="number" name="impact" min="1" max="5" value="@draft.Impact" class="form-control form-control-sm" aria-label="Impact" /></div>
                                <div class="col-auto"><select name="ownerId" class="form-select form-select-sm" aria-label="Owner">
                                    @foreach (var member in Model.Organization?.Members ?? [])
                                    {
                                        <option value="@member.Id">@member.Name</option>
                                    }
                                </select></div>
                                <div class="col-auto"><select name="treatment" class="form-select form-select-sm" aria-label="Treatment">
                                    @foreach (var treatment in Enum.GetValues<RiskTreatment>().Where(t => t != RiskTreatment.Accept))
                                    {
                                        <option value="@treatment">@treatment</option>
                                    }
                                </select></div>
                                <div class="col-auto"><button type="submit" class="btn btn-sm btn-success">Accept as a risk</button></div>
                            </form>
                            <form asp-controller="Risks" asp-action="DiscardDraft" method="post" class="d-flex gap-1 mt-1 discard-risk-draft">
                                <input type="hidden" name="projectId" value="@project.Id" />
                                <input type="hidden" name="draftId" value="@draft.Id" />
                                <input name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="Why it does not apply" aria-label="Reason for discarding" required />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Discard</button>
                            </form>
                        }
                    </details>
                }
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            @* US-203 R2: before or after the measures, remembered in this browser (US-175) *@
            <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Risk matrix" id="risk-matrix-mode"
                 data-remember="risk-matrix:@project.Id" data-remember-params="matrix">
                @foreach (var (text, value) in new[] { ("Before measures", RiskMatrix.Before), ("After measures", RiskMatrix.After) })
                {
                    <a class="btn @(matrix == value ? "btn-secondary" : "btn-outline-secondary")" aria-current="@(matrix == value ? "true" : null)" data-matrix="@value"
                       href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks, status = Model.RiskStatusFilter, due = Model.OnlyReviewDue ? "1" : null, matrix = value })">@text</a>
                }
            </div>
            @* R8: the open risks per cell; likelihood up, impact to the right *@
            <table class="table table-bordered table-sm text-center small" id="risk-matrix" aria-label="Risk matrix" data-matrix="@matrix">
                <tbody>
                    @for (var likelihood = Risk.MaxScale; likelihood >= Risk.MinScale; likelihood--)
                    {
                        <tr>
                            <th class="text-end">@likelihood</th>
                            @for (var impact = Risk.MinScale; impact <= Risk.MaxScale; impact++)
                            {
                                var count = open.Count(r => after ? r.LikelihoodAfter == likelihood && r.ImpactAfter == impact : r.Likelihood == likelihood && r.Impact == impact);
                                var chosen = Model.RiskCell is { } c && c.Likelihood == likelihood && c.Impact == impact;
                                @* US-147 R2: a cell filters the list; the chosen one again clears it *@
                                <td class="@Badge(Risk.LevelOf(likelihood * impact)) bg-opacity-50 @(chosen ? "risk-cell-chosen" : "")" data-likelihood="@likelihood" data-impact="@impact">
                                    <a class="risk-cell d-block text-reset text-decoration-none" aria-current="@(chosen ? "true" : null)"
                                       aria-label="Likelihood @likelihood, impact @impact: @count open"
                                       href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks, status = Model.RiskStatusFilter, due = Model.OnlyReviewDue ? "1" : null, cell = chosen ? null : RiskCells.Format(likelihood, impact), matrix })">@(count == 0 ? "\u00a0" : count)</a>
                                </td>
                            }
                        </tr>
                    }
                    <tr>
                        <th></th>
                        @for (var impact = Risk.MinScale; impact <= Risk.MaxScale; impact++)
                        {
                            <th>@impact</th>
                        }
                    </tr>
                </tbody>
            </table>
            <p class="small text-muted" id="risk-matrix-note">Rows: likelihood. Columns: impact. Open risks only@(after ? ", placed by their residual risk" : ", before the measures").
                @if (after && open.Count(r => !r.HasResidual) is var withoutResidual and > 0)
                {
                    <span id="risks-without-residual">@withoutResidual @(withoutResidual == 1 ? "risk has" : "risks have") no residual yet and @(withoutResidual == 1 ? "is" : "are") placed as before.</span>
                }
            </p>
        </div>

        <div class="col-lg-8">
            @{
                // US-147 R3: the filter buttons; each keeps the matrix cell
                var cellText = Model.RiskCell is { } chosenCell ? RiskCells.Format(chosenCell.Likelihood, chosenCell.Impact) : null;
                var buttons = new (string Text, string? Status, bool Due, bool Active)[]
                {
                    ("Open", null, false, string.IsNullOrEmpty(Model.RiskStatusFilter) && !Model.OnlyReviewDue),
                    ("Accepted", "Accepted", false, string.Equals(Model.RiskStatusFilter, "Accepted", StringComparison.OrdinalIgnoreCase)),
                    ("Closed", "Closed", false, string.Equals(Model.RiskStatusFilter, "Closed", StringComparison.OrdinalIgnoreCase)),
                    ("Review due", null, true, Model.OnlyReviewDue)
                };
            }
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Show risks" id="risk-status-buttons">
                    @foreach (var b in buttons)
                    {
                        <a class="btn @(b.Active ? "btn-secondary" : "btn-outline-secondary")" aria-current="@(b.Active ? "true" : null)" data-status-button="@b.Text"
                           href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks, status = b.Status, due = b.Due ? "1" : null, cell = cellText, matrix })">@b.Text</a>
                    }
                </div>
                @if (Model.RiskCell is { } shownCell)
                {
                    <span class="small text-muted" id="risk-cell-filter">Likelihood @shownCell.Likelihood × impact @shownCell.Impact ·
                        <a href="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks, status = Model.RiskStatusFilter, due = Model.OnlyReviewDue ? "1" : null, matrix })">clear</a></span>
                }
            </div>
            @* R8: GET, so a filtered register can be linked to *@
            @* US-175 R2, R3: the register's filters are remembered in this browser; an address with its own wins *@
            <button type="button" class="btn btn-sm btn-link reset-view" data-reset-view="risks:@project.Id" hidden>Reset view</button>
            <form method="get" class="row g-2 mb-3" id="risk-filter"
                  action="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks })"
                  data-remember="risks:@project.Id" data-remember-params="status,level,treatment,due,nothing">
                <input type="hidden" name="matrix" value="@matrix" />
                <div class="col-auto">
                    <select name="status" class="form-select form-select-sm" aria-label="Status">
                        <option value="">Not closed</option>
                        @foreach (var status in new[] { "Open", "Treated", "Accepted", "Closed" })
                        {
                            <option value="@status" selected="@(Model.RiskStatusFilter == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <select name="level" class="form-select form-select-sm" aria-label="Level">
                        <option value="">All levels</option>
                        @foreach (var level in Enum.GetValues<RiskLevel>())
                        {
                            <option value="@level" selected="@(Model.RiskLevelFilter == level.ToString())">@level</option>
                        }
                    </select>
                </div>
                <div class="col-auto form-check d-flex align-items-center gap-2 ms-2">
                    <input class="form-check-input" type="checkbox" name="due" value="1" id="only-review-due" @(Model.OnlyReviewDue ? "checked" : "") />
                    <label class="form-check-label small" for="only-review-due">Review due</label>
                </div>
                <div class="col-auto form-check d-flex align-items-center gap-2 ms-2">
                    @* US-159 R4 *@
                    <input class="form-check-input" type="checkbox" name="nothing" value="1" id="only-nothing-behind" @(Model.OnlyNothingBehind ? "checked" : "") />
                    <label class="form-check-label small" for="only-nothing-behind">Nothing behind it</label>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Show</button>
                </div>
            </form>

            @if (Model.Risks.Count == 0)
            {
                @* US-172: what belongs here, why, and the first step *@
                <empty-state id="no-risks" title="No risks yet"
                             why="The CRA (Art. 13(2)) and ISO/IEC 27001 (6.1.2) ask for a risk assessment: what can go wrong, how likely and how bad, and what is done about it."
                             can-act="@(!project.IsClosed && await Permissions.CanAsync(Permission.ManageRisks))"
                             cannot-text="Your role can only read the risks. A member who manages risks adds them.">
                    <a class="btn btn-primary btn-sm" asp-controller="Risks" asp-action="Add" asp-route-projectId="@project.Id">Add a risk</a>
                    <button type="submit" form="draft-risks" class="btn btn-outline-primary btn-sm">Draft risks with AI</button>
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Risks" asp-action="Import" asp-route-projectId="@project.Id">Import from a file</a>
                </empty-state>
            }
            else
            {
                <table class="table align-middle" id="risks-table">
                    <thead>
                        <tr>
                            <th><term name="Risk level">Level</term> → <term name="Residual risk">residual</term></th>
                            <th>Risk</th>
                            <th>L × I</th>
                            <th>Owner</th>
                            <th><term name="Treatment">Treatment</term></th>
                            <th>Linked</th>
                            <th>Status</th>
                            <th>Last reviewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var risk in Model.Risks)
                        {
                            <tr class="risk-row" data-title="@risk.Title">
                                <td class="text-nowrap">
                                    <span class="risk-level badge @Badge(risk.Level)">@risk.Level</span>
                                    @* US-165 R2: the level before and after the measures *@
                                    <span class="risk-residual small" title="Residual risk after the measures">→ @if (risk.ResidualLevel is { } residual)
                                        {
                                            <span class="badge @Badge(residual)">@residual</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">–</span>
                                        }</span>
                                </td>
                                <td>
                                    @* US-147 R4, R5: opens in the side panel; without JavaScript, or for printing, the risk's own page *@
                                    <a class="risk-link" asp-controller="Risks" asp-action="Details" asp-route-id="@risk.Id" data-risk-panel="@risk.Id">@risk.Title</a>
                                    <div class="risk-flags small">
                                        @if (Model.RiskBacking.GetValueOrDefault(risk.Id)?.NothingBehind == true)
                                        {
                                            @* US-159 R2 *@
                                            <span class="badge text-bg-danger nothing-behind" title="An open High or Critical risk to reduce without measures, or whose measures have no story or evidence">Nothing behind it</span>
                                        }
                                        @if (Model.RiskBacking.GetValueOrDefault(risk.Id)?.ResidualToSet == true)
                                        {
                                            @* US-165 R3 *@
                                            <span class="badge text-bg-warning residual-to-set" title="Every measure is backed by a story or evidence: set the risk left after them">Residual to set</span>
                                        }
                                        @if (risk.ResidualToReview && risk.Status != ComplianceTracker.Domain.Risks.RiskStatus.Closed)
                                        {
                                            @* US-165 R5 *@
                                            <span class="badge text-bg-warning residual-to-review" title="Measures were removed after the residual risk was set">Residual to review</span>
                                        }
                                        @if (risk.HasNoMeasures)
                                        {
                                            <span class="badge text-bg-warning">No measures yet</span>
                                        }
                                        @if (risk.IsReviewDue(Model.Now))
                                        {
                                            <span class="badge text-bg-danger">Review due</span>
                                        }
                                        @* US-111 R7 *@
                                        @if (risk.OverdueActions(DateOnly.FromDateTime(Model.Now)) is > 0 and var overdueActions)
                                        {
                                            <span class="badge text-bg-danger">@overdueActions overdue @(overdueActions == 1 ? "action" : "actions")</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap risk-score">@risk.ScoreText</td>
                                <td class="risk-owner">@RiskPageViewModel.OwnerName(Model.Organization, risk.OwnerId)</td>
                                <td>@risk.Treatment</td>
                                @* US-159 R1 *@
                                <td class="small text-muted text-nowrap risk-linked">@((Model.RiskBacking.GetValueOrDefault(risk.Id) ?? ComplianceTracker.Application.Risks.RiskBacking.None).Text)</td>
                                <td class="risk-status">@risk.DisplayStatus</td>
                                <td class="small">@(risk.LastReviewedAt?.ToLocalTime().ToString("dd-MM-yyyy") ?? "never")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>

@* US-147 R4: a risk opens in this side panel with its own address (?risk=…); site.js loads the risk's page into it *@
<div class="offcanvas offcanvas-end ct-risk-panel" tabindex="-1" id="risk-panel" aria-labelledby="risk-panel-title" data-open-risk="@Model.RiskInPanel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="risk-panel-title">Risk</h2>
        <a class="small ms-auto me-3" id="risk-panel-page" href="#">Open the page</a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body" id="risk-panel-body"></div>
</div>
