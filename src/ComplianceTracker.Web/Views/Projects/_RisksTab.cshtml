@* US-042: the project's risk register, a 5×5 matrix of the open risks, and filters.
   Ids and classes used by the tests: #add-risk-link, #risk-filter, #risk-matrix with cells data-likelihood / data-impact,
   #risks-table rows risk-row (data-title) with risk-level, risk-status, risk-flags, and #no-risks. *@
@using ComplianceTracker.Domain.Risks
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    string Badge(RiskLevel level) => level switch
    {
        RiskLevel.Low => "text-bg-success",
        RiskLevel.Medium => "text-bg-warning",
        RiskLevel.High => "text-bg-danger",
        _ => "text-bg-dark"
    };
    var open = Model.AllRisks.Where(r => r.Status != RiskStatus.Closed).ToList();
}

<section id="project-risks">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="mb-0 small text-muted">The product's cybersecurity risks (CRA Art. 13, ISO 27001 6.1.2). Likelihood and impact from 1 to 5.</p>
        @if (!project.IsClosed && await Permissions.CanAsync(Permission.ManageRisks))
        {
            <a class="btn btn-primary btn-sm" id="add-risk-link" asp-controller="Risks" asp-action="Add" asp-route-projectId="@project.Id">Add risk</a>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            @* R8: the open risks per cell; likelihood up, impact to the right *@
            <table class="table table-bordered table-sm text-center small" id="risk-matrix" aria-label="Risk matrix">
                <tbody>
                    @for (var likelihood = Risk.MaxScale; likelihood >= Risk.MinScale; likelihood--)
                    {
                        <tr>
                            <th class="text-end">@likelihood</th>
                            @for (var impact = Risk.MinScale; impact <= Risk.MaxScale; impact++)
                            {
                                var count = open.Count(r => r.Likelihood == likelihood && r.Impact == impact);
                                <td class="@Badge(Risk.LevelOf(likelihood * impact)) bg-opacity-50" data-likelihood="@likelihood" data-impact="@impact">@(count == 0 ? "" : count)</td>
                            }
                        </tr>
                    }
                    <tr>
                        <th></th>
                        @for (var impact = Risk.MinScale; impact <= Risk.MaxScale; impact++)
                        {
                            <th>@impact</th>
                        }
                    </tr>
                </tbody>
            </table>
            <p class="small text-muted">Rows: likelihood. Columns: impact. Open risks only.</p>
        </div>

        <div class="col-lg-8">
            @* R8: GET, so a filtered register can be linked to *@
            <form method="get" class="row g-2 mb-3" id="risk-filter"
                  action="@Url.Action("Details", new { id = project.Id, tab = ProjectTabs.Risks })">
                <div class="col-auto">
                    <select name="status" class="form-select form-select-sm" aria-label="Status">
                        <option value="">Not closed</option>
                        @foreach (var status in new[] { "Open", "Treated", "Accepted", "Closed" })
                        {
                            <option value="@status" selected="@(Model.RiskStatusFilter == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <select name="level" class="form-select form-select-sm" aria-label="Level">
                        <option value="">All levels</option>
                        @foreach (var level in Enum.GetValues<RiskLevel>())
                        {
                            <option value="@level" selected="@(Model.RiskLevelFilter == level.ToString())">@level</option>
                        }
                    </select>
                </div>
                <div class="col-auto form-check d-flex align-items-center gap-2 ms-2">
                    <input class="form-check-input" type="checkbox" name="due" value="1" id="only-review-due" @(Model.OnlyReviewDue ? "checked" : "") />
                    <label class="form-check-label small" for="only-review-due">Review due</label>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Show</button>
                </div>
            </form>

            @if (Model.Risks.Count == 0)
            {
                <p class="text-muted" id="no-risks">No risks yet</p>
            }
            else
            {
                <table class="table align-middle" id="risks-table">
                    <thead>
                        <tr>
                            <th>Level</th>
                            <th>Risk</th>
                            <th>L × I</th>
                            <th>Owner</th>
                            <th>Treatment</th>
                            <th>Status</th>
                            <th>Last reviewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var risk in Model.Risks)
                        {
                            <tr class="risk-row" data-title="@risk.Title">
                                <td><span class="risk-level badge @Badge(risk.Level)">@risk.Level</span></td>
                                <td>
                                    <a class="risk-link" asp-controller="Risks" asp-action="Details" asp-route-id="@risk.Id">@risk.Title</a>
                                    <div class="risk-flags small">
                                        @if (risk.HasNoMeasures)
                                        {
                                            <span class="badge text-bg-warning">No measures yet</span>
                                        }
                                        @if (risk.IsReviewDue(Model.Now))
                                        {
                                            <span class="badge text-bg-danger">Review due</span>
                                        }
                                        @* US-111 R7 *@
                                        @if (risk.OverdueActions(DateOnly.FromDateTime(Model.Now)) is > 0 and var overdueActions)
                                        {
                                            <span class="badge text-bg-danger">@overdueActions overdue @(overdueActions == 1 ? "action" : "actions")</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap">@risk.Likelihood × @risk.Impact = @risk.Score</td>
                                <td class="risk-owner">@RiskPageViewModel.OwnerName(Model.Organization, risk.OwnerId)</td>
                                <td>@risk.Treatment</td>
                                <td class="risk-status">@risk.DisplayStatus</td>
                                <td class="small">@(risk.LastReviewedAt?.ToLocalTime().ToString("dd-MM-yyyy") ?? "never")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>
