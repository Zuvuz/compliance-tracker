@* US-059: the project's evidence, each stored once and linked to the requirements it proves, with the AI's suggestions.
   Ids and classes used by the tests: #evidence-upload (title, url, file, validUntil), #evidence-ai-unavailable,
   #evidence-list with .evidence-item (data-title) holding .evidence-sha256, .evidence-expired,
   .evidence-requirement (data-code) with form .unlink-evidence, form .link-evidence (requirementIds),
   form .remove-project-evidence, .evidence-suggestion (data-code) with .suggestion-score, .ai-generated,
   .suggestion-rationale, forms .approve-evidence-suggestion and .reject-evidence-suggestion (reason, comment),
   and form .more-evidence-suggestions. #52: .fold-toggle[data-fold-target], .fold-part[data-fold-key], .fold-summary,
   and data-attention on the card. *@
@using ComplianceTracker.Application.Compliance
@inject ComplianceTracker.Application.Ai.IAiLimits AiLimits
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var tab = Model.EvidenceTab;
    var canChange = !project.IsClosed && await Permissions.CanAsync(Permission.LinkWork);
}

<div class="row g-4">
    <div class="col-lg-8">
        <h2 class="h5">Evidence</h2>
        <p class="small text-muted">
            Add a document or a link once and link it to every requirement it proves. Expired evidence is shown but does not count.
        </p>

        @if (TempData["EvidenceAiUnavailable"] is string aiMessage)
        {
            <div class="alert alert-warning small" id="evidence-ai-unavailable">@aiMessage</div>
        }
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        @if (tab is null || tab.Evidence.Count == 0)
        {
            <p id="no-evidence" class="text-muted">The project has no evidence yet.</p>
        }
        else
        {
            <div id="evidence-list" class="d-flex flex-column gap-3">
                @foreach (var row in tab.Evidence)
                {
                    var evidence = row.Evidence;
                    var foldKey = $"evidence:{evidence.Id}";
                    @* #52: the card can be folded; it stays open while the AI has suggestions waiting *@
                    <div class="card evidence-item" data-title="@evidence.Title" data-attention="@(row.Suggestions.Count > 0 ? "true" : "false")">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (evidence.IsFile)
                                {
                                    <a class="fw-semibold" asp-action="EvidenceFile" asp-route-id="@project.Id" asp-route-evidenceId="@evidence.Id">@evidence.Title</a>
                                    <span class="small text-muted">@evidence.FileName</span>
                                }
                                else
                                {
                                    <a class="fw-semibold" href="@evidence.Url" target="_blank" rel="noopener noreferrer">@evidence.Title</a>
                                }
                                @if (row.IsExpired)
                                {
                                    <span class="badge text-bg-warning evidence-expired">Expired</span>
                                }
                                else if (evidence.ValidUntil is { } until)
                                {
                                    <span class="small text-muted">valid until @until.ToString("dd-MM-yyyy")</span>
                                }
                                <span class="small text-muted fold-summary" data-fold-summary="@foldKey" hidden>
                                    Proves @row.Links.Count @(row.Links.Count == 1 ? "requirement" : "requirements")
                                    @if (row.Suggestions.Count > 0)
                                    {
                                        <span class="badge text-bg-info">@row.Suggestions.Count AI @(row.Suggestions.Count == 1 ? "suggestion" : "suggestions")</span>
                                    }
                                </span>
                                <button type="button" class="btn btn-sm btn-link p-0 fold-toggle ms-auto" data-fold-target="@foldKey" aria-expanded="true" hidden>Fold</button>
                                @if (canChange)
                                {
                                    <form asp-action="RemoveProjectEvidence" method="post" class="remove-project-evidence">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="evidenceId" value="@evidence.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                }
                            </div>
                            <div class="fold-part" data-fold-key="@foldKey">
                            @if (evidence.Sha256 is not null)
                            {
                                <div class="small text-muted evidence-sha256">SHA-256 @evidence.Sha256</div>
                            }

                            <h3 class="h6 mt-3 mb-1">Proves</h3>
                            @if (row.Links.Count == 0)
                            {
                                <p class="small text-muted mb-1">No requirements yet.</p>
                            }
                            <ul class="list-unstyled small mb-2">
                                @foreach (var link in row.Links)
                                {
                                    <li class="evidence-requirement d-flex align-items-center gap-1" data-code="@link.Requirement.Code">
                                        <span class="fw-semibold">@link.Requirement.Code</span> @link.Requirement.Title
                                        @if (link.Link.Source == ComplianceTracker.Domain.Mappings.LinkSource.AiApproved)
                                        {
                                            <span class="badge text-bg-light">AI suggestion, approved</span>
                                        }
                                        @if (!link.IsApplicable)
                                        {
                                            <span class="badge text-bg-secondary">Not applicable – does not count</span>
                                        }
                                        @if (canChange)
                                        {
                                            <form asp-action="UnlinkEvidence" method="post" class="d-inline unlink-evidence">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <input type="hidden" name="linkId" value="@link.Link.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" aria-label="Unlink @link.Requirement.Code">×</button>
                                            </form>
                                        }
                                    </li>
                                }
                            </ul>

                            @if (canChange && tab.Linkable.Count > 0)
                            {
                                <details>
                                    <summary class="small link-primary">+ Link requirement</summary>
                                    <form asp-action="LinkEvidence" method="post" class="d-flex gap-1 mt-1 link-evidence">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="evidenceId" value="@evidence.Id" />
                                        <select name="requirementIds" multiple size="6" class="form-select form-select-sm" aria-label="Requirements @evidence.Title proves">
                                            @foreach (var group in tab.Linkable.GroupBy(r => r.Framework))
                                            {
                                                <optgroup label="@group.Key">
                                                    @foreach (var requirement in group.Where(r => row.Links.All(l => l.Requirement.Id != r.Requirement.Id)))
                                                    {
                                                        <option value="@requirement.Requirement.Id">@requirement.Requirement.Code @requirement.Requirement.Title</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary align-self-start">Link</button>
                                    </form>
                                </details>
                            }

                            @* R3, R4: the AI only suggests; a person decides *@
                            @if (row.Suggestions.Count > 0)
                            {
                                <h3 class="h6 mt-3 mb-1">Suggested by the AI</h3>
                                @* US-105 R1 *@
                                <p class="small text-muted mb-1 ai-limit">Only suggestions with a score of @AiLimits.MinimumScoreForEvidence.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) or more are shown.</p>
                                <ul class="list-unstyled small mb-1">
                                    @foreach (var suggested in row.Suggestions)
                                    {
                                        var suggestion = suggested.Suggestion;
                                        <li class="evidence-suggestion border rounded p-2 mb-1" data-code="@suggested.Requirement.Code">
                                            <div class="d-flex flex-wrap align-items-center gap-1">
                                                <span class="fw-semibold">@suggested.Requirement.Code</span> @suggested.Requirement.Title
                                                <span class="badge text-bg-light suggestion-score">@suggestion.Score.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                                <span class="badge text-bg-info ai-generated">AI-generated</span>
                                            </div>
                                            <div class="text-muted suggestion-rationale">@(suggestion.Rationale ?? "The AI is writing a rationale…")</div>
                                            @if (canChange)
                                            {
                                                <div class="d-flex flex-wrap gap-2 mt-1">
                                                    <form asp-action="ApproveEvidenceSuggestion" method="post" class="approve-evidence-suggestion">
                                                        <input type="hidden" name="projectId" value="@project.Id" />
                                                        <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                                    </form>
                                                    <form asp-action="RejectEvidenceSuggestion" method="post" class="d-flex flex-wrap gap-1 reject-evidence-suggestion">
                                                        <input type="hidden" name="projectId" value="@project.Id" />
                                                        <input type="hidden" name="suggestionId" value="@suggestion.Id" />
                                                        <select name="reason" class="form-select form-select-sm w-auto" aria-label="Reason">
                                                            <option value="">Reason…</option>
                                                            @foreach (var reason in Enum.GetValues<ComplianceTracker.Domain.Mappings.RejectionReason>())
                                                            {
                                                                <option value="@reason">@reason</option>
                                                            }
                                                        </select>
                                                        <input name="comment" class="form-control form-control-sm w-auto" placeholder="Comment (optional)" aria-label="Comment" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                                    </form>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @if (canChange)
                            {
                                <form asp-action="MoreEvidenceSuggestions" method="post" class="more-evidence-suggestions">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="evidenceId" value="@evidence.Id" />
                                    <button type="submit" class="btn btn-sm btn-link p-0">@(row.Suggestions.Count > 0 ? "Show more suggestions" : "Suggest requirements")</button>
                                </form>
                            }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (canChange)
    {
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 card-title">Add evidence</h2>
                    <form asp-action="UploadEvidence" method="post" enctype="multipart/form-data" id="evidence-upload" class="d-flex flex-column gap-2">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <input name="title" class="form-control form-control-sm" maxlength="200" placeholder="Title, e.g. Access policy 2026" aria-label="Title" required />
                        <input name="url" type="url" class="form-control form-control-sm" placeholder="Link (https://…)" aria-label="Link" />
                        <input name="file" type="file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.txt,.csv,.md" aria-label="Or a file (max 10 MB)" />
                        <div class="d-flex gap-1 align-items-center">
                            <label class="small text-muted text-nowrap" for="evidence-valid-until">Valid until</label>
                            <input name="validUntil" id="evidence-valid-until" type="date" class="form-control form-control-sm" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Add evidence</button>
                        <p class="small text-muted mb-0">The local AI then suggests which requirements it proves. Nothing leaves your infrastructure.</p>
                    </form>
                </div>
            </div>

            @* US-058: passing tests tagged with a requirement, e.g. @cra-I.2(d), become suggested evidence on the Compliance tab *@
            <div class="card mt-3">
                <div class="card-body">
                    <h2 class="h6 card-title">Upload test results</h2>
                    @if (TempData["TestResults"] is string testResults)
                    {
                        <div class="alert alert-info small py-2" id="test-results-summary">@testResults</div>
                    }
                    <form asp-action="UploadTestResults" method="post" enctype="multipart/form-data" id="test-results-upload" class="d-flex flex-column gap-2">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <input name="file" type="file" class="form-control form-control-sm" accept=".trx,.xml" aria-label="Test results (TRX or JUnit XML, max 10 MB)" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Upload test results</button>
                        <p class="small text-muted mb-0">
                            TRX or JUnit XML. A scenario tagged <code>@@&lt;framework&gt;-&lt;code&gt;</code>, e.g. <code>@@cra-I.2(d)</code>, that passed is
                            suggested as evidence for that requirement; a failing one blocks it.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
