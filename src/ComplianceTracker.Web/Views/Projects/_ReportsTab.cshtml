@* US-129: every report the project can make, with who it is for (R1) and the same choices as where it came from (R2).
   #project-reports-tab; per report .report (data-report, data-title) with .report-for, .report-contents and, when it
   cannot be made, .report-unavailable (R3). Traceability: form #reports-traceability-download (audience, format, sub).
   Technical documentation: a#reports-technical-documentation. Every role can download; downloads are logged (R4).
   US-050: form.lock-report (report, audience, sub) for DecideCompliance, #locked-reports with li.locked-report (data-title)
   holding a.locked-report-download and .locked-report-sha256, form #check-fingerprint (file), #fingerprint-result. *@
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var frameworks = Model.Compliance?.Frameworks ?? [];
    var canLock = !project.IsClosed && await Permissions.CanAsync(ComplianceTracker.Domain.Users.Permission.DecideCompliance);
}

<section id="project-reports-tab">
    <p class="text-muted small">Each report is made from the project's data when you download it, and the download is logged.</p>
    <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var report in ComplianceTracker.Application.Reports.ProjectReports.For(Model.Compliance))
        {
            <div class="col">
                <div class="card h-100 report" data-report="@report.Key" data-title="@report.Title">
                    <div class="card-body">
                        <h2 class="h6 card-title">@report.Title</h2>
                        <p class="small mb-1 report-for"><strong>For:</strong> @report.ForWhom · @report.Formats</p>
                        <p class="small text-muted report-contents">@report.Contents</p>
                        @if (!report.IsAvailable)
                        {
                            <p class="small text-muted mb-0 report-unavailable">@report.Unavailable</p>
                        }
                        else if (report.Key == ComplianceTracker.Application.Reports.ProjectReports.Traceability)
                        {
                            @* The same choices as on the Compliance tab (US-120); a GET form, so it is a plain download *@
                            <form method="get" class="d-flex flex-wrap gap-1" id="reports-traceability-download"
                                  action="@Url.Action("Traceability", new { id = project.Id })" aria-label="Download traceability report">
                                <select name="audience" class="form-select form-select-sm w-auto" aria-label="For whom">
                                    <option value="team">For the team</option>
                                    <option value="auditor">For an auditor</option>
                                    <option value="management">For the management</option>
                                </select>
                                <select name="format" class="form-select form-select-sm w-auto" aria-label="Format">
                                    <option value="xlsx">Excel</option>
                                    <option value="csv">CSV</option>
                                    <option value="pdf">PDF</option>
                                </select>
                                <select name="sub" class="form-select form-select-sm w-auto" aria-label="Regulations">
                                    <option value="">All regulations</option>
                                    @foreach (var framework in frameworks)
                                    {
                                        <option value="@FrameworkNames.Slug(framework.Framework.Name)">@FrameworkNames.Short(framework.Framework.Name)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Download</button>
                            </form>
                            @if (canLock)
                            {
                                @* US-050: locks the report as PDF for the chosen reader and regulations *@
                                <form asp-action="LockReport" method="post" class="d-flex flex-wrap gap-1 mt-2 lock-report" data-report="@report.Key"
                                      data-confirm="The report is made now as PDF and kept with its fingerprint. A locked report can never be changed or deleted.">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="report" value="@report.Key" />
                                    <select name="audience" class="form-select form-select-sm w-auto" aria-label="Lock for whom">
                                        <option value="team">For the team</option>
                                        <option value="auditor">For an auditor</option>
                                        <option value="management">For the management</option>
                                    </select>
                                    <select name="sub" class="form-select form-select-sm w-auto" aria-label="Regulations to lock">
                                        <option value="">All regulations</option>
                                        @foreach (var framework in frameworks)
                                        {
                                            <option value="@FrameworkNames.Slug(framework.Framework.Name)">@FrameworkNames.Short(framework.Framework.Name)</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Lock as PDF</button>
                                </form>
                            }
                        }
                        else if (report.Key == ComplianceTracker.Application.Reports.ProjectReports.TechnicalDocumentation)
                        {
                            <a asp-action="TechnicalDocumentation" asp-route-id="@project.Id" class="btn btn-sm btn-outline-secondary"
                               id="reports-technical-documentation">Word</a>
                            @* US-131 *@
                            <a asp-action="TechnicalDocumentation" asp-route-id="@project.Id" asp-route-format="pdf" class="btn btn-sm btn-outline-secondary"
                               id="reports-technical-documentation-pdf">PDF</a>
                            @if (canLock)
                            {
                                <form asp-action="LockReport" method="post" class="d-inline lock-report" data-report="@report.Key"
                                      data-confirm="The draft is made now as PDF and kept with its fingerprint. A locked report can never be changed or deleted.">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="report" value="@report.Key" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Lock as PDF</button>
                                </form>
                            }
                        }
                        else if (report.Key == ComplianceTracker.Application.Reports.ProjectReports.RiskAssessment)
                        {
                            @* US-054 *@
                            <a asp-action="RiskAssessment" asp-route-id="@project.Id" class="btn btn-sm btn-outline-secondary" id="reports-risk-assessment">Excel</a>
                            <a asp-action="RiskAssessment" asp-route-id="@project.Id" asp-route-format="csv" class="btn btn-sm btn-outline-secondary" id="reports-risk-assessment-csv">CSV</a>
                            <a asp-action="RiskAssessment" asp-route-id="@project.Id" asp-route-format="pdf" class="btn btn-sm btn-outline-secondary" id="reports-risk-assessment-pdf">PDF</a>
                            @if (canLock)
                            {
                                <form asp-action="LockReport" method="post" class="d-inline lock-report" data-report="@report.Key"
                                      data-confirm="The risk assessment is made now as PDF and kept with its fingerprint. A locked report can never be changed or deleted.">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="report" value="@report.Key" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Lock as PDF</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* US-050: the locked reports, never changed or deleted, with their fingerprints (R1–R3) *@
    <h2 class="h5 mt-4">Locked reports</h2>
    @if (TempData["ReportSigned"] is string signed)
    {
        <div class="alert alert-success py-2" id="report-signed" role="status">@signed</div>
    }
    @if (TempData["ReportLocked"] is string locked)
    {
        <div class="alert alert-success py-2" id="report-locked" role="status">@locked</div>
    }
    @if (Model.LockedReports.Count == 0)
    {
        <p class="text-muted small" id="no-locked-reports">No report has been locked yet.</p>
    }
    else
    {
        <ul class="list-unstyled" id="locked-reports">
            @foreach (var item in Model.LockedReports)
            {
                var snapshot = item.Snapshot;
                <li class="locked-report border-bottom py-2" data-title="@snapshot.Title">
                    <a class="locked-report-download fw-semibold" asp-action="LockedReport" asp-route-id="@project.Id" asp-route-snapshotId="@snapshot.Id">@snapshot.Title</a>
                    <div class="small text-muted">
                        Locked @snapshot.LockedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm") by <span class="locked-by">@item.LockedBy@(snapshot.LockedRole is { } role ? $" ({ComplianceTracker.Domain.Users.RolePermissions.Title(role)})" : "")</span>
                        · <span class="locked-report-sha256 font-monospace" title="SHA-256 @snapshot.Sha256">SHA-256 @snapshot.Sha256</span>
                    </div>
                    @if (snapshot.Kind.StartsWith("traceability:management:", StringComparison.Ordinal) && !project.IsClosed
                         && await Permissions.CanAsync(ComplianceTracker.Domain.Users.Permission.LinkWork) && Model.Compliance is { } reportCompliance)
                    {
                        @* US-146 R8: a locked management report is evidence of the management review, e.g. ISO/IEC 27001 9.3 *@
                        <details class="small mt-1">
                            <summary class="link-primary">Use as evidence</summary>
                            <form asp-action="UseReportAsEvidence" method="post" class="d-flex gap-1 mt-1 use-report-as-evidence">
                                <input type="hidden" name="projectId" value="@project.Id" />
                                <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                <select name="requirementId" class="form-select form-select-sm" aria-label="Requirement the report proves">
                                    @foreach (var f in reportCompliance.Frameworks)
                                    {
                                        <optgroup label="@FrameworkNames.Short(f.Framework.Name)">
                                            @foreach (var r in f.Requirements.Where(r => r.IsApplicable))
                                            {
                                                <option value="@r.Requirement.Id">@r.Requirement.Code @r.Requirement.Title</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Use as evidence</button>
                            </form>
                        </details>
                    }
                    @* US-132: the signatures, signing and the sealed PDF *@
                    @if (Model.Signings.GetValueOrDefault(snapshot.Id) is { } signing)
                    {
                        <div class="small mt-1 report-signing">
                            @if (signing.Signing is { } s)
                            {
                                @foreach (var signature in signing.Signatures)
                                {
                                    <span class="badge text-bg-light border me-1 report-signature" data-role="@signature.Role">Signed by @signature.Name as @ComplianceTracker.Domain.Reports.ReportSigning.Title(signature.Role) @signature.At.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                }
                                @if (s.IsSealed)
                                {
                                    <a class="btn btn-sm btn-outline-success sealed-report-download" asp-action="SealedReport" asp-route-id="@project.Id" asp-route-snapshotId="@snapshot.Id">Sealed PDF</a>
                                    <span class="text-muted sealed-by">sealed by @s.SealSubject</span>
                                }
                                else if (s.Missing.Count > 0)
                                {
                                    <span class="text-muted signing-missing">Waiting for @string.Join(" and ", s.Missing.Select(ComplianceTracker.Domain.Reports.ReportSigning.Title))</span>
                                }
                                else
                                {
                                    <span class="text-warning-emphasis not-sealed">Signed; not sealed yet (the organisation's seal is missing or not valid)</span>
                                }
                                @foreach (var signAs in signing.ICanSign)
                                {
                                    <form asp-action="SignReport" method="post" class="d-inline sign-report" data-role="@signAs"
                                          data-confirm="You sign &quot;@snapshot.Title&quot; (SHA-256 @snapshot.Sha256) as @ComplianceTracker.Domain.Reports.ReportSigning.Title(signAs). You may be asked to sign in again first.">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                        <input type="hidden" name="role" value="@signAs" />
                                        <button type="submit" class="btn btn-sm btn-primary">Sign as @ComplianceTracker.Domain.Reports.ReportSigning.Title(signAs)</button>
                                    </form>
                                }
                                @if (signing.CanSeal)
                                {
                                    <form asp-action="SealReport" method="post" class="d-inline seal-report">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Seal now</button>
                                    </form>
                                }
                            }
                            else if (signing.CanRequest)
                            {
                                <form asp-action="RequestSignatures" method="post" class="d-inline request-signatures">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="snapshotId" value="@snapshot.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Ask for signatures</button>
                                </form>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @* R4: anyone can check a file they were given against the locked reports *@
    <h3 class="h6 mt-3">Check a fingerprint</h3>
    @if (TempData["FingerprintCheck"] is string result)
    {
        <div class="alert @(result.StartsWith("Matches") ? "alert-success" : "alert-warning") py-2" id="fingerprint-result" role="status">@result</div>
    }
    <form asp-action="CheckFingerprint" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2" id="check-fingerprint">
        <input type="hidden" name="projectId" value="@project.Id" />
        <input type="file" name="file" class="form-control form-control-sm w-auto" aria-label="File to check" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Check fingerprint</button>
    </form>
</section>
