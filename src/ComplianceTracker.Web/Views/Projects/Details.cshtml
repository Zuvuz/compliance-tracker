@* US-008: the project's own page. The id #project-name is used by the tests.
   The project's frameworks (US-011) and user stories (US-018) will be added here later. *@
@using ComplianceTracker.Domain.Projects
@model Project
@{
    ViewData["Title"] = Model.Name;
}

<p class="mb-1"><a asp-controller="Organizations" asp-action="Mine">← Back to the organisation</a></p>
<h1 id="project-name" class="mb-0">@Model.Name</h1>
<p class="text-muted small mb-4">Lifecycle phase: <span id="project-phase">@Model.Phase</span></p>

<dl class="row">
    <dt class="col-sm-3">Intended purpose</dt>
    <dd class="col-sm-9" id="project-intended-purpose">@Model.IntendedPurpose</dd>

    @* Optional fields are only shown when they have a value *@
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    }

    @if (!string.IsNullOrEmpty(Model.Scope))
    {
        <dt class="col-sm-3">Scope</dt>
        <dd class="col-sm-9">@Model.Scope</dd>
    }
</dl>
