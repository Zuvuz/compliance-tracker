@* US-008: the project's own page. US-022: split into tabs, each with its own address (/Projects/Details/{id}/{tab}).
   The header (_ProjectHeader) is the same on every tab; each tab is a partial of its own.
   The ids and classes used by the tests are listed in each partial. *@
@model ProjectDetailsViewModel
@{
    ViewData["Title"] = Model.Project.Name;
}

<partial name="_ProjectHeader" model="Model" />

@switch (Model.Tab)
{
    case ProjectTabs.Frameworks:
        <partial name="_FrameworksTab" model="Model" />
        break;
    case ProjectTabs.Compliance:
        <partial name="_ComplianceTab" model="Model" />
        break;
    case ProjectTabs.UserStories:
        <partial name="_UserStoriesTab" model="Model" />
        break;
    case ProjectTabs.Activity:
        <partial name="_ActivityTab" model="Model" />
        break;
    default:
        <partial name="_OverviewTab" model="Model" />
        break;
}

@section Scripts {
    @* US-018 R7: live updates, only on the tab that shows the user stories *@
    @if (Model.Tab == ProjectTabs.UserStories && Model.Project.GitHub is not null)
    {
        <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
        <script src="~/js/work-items.js" asp-append-version="true"></script>
    }
}
