@* US-022 R1: the top of every tab: name, phase badge, intended purpose, the tabs and the page's error messages.
   Ids used by the tests: #project-name, #project-phase, #project-intended-purpose, #project-nav with #project-groups (a[data-group]) and #project-tabs; every tab link has data-tab, and the
   current tab is the one a[data-tab].active (US-169),
   #edit-project-link, #project-closed, #project-support (US-025). *@
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
}

@if (project.IsOrganisationArea)
{
    @* US-142: the organisation area: no lifecycle, no support period, nothing to edit *@
    <h1 class="mb-1" id="organisation-area-title">Organisation <span class="text-muted fs-4" id="project-name">@Model.Organization?.Name</span></h1>
    <p class="text-muted mb-3" id="project-intended-purpose">The frameworks the whole organisation follows, such as NIS2.</p>
    <partial name="_CertificateBadges" model="Model" />
}
else
{
@* US-168 R1: the shared page header *@
<page-header heading="@project.Name" heading-id="project-name" status="@project.Phase.ToString()" status-id="project-phase"
             back-href="@Url.Action("Index", "Projects")" back-text="Projects">
    @* US-024 R4: a project at end of support can only be viewed *@
    @if (!project.IsClosed && await Permissions.CanAsync(Permission.EditProjects))
    {
        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-outline-primary" id="edit-project-link">Edit</a>
    }
    @* US-028 R1: archive instead of delete; it can be restored *@
    @if (!project.IsArchived && await Permissions.CanAsync(Permission.EditProjects))
    {
        <form asp-action="Archive" method="post" class="d-inline" id="archive-project"
              data-confirm="The project is hidden from the lists and can no longer be changed. All its data is kept, and it can be restored.">
            <input type="hidden" name="projectId" value="@project.Id" />
            <button type="submit" class="btn btn-outline-secondary">Archive</button>
        </form>
    }
</page-header>
<div>
    <div>
        <p class="text-muted mb-1" id="project-intended-purpose">@project.IntendedPurpose</p>
        <partial name="_CertificateBadges" model="Model" />
        @if (project.IsClosed && project.RetainUntil is { } keptUntil)
        {
            @* US-074 R1, R5 *@
            <p class="small mb-3" id="project-retention">End of support since @project.EndOfSupportOn?.ToString("dd-MM-yyyy") · kept until @keptUntil.ToString("dd-MM-yyyy")</p>
        }
        else if (project.SupportEndsOn is { } supportEnds)
        {
            @* US-025 R4, CRA Art. 13(19) *@
            <p class="small mb-3" id="project-support">Supported until @supportEnds.ToString("dd-MM-yyyy")</p>
        }
        else
        {
            <div class="mb-3"></div>
        }
    </div>
</div>
}

@* US-169 R2: at most 6 groups; a group with several tabs links to its first tab and shows its tabs as a row below when it is
   the current one (#52: no menu, so the tabs are not shown twice). Every tab keeps its own address and data-tab. *@
@{
    var groups = ProjectTabs.GroupsFor(project);
    var currentGroup = groups.FirstOrDefault(g => g.Tabs.Any(t => t.Slug == Model.Tab));
    string TabUrl(string slug) => Url.Action("Details", new { id = project.Id, tab = slug == ProjectTabs.Overview ? null : slug, sub = "", req = "" })!;
}
@* US-175 R1, R4: the member's last tab of the project is remembered in this browser (site.js); data-tabs lists the valid ones *@
<div id="project-nav" class="mb-3" data-project="@project.Id" data-current-tab="@Model.Tab"
     data-tabs="@string.Join(",", groups.SelectMany(g => g.Tabs).Select(t => t.Slug))">
    <ul class="nav nav-tabs" id="project-groups">
        @foreach (var group in groups)
        {
            var isCurrent = group.Title == currentGroup.Title;
            if (group.Tabs.Count == 1)
            {
                var (slug, title) = group.Tabs[0];
                <li class="nav-item">
                    <a class="nav-link @(isCurrent ? "active" : "")" data-group="@group.Title" data-tab="@slug" aria-current="@(isCurrent ? "page" : null)" href="@TabUrl(slug)">@title</a>
                </li>
            }
            else
            {
                @* #52: no menu; the group opens its first tab and its tabs show as the row below *@
                <li class="nav-item">
                    <a class="nav-link @(isCurrent ? "active" : "")" data-group="@group.Title" aria-current="@(isCurrent ? "page" : null)" href="@TabUrl(group.Tabs[0].Slug)">@group.Title</a>
                </li>
            }
        }
    </ul>
    @if (currentGroup.Tabs is { Count: > 1 })
    {
        <ul class="nav nav-pills mt-2 small" id="project-tabs">
            @foreach (var (slug, title) in currentGroup.Tabs)
            {
                <li class="nav-item">
                    <a class="nav-link py-1 @(Model.Tab == slug ? "active" : "")" data-tab="@slug" aria-current="@(Model.Tab == slug ? "page" : null)" href="@TabUrl(slug)">@title</a>
                </li>
            }
        </ul>
    }
</div>

@* The domain's error messages from every action on the page, e.g. "The project already uses Security policy" *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (project.IsArchived)
{
    @* US-028 R3: read, not changed; R4: restored *@
    var archivedBy = Model.Organization?.Users.FirstOrDefault(u => u.Id == project.ArchivedById)?.Name;
    <div class="alert alert-secondary d-flex flex-wrap align-items-center gap-2" id="project-archived" role="status">
        <span>Archived on @project.ArchivedAt?.ToString("dd-MM-yyyy")@(archivedBy is null ? "" : $" by {archivedBy}"). It can be read but not changed.</span>
        @if (await Permissions.CanAsync(Permission.EditProjects))
        {
            <form asp-action="Restore" method="post" class="ms-auto" id="restore-project">
                <input type="hidden" name="projectId" value="@project.Id" />
                <button type="submit" class="btn btn-sm btn-outline-primary">Restore</button>
            </form>
        }
    </div>
}
else if (project.IsClosed)
{
    <div class="alert alert-secondary" id="project-closed" role="status">This project is at end of support and can no longer be changed.</div>
}
