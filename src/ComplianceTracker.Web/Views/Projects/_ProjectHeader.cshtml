@* US-022 R1: the top of every tab: name, phase badge, intended purpose, the tabs and the page's error messages.
   Ids used by the tests: #project-name, #project-phase, #project-intended-purpose, #project-tabs (links with data-tab),
   #edit-project-link, #project-closed, #project-support (US-025). *@
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var phaseBadge = project.Phase switch
    {
        ComplianceTracker.Domain.Projects.LifecyclePhase.Planning => "text-bg-info",
        ComplianceTracker.Domain.Projects.LifecyclePhase.Development => "text-bg-primary",
        ComplianceTracker.Domain.Projects.LifecyclePhase.Released => "text-bg-success",
        _ => "text-bg-secondary"
    };
}

@if (project.IsOrganisationArea)
{
    @* US-142: the organisation area: no lifecycle, no support period, nothing to edit *@
    <h1 class="mb-1" id="organisation-area-title">Organisation <span class="text-muted fs-4" id="project-name">@Model.Organization?.Name</span></h1>
    <p class="text-muted mb-3" id="project-intended-purpose">The frameworks the whole organisation follows, such as NIS2.</p>
}
else
{
<p class="mb-1"><a asp-controller="Projects" asp-action="Index">← Projects</a></p>
<div class="d-flex align-items-start justify-content-between gap-3">
    <div>
        <h1 class="mb-1">
            <span id="project-name">@project.Name</span>
            <span id="project-phase" class="badge @phaseBadge fs-6 align-middle">@project.Phase</span>
        </h1>
        <p class="text-muted mb-1" id="project-intended-purpose">@project.IntendedPurpose</p>
        @if (project.IsClosed && project.RetainUntil is { } keptUntil)
        {
            @* US-074 R1, R5 *@
            <p class="small mb-3" id="project-retention">End of support since @project.EndOfSupportOn?.ToString("dd-MM-yyyy") · kept until @keptUntil.ToString("dd-MM-yyyy")</p>
        }
        else if (project.SupportEndsOn is { } supportEnds)
        {
            @* US-025 R4, CRA Art. 13(19) *@
            <p class="small mb-3" id="project-support">Supported until @supportEnds.ToString("dd-MM-yyyy")</p>
        }
        else
        {
            <div class="mb-3"></div>
        }
    </div>
    @* US-024 R4: a project at end of support can only be viewed *@
    @if (!project.IsClosed && await Permissions.CanAsync(Permission.EditProjects))
    {
        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-outline-primary" id="edit-project-link">Edit</a>
    }
</div>
}

<ul class="nav nav-tabs mb-3" id="project-tabs">
    @foreach (var (slug, title) in ProjectTabs.For(project))
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Tab == slug ? "active" : "")" data-tab="@slug"
               aria-current="@(Model.Tab == slug ? "page" : null)"
               asp-action="Details" asp-route-id="@project.Id" asp-route-tab="@(slug == ProjectTabs.Overview ? null : slug)">@title</a>
        </li>
    }
</ul>

@* The domain's error messages from every action on the page, e.g. "The project already uses Security policy" *@
<div asp-validation-summary="All" class="text-danger" role="alert"></div>

@if (project.IsClosed)
{
    <div class="alert alert-secondary" id="project-closed">This project is at end of support and can no longer be changed.</div>
}
