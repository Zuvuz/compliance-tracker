@* US-104: the project's product requirements, from the methods it uses: GitHub user stories (US-018, US-031),
   a requirement specification (US-032, US-033) and use cases (US-034). Only the chosen methods are shown (R3).
   The list (_WorkItems) is fetched again when SignalR says it changed (US-018 R7).
   Ids used by the tests: #requirement-methods (input[name=methods]), .method-section[data-method], #project-work-items,
   #link-github, #github-token, #token-status, #set-github-token. *@
@using ComplianceTracker.Domain.Projects
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var methods = project.RequirementMethods;
    var canChooseMethods = !project.IsClosed && await Permissions.CanAsync(Permission.EditProjects);
}

@* R2, R4: the methods the project uses; only roles that edit projects can change them *@
<section class="mb-3" id="requirement-methods-section">
    <h2 class="h6">How does the project describe its requirements?</h2>
    @if (canChooseMethods)
    {
        <form asp-action="ChooseRequirementMethods" method="post" class="d-flex flex-wrap align-items-center gap-3" id="requirement-methods">
            <input type="hidden" name="projectId" value="@project.Id" />
            @foreach (var (method, title) in RequirementMethodNames.All)
            {
                <div class="form-check form-check-inline m-0">
                    <input class="form-check-input" type="checkbox" name="methods" value="@method" id="method-@method" checked="@methods.HasFlag(method)" />
                    <label class="form-check-label" for="method-@method">@title</label>
                </div>
            }
            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
        </form>
        <p class="small text-muted mb-0 mt-1">Untick what the team does not use to hide it. Nothing is deleted: links and coverage stay.</p>
    }
    else
    {
        <p class="small mb-0" id="requirement-methods-readonly">@RequirementMethodNames.Describe(methods)</p>
    }
</section>

<section id="project-work-items" data-project-id="@project.Id">
    @if (methods.HasFlag(RequirementMethods.GitHubUserStories))
    {
    <div class="method-section" data-method="GitHub user stories">
    <h2 class="h6">GitHub user stories</h2>
    @if (!project.IsClosed)
    {
        @* US-018 R1: a repository as owner/name, and the label that marks user stories *@
        <form asp-action="LinkGitHub" method="post" class="row g-2 mb-3" id="link-github">
            <input type="hidden" name="projectId" value="@project.Id" />
            <div class="col-md-5">
                <input name="repository" class="form-control" placeholder="owner/name, e.g. Zuvuz/compliance-tracker"
                       value="@project.GitHub?.Repository" aria-label="GitHub repository" />
            </div>
            <div class="col-md-3">
                <input name="label" class="form-control" value="@(project.GitHub?.Label ?? ComplianceTracker.Domain.Projects.GitHubLink.DefaultLabel)" aria-label="Label" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">@(project.GitHub is null ? "Link" : "Save")</button>
            </div>
        </form>
    }

    @if (project.GitHub is { } github && !project.IsClosed)
    {
        @* US-031: a read-only token for a private repository. The stored token is never shown again (R3). *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="github-token">
            @if (github.HasToken)
            {
                <span class="small" id="token-status">Token set (changed @github.TokenChangedAt?.ToLocalTime().ToString("dd-MM-yyyy"))</span>
                <form asp-action="RemoveGitHubToken" method="post" class="d-inline">
                    <input type="hidden" name="projectId" value="@project.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove token</button>
                </form>
            }
            else
            {
                <span class="small text-muted" id="token-status">No token: only public repositories can be read.</span>
            }
            <form asp-action="SetGitHubToken" method="post" class="d-flex gap-1" id="set-github-token">
                <input type="hidden" name="projectId" value="@project.Id" />
                @* type=password and autocomplete=off: the browser neither shows nor remembers it *@
                <input name="token" type="password" autocomplete="off" class="form-control form-control-sm"
                       placeholder="Read-only token (Issues: read)" aria-label="GitHub token" />
                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">@(github.HasToken ? "Replace token" : "Add token")</button>
            </form>
        </div>
    }
    </div>
    }

    @if (methods.HasFlag(RequirementMethods.RequirementSpecification) || methods.HasFlag(RequirementMethods.UseCases))
    {
        <partial name="_RequirementDocuments" model="Model" />
    }

    @if (!project.IsClosed && Model.WorkItems.Count > 0)
    {
        @* US-020 R1: the local AI suggests requirements for every story; a person decides each one *@
        <form asp-action="SuggestMappings" method="post" class="mb-3" id="suggest-mappings">
            <input type="hidden" name="projectId" value="@project.Id" />
            <button type="submit" class="btn btn-outline-primary">Suggest mappings</button>
            <span class="small text-muted ms-2">The local AI suggests requirements for each user story. You approve or reject each suggestion.</span>
        </form>
    }

    <div id="work-items-live">
        <partial name="_WorkItems" model="Model.WorkItemsSection" />
    </div>
</section>
