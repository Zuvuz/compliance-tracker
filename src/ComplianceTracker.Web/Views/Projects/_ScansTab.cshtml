@* US-078: scan results (SARIF) of the project: the latest scan per tool, the open findings by severity, and an upload form.
   Ids and classes used by the tests: #upload-scan (file), #scan-imported, #latest-scans rows .latest-scan (data-tool)
   with .scan-summary and the form .scan-as-evidence (requirementId); #open-findings rows .finding (data-rule) with
   .finding-severity and the form .accept-finding (reason); #closed-findings rows .finding (data-rule) with .finding-state;
   #no-scans. US-121: form #fetch-from-github, .scan-source on each latest scan, #scan-imported lines (.scan-line).
   US-122: .scan-build on each latest scan; #upload-tokens with form #create-upload-token (name), #new-upload-token (shown
   once), rows .upload-token (data-name) with .token-created, .token-last-used, .token-revoked and form .revoke-upload-token. *@
@using ComplianceTracker.Domain.Scanning
@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    var scans = Model.Scans;
    var canChange = !project.IsClosed && await Permissions.CanAsync(Permission.LinkWork);
    var canManageTokens = !project.IsClosed && await Permissions.CanAsync(Permission.EditProjects); // US-122
    string Badge(FindingSeverity severity) => severity switch
    {
        FindingSeverity.Critical => "text-bg-dark",
        FindingSeverity.High => "text-bg-danger",
        FindingSeverity.Medium => "text-bg-warning",
        _ => "text-bg-secondary"
    };
    var requirements = Model.Compliance?.Frameworks
        .SelectMany(f => f.Requirements.Where(r => r.IsApplicable).Select(r => (Framework: FrameworkNames.Short(f.Framework.Name), r.Requirement)))
        .ToList() ?? [];
}

<section id="project-scans">
    <p class="small text-muted">Results from security scanners in SARIF 2.1.0 (Trivy, Grype, Semgrep, CodeQL, ZAP …). A new scan from the same tool marks findings it no longer reports as fixed (CRA Annex I, ISO 27001 A.8.8).</p>

    @if (TempData["ScanImported"] is string imported)
    {
        <div class="alert alert-success py-2" id="scan-imported" role="status">
            @foreach (var line in imported.Split('\n'))
            {
                <div class="scan-line">@line</div>
            }
        </div>
    }

    @if (canChange)
    {
        <form asp-action="UploadScan" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 mb-4" id="upload-scan">
            <input type="hidden" name="projectId" value="@project.Id" />
            <input type="file" name="file" accept=".sarif,.json" class="form-control form-control-sm w-auto" aria-label="SARIF file (max 50 MB)" required />
            <button type="submit" class="btn btn-sm btn-primary">Upload scan</button>
        </form>
    }

    @if (canChange && project.GitHub is { IsProject: false } github)
    {
        @* US-121: the repository's code scanning and Dependabot alerts, read-only; also fetched with the scheduled sync *@
        <form asp-action="FetchScansFromGitHub" method="post" class="d-flex flex-wrap align-items-center gap-2 mb-4" id="fetch-from-github">
            <input type="hidden" name="projectId" value="@project.Id" />
            <button type="submit" class="btn btn-sm btn-outline-primary">Fetch from GitHub</button>
            <span class="small text-muted">Code scanning and Dependabot alerts of @github.Repository@(scans?.LatestPerTool.Where(s => s.Source != ScanSource.Upload).Select(s => (DateTime?)s.ScannedAt).Max() is { } last ? $" · last fetched {last.ToLocalTime():dd-MM-yyyy HH:mm}" : "")</span>
        </form>
    }

    @if (canManageTokens || scans?.Tokens.Count > 0)
    {
        @* US-122: tokens a build pipeline uses with POST /api/projects/{id}/scans; see docs/ci-scan-upload.md *@
        <details class="mb-4" id="upload-tokens" @(TempData.Peek("NewUploadToken") is not null ? "open" : "")>
            <summary class="small">Upload tokens for build pipelines (@(scans?.Tokens.Count(t => t.IsActive) ?? 0) active)</summary>
            <div class="mt-2">
                <p class="small text-muted mb-2">
                    A pipeline sends its SARIF file to <code>@Url.Action("Upload", "ScanUploadApi", new { id = project.Id }, Context.Request.Scheme)</code>
                    with <code>Authorization: Bearer &lt;token&gt;</code>, and optionally <code>commit</code> and <code>version</code>.
                    A token can only upload to this project, at most @ComplianceTracker.Domain.Scanning.ScanUploadToken.MaxUploadsPerHour times an hour.
                </p>
                @if (TempData["NewUploadToken"] is string secret)
                {
                    @* R2: shown once *@
                    <div class="alert alert-warning py-2 small" role="status">
                        Copy the token now. It is not shown again.
                        <code class="d-block mt-1 user-select-all" id="new-upload-token">@secret</code>
                    </div>
                }
                @if (canManageTokens)
                {
                    <form asp-action="CreateUploadToken" method="post" class="d-flex flex-wrap gap-2 mb-2" id="create-upload-token">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <input name="name" class="form-control form-control-sm w-auto" maxlength="100" placeholder="e.g. GitHub Actions" aria-label="Token name" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Create token</button>
                    </form>
                }
                @if (scans?.Tokens.Count > 0)
                {
                    <table class="table table-sm small align-middle mb-0">
                        <thead><tr><th>Name</th><th>Created</th><th>Last used</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var token in scans.Tokens)
                            {
                                <tr class="upload-token @(token.IsActive ? "" : "text-muted")" data-name="@token.Name">
                                    <td>@token.Name</td>
                                    <td class="token-created">@token.CreatedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                                    <td class="token-last-used">@(token.LastUsedAt?.ToLocalTime().ToString("dd-MM-yyyy HH:mm") ?? "Never")</td>
                                    <td>
                                        @if (!token.IsActive)
                                        {
                                            <span class="token-revoked">Revoked @token.RevokedAt!.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</span>
                                        }
                                        else if (canManageTokens)
                                        {
                                            <form asp-action="RevokeUploadToken" method="post" data-confirm="Pipelines using this token can no longer upload scans." data-confirm-final="true" class="revoke-upload-token">
                                                <input type="hidden" name="projectId" value="@project.Id" />
                                                <input type="hidden" name="tokenId" value="@token.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </details>
    }

    @if (scans is null || scans.LatestPerTool.Count == 0)
    {
        <p class="text-muted" id="no-scans">No scans yet</p>
    }
    else
    {
        <h2 class="h6">Latest scan per tool</h2>
        <table class="table table-sm align-middle" id="latest-scans">
            <thead><tr><th>Tool</th><th>Source</th><th>When</th><th>Result</th><th>SHA-256</th><th></th></tr></thead>
            <tbody>
                @foreach (var scan in scans.LatestPerTool)
                {
                    <tr class="latest-scan" data-tool="@scan.Tool">
                        <td>@scan.Tool</td>
                        <td class="small scan-source">@(scan.Source switch
                        {
                            ScanSource.GitHubCodeScanning => "GitHub code scanning",
                            ScanSource.GitHubDependabot => "GitHub Dependabot",
                            ScanSource.CiUpload => "CI upload",
                            _ => "Upload"
                        })</td>
                        <td class="text-nowrap">@scan.ScannedAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                        <td>
                            <span class="scan-summary">@scan.Summary</span>
                            @if (scan.Build is { } build)
                            {
                                <div class="small text-muted scan-build">@build</div>
                            }
                        </td>
                        <td class="small text-muted" title="@scan.Sha256">@scan.Sha256[..8]…</td>
                        <td>
                            @if (canChange && requirements.Count > 0)
                            {
                                @* R5: the scan as evidence for a requirement *@
                                <form asp-action="ScanAsEvidence" method="post" class="d-flex gap-1 scan-as-evidence">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <input type="hidden" name="scanId" value="@scan.Id" />
                                    <select name="requirementId" class="form-select form-select-sm" aria-label="Requirement the scan proves">
                                        @foreach (var item in requirements)
                                        {
                                            <option value="@item.Requirement.Id">@item.Framework @item.Requirement.Code</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Use as evidence</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h2 class="h6 mt-4">Open findings (@scans.Open.Count)</h2>
        @if (scans.Open.Count == 0)
        {
            <p class="text-muted small">No open findings</p>
        }
        else
        {
            <table class="table table-sm align-middle" id="open-findings">
                <thead><tr><th>Severity</th><th>Rule</th><th>Message</th><th>Where</th><th>Tool</th><th></th></tr></thead>
                <tbody>
                    @foreach (var finding in scans.Open)
                    {
                        <tr class="finding" data-rule="@finding.RuleId">
                            <td><span class="badge finding-severity @Badge(finding.Severity)">@finding.Severity</span></td>
                            <td class="text-nowrap">@finding.RuleId</td>
                            <td class="small">@finding.Message</td>
                            <td class="small text-muted">@finding.Location</td>
                            <td class="small">@finding.Tool</td>
                            <td>
                                @if (canChange)
                                {
                                    @* R4 *@
                                    <form asp-action="AcceptFinding" method="post" data-confirm="The finding is accepted with your reason and no longer counts as open." data-confirm-final="true" class="d-flex gap-1 accept-finding">
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="findingId" value="@finding.Id" />
                                        <input name="reason" class="form-control form-control-sm" maxlength="@Finding.MaxReasonLength" placeholder="Why it is acceptable" aria-label="Reason for accepting @finding.RuleId" required />
                                        <button type="submit" class="btn btn-sm btn-outline-warning text-nowrap">Accept</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (scans.Closed.Count > 0)
        {
            <details class="mt-3">
                <summary class="h6">Fixed and accepted (@scans.Closed.Count)</summary>
                <table class="table table-sm" id="closed-findings">
                    <tbody>
                        @foreach (var finding in scans.Closed)
                        {
                            <tr class="finding" data-rule="@finding.RuleId">
                                <td><span class="badge @Badge(finding.Severity)">@finding.Severity</span></td>
                                <td class="text-nowrap">@finding.RuleId</td>
                                <td class="small finding-state">@(finding.State == FindingState.Fixed
                                    ? $"Fixed in scan of {finding.FixedAt!.Value.ToLocalTime():dd-MM-yyyy}"
                                    : $"Accepted: {finding.AcceptedReason}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    }
</section>
