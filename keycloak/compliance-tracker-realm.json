{
  "realm": "compliance-tracker",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "compliance-tracker-web",
      "name": "Compliance Tracker web app",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:5203/signin-oidc",
        "https://localhost:7068/signin-oidc",
        "https://localhost/signin-oidc"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5203/signout-callback-oidc##https://localhost:7068/signout-callback-oidc##https://localhost/signout-callback-oidc"
      }
    }
  ]
